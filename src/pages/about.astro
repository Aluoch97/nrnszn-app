---
import Site from '../layouts/Site.astro';
import AboutSupport from '../components/AboutSupport.astro';
import PageHero from '../components/PageHero.astro';
---
<Site
  title="About | NuRenaissance"
  description="NuRenaissance Media is an independent creative studio founded in 2017. Our story, what we make, how a project works and how to reach us."
>
  <PageHero
    title="About"
    kicker="Est. 2017"
    text="An independent creative studio, founded in 2017. Our story, how we work, and how to reach us."
    images={[
      { src: '/img/portal-poster-640.webp', srcset: '/img/portal-poster-640.webp 640w, /img/portal-poster.webp 1280w' },
      { src: '/img/home-hero-640.webp', srcset: '/img/home-hero-640.webp 640w, /img/home-hero.webp 1280w' },
    ]}
    mascot
    accent="#8520cc"
  />
  <AboutSupport mode="about" />
</Site>
