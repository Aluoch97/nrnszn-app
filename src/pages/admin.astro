---
import Site from '../layouts/Site.astro';
---
<Site
  title="Admin | NuRenaissance"
  description="Owner sign-in for the NuRenaissance site: live status of every feed and form, backups, and the setup checklist."
  noindex={true}
>
  <article class="admin">
    <h1>Admin</h1>
    <p id="loading" class="lead" role="status">Loading…</p>

    <!-- Sign-in (shown until you are signed in) -->
    <section id="gate" hidden aria-labelledby="gate-title">
      <h2 id="gate-title">Sign in</h2>
      <form id="login" class="login">
        <label for="pw">Admin password</label>
        <input id="pw" name="password" type="password" autocomplete="current-password" required />
        <button type="submit" class="btn primary">Sign in</button>
        <p id="login-error" class="error" role="alert"></p>
      </form>
      <div id="not-set-up" hidden class="callout">
        <p><strong>Sign-in is not set up yet.</strong> To switch it on:</p>
        <ol>
          <li>Make up a long password (at least 10 characters).</li>
          <li>Cloudflare → <strong>Workers &amp; Pages</strong> → the nrnszn project → <strong>Settings</strong> → <strong>Variables and Secrets</strong> → <strong>Add</strong> → type <strong>Secret</strong>, name <code>ADMIN_PASSWORD</code>, value = your password → <strong>Save</strong>.</li>
          <li><strong>Deployments</strong> → the latest → <strong>⋯</strong> → <strong>Retry deployment</strong>, then reload this page.</li>
        </ol>
      </div>
    </section>

    <!-- The settings page (shown once signed in): a summary, then folders, like Soul Vault's Settings -->
    <section id="dash" hidden aria-label="Admin settings">
      <p class="banner" id="banner" role="status" aria-live="polite" data-tone="wait">Checking everything…</p>
      <div class="strip" aria-label="Summary">
        <div><b id="n-ok">0</b><span>New</span></div>
        <div><b id="n-old">0</b><span>Old fallback</span></div>
        <div><b id="n-todo">0</b><span>To do</span></div>
      </div>

      <details class="folder" data-folder="feeds" open>
        <summary><span class="ft"><b>What visitors see</b><span>Gallery, cinema, services, latest videos</span></span><span class="badge" id="b-feeds">…</span></summary>
        <ul class="rows" data-group="feeds"></ul>
      </details>
      <details class="folder" data-folder="send">
        <summary><span class="ft"><b>What visitors send</b><span>Survey, recap e-mail, payments, services</span></span><span class="badge" id="b-send">…</span></summary>
        <ul class="rows" data-group="send"></ul>
      </details>
      <details class="folder" data-folder="keep">
        <summary><span class="ft"><b>Backups</b><span>Nightly copy of your Google Sheets</span></span><span class="badge" id="b-keep">…</span></summary>
        <ul class="rows" data-group="keep"></ul>
        <div class="actions">
          <button type="button" class="btn" id="backup-now">Back up now</button>
          <p id="backup-result" class="result" role="status" aria-live="polite"></p>
        </div>
      </details>
      <details class="folder" data-folder="events">
        <summary><span class="ft"><b>Events</b><span>Add and edit the events on the Events page</span></span><span class="badge" id="b-events">…</span></summary>
        <div id="ev-box">
          <p id="ev-msg" class="result" role="status" aria-live="polite"></p>
          <ul class="rows" id="ev-list"></ul>
          <div class="actions"><button type="button" class="btn primary" id="ev-add">Add an event</button></div>
          <form id="ev-form" class="evform" hidden>
            <h3 id="ev-form-title">New event</h3>
            <label for="ev-title">Event name</label><input id="ev-title" type="text" maxlength="120" autocomplete="off" required />
            <label for="ev-day">Date</label><input id="ev-day" type="date" required />
            <label for="ev-time">Time <span class="hint">(optional, for example 7–11 PM)</span></label><input id="ev-time" type="text" maxlength="40" autocomplete="off" />
            <label for="ev-where">Where <span class="hint">(optional)</span></label><input id="ev-where" type="text" maxlength="160" autocomplete="off" />
            <label for="ev-details">Details <span class="hint">(optional)</span></label><textarea id="ev-details" rows="4" maxlength="2000"></textarea>
            <label for="ev-tickets">Tickets link <span class="hint">(optional, starts with https://)</span></label><input id="ev-tickets" type="url" maxlength="500" autocomplete="off" />
            <label for="ev-video">Recap video link <span class="hint">(optional, starts with https://)</span></label><input id="ev-video" type="url" maxlength="500" autocomplete="off" />
            <label for="ev-watch">Watch on this site <span class="hint">(optional, a page like /cinema)</span></label><input id="ev-watch" type="text" maxlength="100" autocomplete="off" />
            <label for="ev-flyer">Flyer picture <span class="hint">(optional, JPG, PNG or WebP)</span></label>
            <input id="ev-flyer" type="file" accept="image/jpeg,image/png,image/webp" />
            <img id="ev-preview" alt="Flyer preview" hidden />
            <label class="check" id="ev-rm-wrap" hidden><input id="ev-rm" type="checkbox" /> Remove the current flyer</label>
            <label class="check"><input id="ev-pub" type="checkbox" checked /> Show on the Events page</label>
            <div class="actions"><button type="submit" class="btn primary" id="ev-save">Save event</button><button type="button" class="btn" id="ev-cancel">Cancel</button><button type="button" class="btn danger" id="ev-delete" hidden>Delete this event</button></div>
            <p id="ev-error" class="error" role="alert"></p>
          </form>
        </div>
      </details>
      <details class="folder" data-folder="push">
        <summary><span class="ft"><b>Phone notifications</b><span>Send a notification to everyone who turned them on</span></span><span class="badge" id="b-push">…</span></summary>
        <div id="push-box">
          <p id="push-msg" class="result" role="status" aria-live="polite">Loading…</p>
          <p id="push-done" class="result" role="status" aria-live="polite"></p>
          <div id="push-auto" class="evform" hidden>
            <h3>Automatic</h3>
            <p class="result">Visitors are told by themselves. They go out between 9 AM and 9 PM Central and count toward the 3-a-day limit; several things at once become one notification. Switching one on never announces anything that already exists.</p>
            <label class="check"><input type="checkbox" data-auto="events" /> New events (when you add one here that is dated today or later)</label>
            <label class="check"><input type="checkbox" data-auto="videos" /> New YouTube videos (the Interview and Music Video playlists)</label>
            <label class="check"><input type="checkbox" data-auto="services" /> New services (added to your NuServices sheet)</label>
            <label class="check"><input type="checkbox" data-auto="gallery" /> New gallery photos (added to NuGallery in Google Drive)</label>
            <label class="check"><input type="checkbox" data-auto="cinema" /> New NuCinema films, shows and episodes</label>
            <p id="push-auto-st" class="result" role="status" aria-live="polite"></p>
          </div>
          <form id="push-form" class="evform" hidden>
            <label for="push-title">Title <span class="hint">(shows in bold)</span></label><input id="push-title" type="text" maxlength="60" autocomplete="off" placeholder="New episode of Certified Lounge" required />
            <label for="push-body">Message <span class="hint">(optional)</span></label><input id="push-body" type="text" maxlength="140" autocomplete="off" />
            <label for="push-url">Where a tap goes</label>
            <select id="push-url"><option value="/">Home</option><option value="/events">Events</option><option value="/cinema">Cinema</option><option value="/gallery">Gallery</option><option value="/services">Services</option></select>
            <p id="push-preview" class="result"></p>
            <div class="actions"><button type="submit" class="btn primary" id="push-send">Send</button></div>
            <p id="push-error" class="error" role="alert"></p>
          </form>
          <ul class="rows" id="push-last"></ul>
        </div>
      </details>
      <details class="folder" data-folder="analytics">
        <summary><span class="ft"><b>Website analytics</b><span>Visitors, pages, where people come from</span></span><span class="badge" id="b-analytics">…</span></summary>
        <div id="an-box">
          <div class="actions"><label for="an-days" class="inline">Show</label>
            <select id="an-days"><option value="7">the last 7 days</option><option value="30" selected>the last 30 days</option><option value="90">the last 90 days</option></select></div>
          <div id="an-out" aria-live="polite"><p class="result">Loading…</p></div>
        </div>
      </details>
      <details class="folder" data-folder="setup">
        <summary><span class="ft"><b>Setup checklist</b><span>Which secrets and connections exist (yes or no, never the value)</span></span><span class="badge" id="b-setup">…</span></summary>
        <div id="setup-list"></div>
      </details>
      <details class="folder" data-folder="account">
        <summary><span class="ft"><b>Account</b><span>Sign out, refresh this device</span></span></summary>
        <div class="actions">
          <button type="button" class="btn" data-refresh>Refresh the app</button>
          <button type="button" class="btn" id="sign-out">Sign out on this device</button>
          <p class="result" id="ver-line">Version: checking…</p>
        </div>
      </details>
      <p class="foot-note" id="foot-note">&nbsp;</p>
    </section>
  </article>
</Site>

<script>
  type Tone = 'ok' | 'old' | 'todo' | 'bad';
  type Result = { tone: Tone; text: string; note?: string };
  const KEY = 'nrn_admin', OPEN = 'nrn_admin_open';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const count = (a: unknown) => (Array.isArray(a) ? a.length : 0);
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const when = (iso: string) => new Date(iso).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const store = {
    get: () => { try { return localStorage.getItem(KEY) || ''; } catch { return ''; } },
    set: (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* private window */ } },
    clear: () => { try { localStorage.removeItem(KEY); } catch { /* ignore */ } },
  };

  // A write endpoint says which backend answers: "sheet" or "edge" = the site itself, "apps-script" = the old fallback.
  const mode = (what: string) => (j: any): Result => {
    if (j && (j.mode === 'sheet' || j.mode === 'edge')) return { tone: 'ok', text: 'New: the site handles this itself', note: what };
    if (j && j.mode === 'apps-script') return { tone: 'old', text: 'Old fallback: the previous Google script still handles this', note: 'Needs its Cloudflare secret(s) to switch over' };
    return { tone: 'bad', text: 'Unexpected answer', note: 'The endpoint answered, but not in the usual shape' };
  };
  const ROWS: { group: string; name: string; url: string; read: (j: any) => Result }[] = [
    { group: 'feeds', name: 'Gallery', url: '/api/feed/gallery', read: (j) => (j && j.source === 'drive' ? { tone: 'ok', text: 'New: read straight from Google Drive', note: plural(count(j.categories), 'category', 'categories') } : j && count(j.categories) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No gallery came back' }) },
    { group: 'feeds', name: 'Cinema', url: '/api/feed/cinema', read: (j) => (j && j.source === 'sheet' ? { tone: 'ok', text: 'New: read straight from the NuCinema sheet', note: plural(count(j.films), 'film', 'films') } : j && count(j.films) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No films came back' }) },
    { group: 'feeds', name: 'Services', url: '/api/feed/services', read: (j) => (j && j.source === 'sheet' ? { tone: 'ok', text: 'New: read straight from the NuServices sheet', note: plural(count(j.services), 'service', 'services') } : j && count(j.services) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No services came back' }) },
    { group: 'feeds', name: 'Latest videos', url: '/api/feed/latest', read: (j) => (j && j.ok ? { tone: 'ok', text: 'Answering', note: j.music && j.music.publishedAt ? `Newest music video: ${when(j.music.publishedAt)}` : undefined } : { tone: 'bad', text: 'No videos came back' }) },
    { group: 'send', name: 'Survey answers', url: '/api/survey', read: mode('Saves each response to the sheet and sends the e-mails') },
    { group: 'send', name: 'Daily recap e-mail', url: '/api/survey-recap', read: mode('The daily check for a new livestream recap') },
    { group: 'send', name: 'Payment taps', url: '/api/payment', read: mode('Logs each tap on PayPal, Cash App, Venmo, Zelle, Apple Pay') },
    { group: 'send', name: 'Service clicks', url: '/api/service-click', read: mode('Counts which services people look at') },
    { group: 'send', name: 'Service requests', url: '/api/service-lead', read: mode('Saves the intake form') },
    { group: 'keep', name: 'Nightly sheet backup', url: '/api/backup', read: (j) => {
      if (!j || !j.mode) return { tone: 'bad', text: 'Unexpected answer' };
      if (j.mode === 'not-set-up') return { tone: 'todo', text: 'Not set up yet', note: 'Needs the storage bucket and a secret (docs/backup-setup.md)' };
      if (!j.last || !j.last.at) return { tone: 'todo', text: 'Connected, but no backup has run yet', note: 'Tap "Back up now" below' };
      const days = (Date.now() - new Date(j.last.at).getTime()) / 86400000;
      return days > 1.6 ? { tone: 'old', text: `Last backup is ${Math.floor(days)} days old`, note: `${when(j.last.at)}. It should run every night` } : { tone: 'ok', text: `Last backup: ${when(j.last.at)}`, note: `${plural(j.last.kept || 1, 'nightly copy', 'nightly copies')} kept` };
    } },
  ];
  const LABEL: Record<Tone, string> = { ok: 'OK', old: 'Fallback', todo: 'To do', bad: 'Problem' };

  const show = (which: 'loading' | 'gate' | 'dash') => { $('loading').hidden = which !== 'loading'; $('gate').hidden = which !== 'gate'; $('dash').hidden = which !== 'dash'; };

  async function api(init?: RequestInit, query = '') {
    const token = store.get();
    return fetch('/api/admin' + query, { cache: 'no-store', signal: AbortSignal.timeout(20000), ...init, headers: { ...(init && init.headers), ...(token ? { authorization: `Bearer ${token}` } : {}) } });
  }

  // ---- the dashboard -------------------------------------------------------------------------------------------------------------
  const tally: Record<string, Tone> = {};
  function summarize() {
    const tones = Object.values(tally), n = (t: Tone[]) => tones.filter((x) => t.includes(x)).length;
    $('n-ok').textContent = String(n(['ok'])); $('n-old').textContent = String(n(['old'])); $('n-todo').textContent = String(n(['todo', 'bad']));
    if (tones.length < ROWS.length) return;
    const bad = ROWS.filter((r) => tally[r.name] !== 'ok').map((r) => r.name), banner = $('banner');
    if (!bad.length) { banner.dataset.tone = 'ok'; banner.textContent = 'Everything is switched on and answering.'; }
    else { banner.dataset.tone = ROWS.some((r) => tally[r.name] === 'bad') ? 'bad' : 'old'; banner.textContent = `${bad.length} of ${ROWS.length} need attention: ${bad.join(', ')}.`; }
    $('foot-note').textContent = `Checked ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}.`;
    for (const g of ['feeds', 'send', 'keep']) {
      const mine = ROWS.filter((r) => r.group === g), off = mine.filter((r) => tally[r.name] !== 'ok').length, b = $(`b-${g}`);
      b.textContent = off ? String(off) : '✓'; b.dataset.tone = off ? 'warn' : 'ok';
    }
  }
  function paint(li: HTMLElement, r: Result) {
    li.dataset.tone = r.tone;
    (li.querySelector('.tag') as HTMLElement).textContent = LABEL[r.tone];
    (li.querySelector('.text') as HTMLElement).textContent = r.text;
    (li.querySelector('.note') as HTMLElement).textContent = r.note || '';
  }
  function runChecks() {
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((el) => { el.textContent = ''; });
    Object.keys(tally).forEach((k) => delete tally[k]);
    ROWS.forEach((row) => {
      const li = document.createElement('li');
      li.className = 'row'; li.dataset.tone = 'wait';
      li.innerHTML = '<span class="name"></span><span class="tag">…</span><span class="text">Checking…</span><span class="note"></span>';
      (li.querySelector('.name') as HTMLElement).textContent = row.name;
      document.querySelector(`[data-group="${row.group}"]`)?.appendChild(li);
      const done = (r: Result) => { paint(li, r); tally[row.name] = r.tone; summarize(); };
      fetch(row.url, { cache: 'no-store', signal: AbortSignal.timeout(20000) })
        .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
        .then((j) => done(row.read(j)))
        .catch(() => done({ tone: 'bad', text: 'Could not be reached', note: 'Try again in a minute' }));
    });
  }
  function drawSetup(groups: { group: string; items: { name: string; label: string; present: boolean }[] }[]) {
    const box = $('setup-list'); box.textContent = '';
    let missing = 0;
    for (const g of groups) {
      const h = document.createElement('h3'); h.textContent = g.group; box.appendChild(h);
      const ul = document.createElement('ul'); ul.className = 'rows';
      for (const it of g.items) {
        if (!it.present) missing += 1;
        const li = document.createElement('li'); li.className = 'row'; li.dataset.tone = it.present ? 'ok' : 'todo';
        li.innerHTML = '<span class="name"></span><span class="tag"></span><span class="note"></span>';
        (li.querySelector('.name') as HTMLElement).textContent = it.label;
        (li.querySelector('.tag') as HTMLElement).textContent = it.present ? 'Set' : 'Missing';
        (li.querySelector('.note') as HTMLElement).textContent = it.name;
        ul.appendChild(li);
      }
      box.appendChild(ul);
    }
    const b = $('b-setup'); b.textContent = missing ? String(missing) : '✓'; b.dataset.tone = missing ? 'warn' : 'ok';
  }
  function signedOut(message = '') { store.clear(); show('gate'); $('login-error').textContent = message; $('not-set-up').hidden = true; ($('login') as HTMLElement).hidden = false; }

  async function openDash(data: any) {
    show('dash');
    drawSetup(data.setup || []);
    runChecks(); loadEvents(); loadAnalytics(); loadPush();
    fetch('/version.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).then((j) => { $('ver-line').textContent = j && j.version ? `Version: ${String(j.version).replace(/^nrn-/, '')}` : 'Version: unknown'; }).catch(() => { $('ver-line').textContent = 'Version: unknown'; });
  }

  // remember which folders are open (this tab only)
  try {
    const open = new Set<string>(JSON.parse(sessionStorage.getItem(OPEN) || 'null') || ['feeds']);
    document.querySelectorAll<HTMLDetailsElement>('details.folder').forEach((d) => {
      d.open = open.has(d.dataset.folder || '');
      d.addEventListener('toggle', () => { d.open ? open.add(d.dataset.folder || '') : open.delete(d.dataset.folder || ''); try { sessionStorage.setItem(OPEN, JSON.stringify([...open])); } catch { /* ignore */ } });
    });
  } catch { /* leave the defaults */ }

  $('login').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = (e.target as HTMLFormElement).querySelector('button') as HTMLButtonElement, err = $('login-error');
    btn.disabled = true; err.textContent = '';
    try {
      const res = await fetch('/api/admin', { method: 'POST', cache: 'no-store', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'login', password: ($('pw') as HTMLInputElement).value }) });
      const j = await res.json().catch(() => ({}));
      if (res.ok && j.token) { store.set(j.token); ($('pw') as HTMLInputElement).value = ''; await start(); }
      else err.textContent = j.message || 'Could not sign in. Try again.';
    } catch { err.textContent = 'Could not reach the site. Check your connection and try again.'; }
    btn.disabled = false;
  });
  $('sign-out').addEventListener('click', () => signedOut('You are signed out on this device.'));
  $('backup-now').addEventListener('click', async () => {
    const btn = $('backup-now') as HTMLButtonElement, out = $('backup-result');
    btn.disabled = true; out.textContent = 'Backing up…';
    try {
      const res = await api({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'backup' }) });
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (j.ok) {
        const parts = Object.entries(j.saved || {}).map(([k, v]: [string, any]) => `${k}: ${plural(v.rows, 'row', 'rows')}`);
        const bad = [...Object.keys(j.failed || {}).map((k) => `${k} failed`), ...Object.keys(j.skipped || {}).map((k) => `${k} skipped`)];
        out.textContent = `Saved (${parts.join(', ')})${bad.length ? `. Not saved: ${bad.join(', ')}.` : '.'}`;
      } else out.textContent = j.message || (j.result === 'nothing-saved' ? 'Nothing could be saved: no sheet could be read.' : 'The backup did not run. Try again in a minute.');
      runChecks();
    } catch { out.textContent = 'Could not reach the site. Try again.'; }
    btn.disabled = false;
  });

  // ---- events ---------------------------------------------------------------------------------------------------------------------
  type Ev = { id: string; slug: string; title: string; day: string; time: string; where: string; details: string; tickets: string; video: string; watch: string; flyer: string; published: boolean };
  let events: Ev[] = [], flyerData: { big: string; small: string } | null = null, editing: Ev | null = null;
  const todayIso = () => new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(new Date());
  const nice = (day: string) => new Date(+day.slice(0, 4), +day.slice(5, 7) - 1, +day.slice(8, 10)).toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
  const fld = <T extends HTMLElement = HTMLInputElement>(id: string) => $(id) as T;

  function drawEvents() {
    const ul = $('ev-list'); ul.textContent = '';
    if (!events.length) { $('ev-msg').textContent = 'No events added here yet. The Events page still shows the Certified Lounge show guide and the older past events.'; }
    else $('ev-msg').textContent = '';
    const today = todayIso();
    for (const e of events) {
      const li = document.createElement('li'); li.className = 'row'; li.dataset.tone = e.published ? (e.day >= today ? 'ok' : 'wait') : 'todo';
      li.innerHTML = '<span class="name"></span><span class="tag"></span><span class="note"></span><span class="rowact"><button type="button" class="btn small" data-edit></button></span>';
      (li.querySelector('.name') as HTMLElement).textContent = e.title;
      (li.querySelector('.tag') as HTMLElement).textContent = !e.published ? 'Hidden' : e.day >= today ? 'Upcoming' : 'Past';
      (li.querySelector('.note') as HTMLElement).textContent = `${nice(e.day)}${e.time ? ' · ' + e.time : ''}${e.where ? ' · ' + e.where : ''}`;
      const b = li.querySelector('[data-edit]') as HTMLButtonElement; b.textContent = 'Edit'; b.setAttribute('aria-label', `Edit ${e.title}`);
      b.addEventListener('click', () => openForm(e));
      if (e.published && e.slug) { const v = document.createElement('a'); v.className = 'btn small'; v.textContent = 'View page'; v.href = `/events/${e.slug}/`; v.target = '_blank'; v.rel = 'noopener'; v.setAttribute('aria-label', `View the page for ${e.title}`); (li.querySelector('.rowact') as HTMLElement).appendChild(v); }
      ul.appendChild(li);
    }
    const up = events.filter((e) => e.published && e.day >= today).length, badge = $('b-events');
    badge.textContent = String(up); badge.dataset.tone = up ? 'ok' : 'warn';
  }
  async function loadEvents() {
    try {
      const res = await api(undefined, '?section=events');
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (j.ok) { events = j.events || []; drawEvents(); }
      else { $('ev-msg').textContent = j.result === 'no-db' ? 'The site database is not connected yet, so events cannot be saved. See the Setup checklist below.' : (j.message || 'Could not load the events.'); $('ev-add').hidden = true; $('b-events').textContent = '!'; $('b-events').dataset.tone = 'warn'; }
    } catch { $('ev-msg').textContent = 'Could not reach the site. Reload this page to try again.'; }
  }
  function openForm(e: Ev | null) {
    editing = e; flyerData = null;
    $('ev-form').hidden = false; $('ev-add').hidden = true;
    $('ev-form-title').textContent = e ? 'Edit event' : 'New event';
    fld('ev-title').value = e ? e.title : ''; fld('ev-day').value = e ? e.day : ''; fld('ev-time').value = e ? e.time : ''; fld('ev-where').value = e ? e.where : '';
    fld<HTMLTextAreaElement>('ev-details').value = e ? e.details : ''; fld('ev-tickets').value = e ? e.tickets : ''; fld('ev-video').value = e ? e.video : ''; fld('ev-watch').value = e ? e.watch : '';
    fld('ev-flyer').value = ''; fld('ev-rm').checked = false; fld('ev-pub').checked = e ? e.published : true;
    const prev = fld<HTMLImageElement>('ev-preview');
    if (e && e.flyer) { prev.src = `/api/flyer?id=${encodeURIComponent(e.flyer)}&size=480`; prev.hidden = false; $('ev-rm-wrap').hidden = false; } else { prev.removeAttribute('src'); prev.hidden = true; $('ev-rm-wrap').hidden = true; }
    $('ev-delete').hidden = !e; $('ev-error').textContent = '';
    fld('ev-title').focus();
  }
  function closeForm() { $('ev-form').hidden = true; $('ev-add').hidden = false; editing = null; flyerData = null; }
  // Make the two flyer sizes in the browser (900 px and 480 px wide), the same way Soul Vault does for covers.
  async function makeFlyer(file: File) {
    const bmp = await createImageBitmap(file);
    const draw = (w: number, type: string, q: number) => {
      const k = Math.min(1, w / bmp.width), c = document.createElement('canvas'); c.width = Math.max(1, Math.round(bmp.width * k)); c.height = Math.max(1, Math.round(bmp.height * k));
      const g = c.getContext('2d') as CanvasRenderingContext2D; g.drawImage(bmp, 0, 0, c.width, c.height); return c.toDataURL(type, q);
    };
    let big = draw(900, 'image/webp', 0.82), small = draw(480, 'image/webp', 0.82);
    if (!big.startsWith('data:image/webp') || !small.startsWith('data:image/webp')) { big = draw(900, 'image/jpeg', 0.85); small = draw(480, 'image/jpeg', 0.85); }
    return { big, small };
  }
  fld('ev-flyer').addEventListener('change', async () => {
    const f = fld('ev-flyer').files && fld('ev-flyer').files![0], err = $('ev-error'); err.textContent = '';
    if (!f) { flyerData = null; return; }
    try { flyerData = await makeFlyer(f); const prev = fld<HTMLImageElement>('ev-preview'); prev.src = flyerData.small; prev.hidden = false; fld('ev-rm').checked = false; }
    catch { flyerData = null; err.textContent = 'That picture could not be read. Use a JPG, PNG or WebP.'; }
  });
  $('ev-add').addEventListener('click', () => openForm(null));
  $('ev-cancel').addEventListener('click', closeForm);
  async function sendEvent(body: object, btn: HTMLButtonElement) {
    const err = $('ev-error'); btn.disabled = true; err.textContent = '';
    try {
      const res = await api({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (j.ok) { closeForm(); await loadEvents(); $('ev-msg').textContent = 'Saved. It shows on the Events page within a minute.'; }
      else err.textContent = j.error || j.message || 'Could not save. Try again.';
    } catch { err.textContent = 'Could not reach the site. Try again.'; }
    btn.disabled = false;
  }
  $('ev-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const ev: any = { title: fld('ev-title').value, day: fld('ev-day').value, time: fld('ev-time').value, where: fld('ev-where').value, details: fld<HTMLTextAreaElement>('ev-details').value, tickets: fld('ev-tickets').value, video: fld('ev-video').value, watch: fld('ev-watch').value, published: fld('ev-pub').checked };
    if (editing) ev.id = editing.id;
    if (flyerData) ev.flyer = flyerData; else if (editing && fld('ev-rm').checked) ev.removeFlyer = true;
    sendEvent({ action: 'event-save', event: ev }, $('ev-save') as HTMLButtonElement);
  });
  $('ev-delete').addEventListener('click', () => {
    if (!editing) return;
    if (!confirm(`Delete "${editing.title}"? This cannot be undone.`)) return;
    sendEvent({ action: 'event-delete', id: editing.id }, $('ev-delete') as HTMLButtonElement);
  });

  // ---- website analytics ----------------------------------------------------------------------------------------------------------
  const change = (now: number, before: number) => (!before ? (now ? 'new' : '') : `${now >= before ? '+' : '−'}${Math.round((Math.abs(now - before) / before) * 100)}% vs the period before`);
  function list(title: string, rows: { name: string; views: number }[], total: number, label = 'views') {
    const box = document.createElement('section'); const h = document.createElement('h3'); h.textContent = title; box.appendChild(h);
    if (!rows.length) { const p = document.createElement('p'); p.className = 'result'; p.textContent = 'Nothing yet.'; box.appendChild(p); return box; }
    const ul = document.createElement('ul'); ul.className = 'bar-list';
    for (const r of rows) {
      const li = document.createElement('li'); li.innerHTML = '<span class="bn"></span><span class="bv"></span><span class="bb" aria-hidden="true"><i></i></span>';
      (li.querySelector('.bn') as HTMLElement).textContent = r.name === 'phone' || r.name === 'tablet' || r.name === 'computer' ? r.name[0].toUpperCase() + r.name.slice(1) : r.name;
      (li.querySelector('.bv') as HTMLElement).textContent = `${r.views} ${label}`;
      (li.querySelector('.bb i') as HTMLElement).style.width = `${total ? Math.max(2, Math.round((r.views / total) * 100)) : 0}%`;
      ul.appendChild(li);
    }
    box.appendChild(ul); return box;
  }
  function drawAnalytics(a: any) {
    const out = $('an-out'); out.textContent = '';
    const kpis = document.createElement('div'); kpis.className = 'strip';
    for (const [n, label, sub] of [[String(a.views), 'Page views', change(a.views, a.previous.views)], [String(a.visitors), 'Visitors', change(a.visitors, a.previous.visitors)], [a.viewsPerVisitor == null ? '–' : String(a.viewsPerVisitor), 'Views per visitor', '']]) {
      const d = document.createElement('div'); d.innerHTML = '<b></b><span></span><small></small>';
      (d.querySelector('b') as HTMLElement).textContent = n; (d.querySelector('span') as HTMLElement).textContent = label; (d.querySelector('small') as HTMLElement).textContent = sub; kpis.appendChild(d);
    }
    out.appendChild(kpis);
    if (!a.views) { const p = document.createElement('p'); p.className = 'result'; p.textContent = 'No visits recorded in this time yet. Counting starts once the site is updated with the counter and the database is connected.'; out.appendChild(p); }
    const max = Math.max(1, ...a.daily.map((d: any) => d.views)), bars = document.createElement('div'); bars.className = 'bars'; bars.setAttribute('role', 'img');
    bars.setAttribute('aria-label', `Page views per day, ${a.daily[0].day} to ${a.daily[a.daily.length - 1].day}. Busiest day: ${max} views.`);
    for (const d of a.daily) { const i = document.createElement('i'); i.style.height = `${Math.max(2, Math.round((d.views / max) * 100))}%`; i.title = `${d.day}: ${d.views} views, ${d.visitors} visitors`; bars.appendChild(i); }
    out.appendChild(bars);
    const total = a.views;
    out.appendChild(list('Top pages', a.pages, total)); out.appendChild(list('Where people come from', a.referrers, total, 'visits')); out.appendChild(list('Devices', a.devices, total)); out.appendChild(list('Cities', a.cities, total));
    const note = document.createElement('p'); note.className = 'result';
    note.textContent = 'Visitors are counted once per day. The site deliberately cannot tell that it is the same person on two different days, so someone who visits on three days counts three times. No cookies, no IP addresses stored; visits from you while signed in, robots and people who send Do Not Track are left out.';
    out.appendChild(note);
    const b = $('b-analytics'); b.textContent = String(a.views); b.dataset.tone = a.views ? 'ok' : 'warn';
  }
  async function loadAnalytics() {
    const out = $('an-out'); out.innerHTML = '<p class="result">Loading…</p>';
    try {
      const res = await api(undefined, `?section=analytics&days=${(fld<HTMLSelectElement>('an-days')).value}`);
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (j.ok) drawAnalytics(j);
      else { out.innerHTML = ''; const p = document.createElement('p'); p.className = 'result'; p.textContent = j.result === 'no-db' ? 'The site database is not connected yet. See the Setup checklist below.' : (j.message || 'Could not load the numbers.'); out.appendChild(p); $('b-analytics').textContent = '!'; $('b-analytics').dataset.tone = 'warn'; }
    } catch { out.innerHTML = '<p class="result">Could not reach the site. Reload this page to try again.</p>'; }
  }
  fld<HTMLSelectElement>('an-days').addEventListener('change', loadAnalytics);

  // Phone notifications: how many phones, and the Send form (src/edge/push.js; at most 3 a day).
  async function loadPush() {
    const msg = $('push-msg'), form = $('push-form'), badge = $('b-push');
    try {
      const res = await api(undefined, '?section=push');
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (!j.ok) { form.hidden = true; msg.textContent = j.result === 'no-db' ? 'The site database is not connected yet. See the Setup checklist below.' : (j.message || 'Could not load.'); badge.textContent = '!'; badge.dataset.tone = 'warn'; return; }
      if (!j.on) { form.hidden = true; msg.textContent = 'Notifications are not switched on yet: the two keys (VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY) are missing in Cloudflare. See the Setup checklist below.'; badge.textContent = '!'; badge.dataset.tone = 'warn'; return; }
      msg.textContent = `${j.subscribers} ${j.subscribers === 1 ? 'phone has' : 'phones have'} notifications on. You have sent ${j.sentToday} of ${j.cap} allowed in the last 24 hours.`;
      form.hidden = false; badge.textContent = String(j.subscribers); badge.dataset.tone = 'ok';
      $('push-auto').hidden = false; document.querySelectorAll<HTMLInputElement>('[data-auto]').forEach((c) => { c.checked = !!(j.auto && j.auto[c.dataset.auto as string]); });
      $('push-send').textContent = `Send to ${j.subscribers} ${j.subscribers === 1 ? 'phone' : 'phones'}`;
      const ul = $('push-last'); ul.innerHTML = '';
      for (const l of (j.last || [])) { const li = document.createElement('li'); li.className = 'row'; li.textContent = `${new Date(l.at).toLocaleDateString()}: ${l.title} (${l.sent} ${l.sent === 1 ? 'phone' : 'phones'})`; ul.appendChild(li); }
    } catch { msg.textContent = 'Could not reach the site. Reload this page to try again.'; }
  }
  $('push-auto').addEventListener('change', async () => {
    const st = $('push-auto-st'), want: Record<string, boolean> = {}; document.querySelectorAll<HTMLInputElement>('[data-auto]').forEach((c) => { want[c.dataset.auto as string] = c.checked; });
    st.textContent = 'Saving…';
    try {
      const res = await api({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'push-auto', auto: want }) });
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (!j.ok) { st.textContent = j.message || 'Could not save.'; await loadPush(); return; }
