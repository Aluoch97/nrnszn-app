    try {
      const res = await api({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'push-send', push: { title, body: fld<HTMLInputElement>('push-body').value, url: fld<HTMLSelectElement>('push-url').value } }) });
      if (res.status === 401) { signedOut('Please sign in again.'); return; }
      const j = await res.json().catch(() => ({}));
      if (j.ok) { $('push-done').textContent = `Sent to ${j.sent} ${j.sent === 1 ? 'phone' : 'phones'}${j.removed ? ` (${j.removed} had turned them off)` : ''}.`; fld<HTMLInputElement>('push-title').value = ''; fld<HTMLInputElement>('push-body').value = ''; pushPreview(); await loadPush(); }
      else err.textContent = j.message || 'Could not send.';
    } catch { err.textContent = 'Could not reach the site. Try again.'; }
    btn.disabled = false; if (btn.textContent === 'Sending…') btn.textContent = label;
  });

  async function start() {
    show('loading');
    try {
      const res = await api();
      if (res.status === 401) { signedOut(store.get() ? 'Please sign in again.' : ''); return; }
      const j = await res.json();
      if (j.mode === 'not-set-up') { show('gate'); ($('login') as HTMLElement).hidden = true; $('not-set-up').hidden = false; return; }
      if (j.signedIn) { await openDash(j); return; }
      show('gate'); ($('login') as HTMLElement).hidden = false; $('not-set-up').hidden = true;
    } catch { show('gate'); ($('login') as HTMLElement).hidden = false; $('login-error').textContent = 'Could not reach the site. Check your connection and reload.'; }
  }
  start();
</script>

