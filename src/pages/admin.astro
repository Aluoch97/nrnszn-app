    note.textContent = 'Visitors are counted once per day. The site deliberately cannot tell that it is the same person on two different days, so someone who visits on three days counts three times. No cookies, no IP addresses stored; visits from you while signed in, robots and people who send Do Not Track are left out.';
    out.appendChild(note);
    const b = $('b-analytics'); b.textContent = String(a.views); b.dataset.tone = a.views ? 'ok' : 'warn';
  }
  async function loadAnalytics() {
