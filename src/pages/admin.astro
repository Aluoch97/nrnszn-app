  // ---- website analytics ----------------------------------------------------------------------------------------------------------
  const change = (now: number, before: number) => (!before ? (now ? 'new' : '') : `${now >= before ? '+' : '−'}${Math.round((Math.abs(now - before) / before) * 100)}% vs the period before`);
  function list(title: string, rows: { name: string; views: number }[], total: number, label = 'views') {
    const box = document.createElement('section'); const h = document.createElement('h3'); h.textContent = title; box.appendChild(h);
    if (!rows.length) { const p = document.createElement('p'); p.className = 'result'; p.textContent = 'Nothing yet.'; box.appendChild(p); return box; }
    const ul = document.createElement('ul'); ul.className = 'bar-list';
    for (const r of rows) {
      const li = document.createElement('li'); li.innerHTML = '<span class="bn"></span><span class="bv"></span><span class="bb" aria-hidden="true"><i></i></span>';
      (li.querySelector('.bn') as HTMLElement).textContent = r.name === 'phone' || r.name === 'tablet' || r.name === 'computer' ? r.name[0].toUpperCase() + r.name.slice(1) : r.name;
      (li.querySelector('.bv') as HTMLElement).textContent = `${r.views} ${label}`;
      (li.querySelector('.bb i') as HTMLElement).style.width = `${total ? Math.max(2, Math.round((r.views / total) * 100)) : 0}%`;
      ul.appendChild(li);
    }
    box.appendChild(ul); return box;
  }
  function drawAnalytics(a: any) {
    const out = $('an-out'); out.textContent = '';
    const kpis = document.createElement('div'); kpis.className = 'strip';
    for (const [n, label, sub] of [[String(a.views), 'Page views', change(a.views, a.previous.views)], [String(a.visitors), 'Visitors', change(a.visitors, a.previous.visitors)], [a.viewsPerVisitor == null ? '–' : String(a.viewsPerVisitor), 'Views per visitor', '']]) {
      const d = document.createElement('div'); d.innerHTML = '<b></b><span></span><small></small>';
      (d.querySelector('b') as HTMLElement).textContent = n; (d.querySelector('span') as HTMLElement).textContent = label; (d.querySelector('small') as HTMLElement).textContent = sub; kpis.appendChild(d);
    }
    out.appendChild(kpis);
    if (!a.views) { const p = document.createElement('p'); p.className = 'result'; p.textContent = 'No visits recorded in this time yet. Counting starts once the site is updated with the counter and the database is connected.'; out.appendChild(p); }
