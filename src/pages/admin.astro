      document.querySelectorAll<HTMLInputElement>('[data-auto]').forEach((c) => { c.checked = !!j.auto[c.dataset.auto as string]; });
      const failed = asked.filter((k) => !j.auto[k]);
      st.textContent = (on.length ? `On: ${on.join(', ')}. Everything that exists today was recorded, so only NEW things are announced.` : 'Off. Nothing is sent by itself.') + (failed.length ? ` Could not switch on ${failed.join(', ')}: that source could not be read right now (check the Setup checklist), so it was left off.` : '');
    } catch { st.textContent = 'Could not reach the site. Try again.'; }
  });
  const pushPreview = () => { const t = fld<HTMLInputElement>('push-title').value, b = fld<HTMLInputElement>('push-body').value; $('push-preview').textContent = t || b ? `It will look like: “${t || '…'}”${b ? ' — ' + b : ''}` : ''; };
  fld<HTMLInputElement>('push-title').addEventListener('input', pushPreview); fld<HTMLInputElement>('push-body').addEventListener('input', pushPreview);
  $('push-form').addEventListener('submit', async (ev) => {
    ev.preventDefault(); const err = $('push-error'), btn = $('push-send') as HTMLButtonElement; err.textContent = ''; $('push-done').textContent = '';
