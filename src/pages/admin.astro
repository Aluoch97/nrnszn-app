    $('hv-form-title').textContent = `Video for ${name}`; $('hv-form').hidden = false; $('hv-list').hidden = true;
    ($('hv-file') as HTMLInputElement).focus();
  }
  function hvClose() { hvReset(); $('hv-form').hidden = true; $('hv-list').hidden = false; }
  async function hvRemove(id: string, name: string) {
    if (!confirm(`Remove the video on ${name}? The page goes back to its pictures.`)) return;
    const res = await hvApi({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'remove', page: id }) }).catch(() => null);
    const j = res ? await res.json().catch(() => ({})) : {};
    if (j.ok) { delete hvVideos[id]; drawVideos(); $('hv-msg').textContent = `Removed. ${name} shows its pictures again within a minute.`; }
    else $('hv-msg').textContent = j.message || 'Could not remove it. Try again.';
  }
  $('hv-cancel').addEventListener('click', hvClose);
  $('hv-file').addEventListener('change', () => {
    const f = ($('hv-file') as HTMLInputElement).files?.[0]; $('hv-error').textContent = '';
    if (!f) return;
    if (!/^video\//.test(f.type) && !/\.(mov|mp4|m4v|webm)$/i.test(f.name)) { $('hv-error').textContent = 'Pick a video file.'; return; }
    hvFile = f; if (hvUrl) URL.revokeObjectURL(hvUrl); hvUrl = URL.createObjectURL(f);
    const prev = $('hv-prev') as HTMLVideoElement; prev.src = hvUrl; prev.hidden = false;
    prev.onloadedmetadata = () => {
      const r = $('hv-start') as HTMLInputElement; r.max = String(Math.max(0, Math.floor((prev.duration - 2) * 10) / 10)); r.value = '0'; $('hv-start-t').textContent = '0:00';
      $('hv-trim').hidden = false; ($('hv-save') as HTMLButtonElement).disabled = false;
      hvShowFraming(hvUrl, 0);
      hvAuto();   // a new video is placed on the action by itself
    };
    prev.onerror = () => { $('hv-error').textContent = 'This browser cannot open that video. Try another one, or a newer phone or computer.'; };
  });
  $('hv-start').addEventListener('input', () => {
    const t = Number(($('hv-start') as HTMLInputElement).value); $('hv-start-t').textContent = mmss(t);
    const prev = $('hv-prev') as HTMLVideoElement; prev.currentTime = t;
    document.querySelectorAll<HTMLVideoElement>('.hv-box video').forEach((v) => { try { v.currentTime = t; } catch { /* ignore */ } });
  });
  const fitSize = (w: number, h: number, max: number) => { const k = Math.min(1, max / Math.max(w, h)); return { width: Math.max(2, Math.round((w * k) / 2) * 2), height: Math.max(2, Math.round((h * k) / 2) * 2) }; };
  async function hvPoster(prev: HTMLVideoElement, t: number): Promise<Blob> {
    await new Promise<void>((ok) => { const done = () => { prev.removeEventListener('seeked', done); ok(); }; prev.addEventListener('seeked', done); prev.currentTime = t + 0.05; setTimeout(done, 3000); });
    const s = fitSize(prev.videoWidth, prev.videoHeight, 1280), c = document.createElement('canvas'); c.width = s.width; c.height = s.height;
    c.getContext('2d')!.drawImage(prev, 0, 0, s.width, s.height);
    return new Promise((ok, no) => c.toBlob((b) => (b ? ok(b) : no(new Error('poster'))), 'image/jpeg', 0.82));
  }
  $('hv-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('hv-save') as HTMLButtonElement, prog = $('hv-progress'), err = $('hv-error');
    if (hvMode === 'adjust') {
      btn.disabled = true; err.textContent = '';
      const res = await hvApi({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'frame', page: hvPage, frame: hvFrame() }) }).catch(() => null);
      const j = res ? await res.json().catch(() => ({})) : {};
      if (res && res.status === 401) { signedOut('Please sign in again.'); return; }
      if (!j.ok) { err.textContent = j.message || 'Could not save the position. Try again.'; btn.disabled = false; return; }
      const name = (HV_PAGES.find((x) => x[0] === hvPage) || [])[1] || 'the page';
      hvVideos[hvPage].frame = j.frame; hvClose(); drawVideos(); $('hv-msg').textContent = `Position saved. ${name} shows it within a minute.`;
      return;
    }
    if (!hvFile) return;
    btn.disabled = true; err.textContent = '';
    const prev = $('hv-prev') as HTMLVideoElement, start = Number(($('hv-start') as HTMLInputElement).value), len = Number(($('hv-len') as HTMLSelectElement).value);
    const end = Math.min(prev.duration || start + len, start + len);
    try {
      prog.textContent = 'Getting ready…';
      const M = await import('mediabunny');
      if (!(await M.canEncodeVideo('avc'))) throw new Error('This browser cannot make videos. Use Chrome, or Safari on iPhone with iOS 17 or newer.');
      const make = async (max: number, bitrate: number, from: number, to: number) => {
        const input = new M.Input({ formats: M.ALL_FORMATS, source: new M.BlobSource(hvFile!) });
        const output = new M.Output({ format: new M.Mp4OutputFormat({ fastStart: 'in-memory' }), target: new M.BufferTarget() });
        // Only the main picture: no sound, no second video track (DJI and some phones add a thumbnail track) and no camera tags
        // (their cover picture ends up as an extra track that iPhones may stumble on).
        const conv = await M.Conversion.init({ input, output, video: (_t: unknown, n: number) => (n > 1 ? { discard: true } : { ...fitSize(prev.videoWidth, prev.videoHeight, max), fit: 'fill', codec: 'avc', bitrate, frameRate: 30, keyFrameInterval: 2 }), audio: { discard: true }, tags: {}, trim: { start, end }, showWarnings: false });
        if (!conv.isValid) throw new Error('That video could not be read. Try another one.');
        conv.onProgress = (p: number) => { prog.textContent = `Making the video… ${Math.round(from + (to - from) * p)}%`; };
        await conv.execute();
        return new Blob([(output.target as any).buffer], { type: 'video/mp4' });
      };
      const large = await make(1280, 2_500_000, 0, 60);
      const small = await make(720, 1_100_000, 60, 90);
      const poster = await hvPoster(prev, start);
      const v = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      let i = 0;
      for (const [part, blob] of [['large.mp4', large], ['small.mp4', small], ['poster.jpg', poster]] as [string, Blob][]) {
        prog.textContent = `Uploading… ${90 + i * 3}%`; i++;
        const res = await hvApi({ method: 'PUT', headers: { 'content-type': blob.type }, body: blob }, `?page=${hvPage}&v=${v}&part=${part}`);
        const j = await res.json().catch(() => ({}));
        if (res.status === 401) { signedOut('Please sign in again.'); return; }
        if (!j.ok) throw new Error(j.message || 'The upload did not work. Try again.');
      }
      const res = await hvApi({ method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'set', page: hvPage, v, frame: hvFrame() }) });
      const j = await res.json().catch(() => ({}));
      if (!j.ok) throw new Error(j.message || 'The upload did not work. Try again.');
      const name = (HV_PAGES.find((x) => x[0] === hvPage) || [])[1] || 'the page';
      hvVideos[hvPage] = { v, at: Date.now(), frame: hvFrame() }; hvClose(); drawVideos();
      $('hv-msg').textContent = `Saved (${(large.size / 1e6).toFixed(1)} MB for computers, ${(small.size / 1e6).toFixed(1)} MB for phones). ${name} shows it within a minute.`;
    } catch (x) {
      err.textContent = x instanceof Error && x.message ? x.message : 'Something went wrong. Try again.'; prog.textContent = ''; btn.disabled = false;
    }
  });
</script>

