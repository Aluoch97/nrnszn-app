---
import Site from '../layouts/Site.astro';
---
<Site
  title="Admin | NuRenaissance"
  description="Owner sign-in for the NuRenaissance site: live status of every feed and form, backups, and the setup checklist."
  noindex={true}
>
  <article class="admin">
    <h1>Admin</h1>
    <p id="loading" class="lead" role="status">Loading…</p>

    <!-- Sign-in (shown until you are signed in) -->
    <section id="gate" hidden aria-labelledby="gate-title">
      <h2 id="gate-title">Sign in</h2>
      <form id="login" class="login">
        <label for="pw">Admin password</label>
        <input id="pw" name="password" type="password" autocomplete="current-password" required />
        <button type="submit" class="btn primary">Sign in</button>
        <p id="login-error" class="error" role="alert"></p>
        <details class="forgot" id="forgot">
          <summary>Forgot your password?</summary>
          <div id="acct-door" hidden>
            <p>Sign in with your NuRenaissance account instead (the Google account or e-mail you use at <a href="/account">Your account</a>).</p>
            <button type="button" class="btn" id="acct-login">Sign in with my account</button>
            <p id="acct-error" class="error" role="alert"></p>
          </div>
          <p>Or set a new password: Cloudflare → <strong>Workers &amp; Pages</strong> → nrnszn-app → <strong>Settings</strong> → <strong>Variables and Secrets</strong> → <code>ADMIN_PASSWORD</code> → <strong>Edit</strong> → type a new one (10+ characters) → <strong>Save</strong>, then <strong>Deployments</strong> → latest → <strong>⋯</strong> → <strong>Retry deployment</strong>. This signs every device out.</p>
          <p id="acct-door-off" class="hint">To be able to sign in with your account here, add a <strong>Text</strong> variable <code>ADMIN_EMAILS</code> with your e-mail in the same place.</p>
        </details>
      </form>
      <div id="not-set-up" hidden class="callout">
        <p><strong>Sign-in is not set up yet.</strong> To switch it on:</p>
        <ol>
          <li>Make up a long password (at least 10 characters).</li>
          <li>Cloudflare → <strong>Workers &amp; Pages</strong> → the nrnszn project → <strong>Settings</strong> → <strong>Variables and Secrets</strong> → <strong>Add</strong> → type <strong>Secret</strong>, name <code>ADMIN_PASSWORD</code>, value = your password → <strong>Save</strong>.</li>
          <li><strong>Deployments</strong> → the latest → <strong>⋯</strong> → <strong>Retry deployment</strong>, then reload this page.</li>
        </ol>
      </div>
    </section>

    <!-- The settings page (shown once signed in): a summary, then folders, like Soul Vault's Settings -->
    <section id="dash" hidden aria-label="Admin settings">
      <p class="banner" id="banner" role="status" aria-live="polite" data-tone="wait">Checking everything…</p>
      <div class="strip" aria-label="Summary">
        <div><b id="n-ok">0</b><span>New</span></div>
        <div><b id="n-old">0</b><span>Old fallback</span></div>
        <div><b id="n-todo">0</b><span>To do</span></div>
      </div>

      <section class="grp g-create">
        <h2>Create &amp; send</h2>
      <details class="folder hero" data-folder="events">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span><span class="ft"><b>Events</b><span>Add and edit the events on the Events page</span></span><span class="badge" id="b-events">…</span></summary>
        <div id="ev-box">
          <p id="ev-msg" class="result" role="status" aria-live="polite"></p>
          <ul class="rows" id="ev-list"></ul>
          <div class="actions"><button type="button" class="btn primary" id="ev-add">Add an event</button></div>
          <form id="ev-form" class="evform" hidden>
            <h3 id="ev-form-title">New event</h3>
            <label for="ev-title">Event name</label><input id="ev-title" type="text" maxlength="120" autocomplete="off" required />
            <label for="ev-day">Date</label><input id="ev-day" type="date" required />
            <label for="ev-time">Time <span class="hint">(optional, for example 7–11 PM)</span></label><input id="ev-time" type="text" maxlength="40" autocomplete="off" />
            <label for="ev-where">Where <span class="hint">(optional)</span></label><input id="ev-where" type="text" maxlength="160" autocomplete="off" />
            <label for="ev-details">Details <span class="hint">(optional)</span></label><textarea id="ev-details" rows="4" maxlength="2000"></textarea>
            <label for="ev-tickets">Tickets link <span class="hint">(optional, starts with https://)</span></label><input id="ev-tickets" type="url" maxlength="500" autocomplete="off" />
            <label for="ev-video">Recap video link <span class="hint">(optional, starts with https://)</span></label><input id="ev-video" type="url" maxlength="500" autocomplete="off" />
            <label for="ev-watch">Watch on this site <span class="hint">(optional, a page like /cinema)</span></label><input id="ev-watch" type="text" maxlength="100" autocomplete="off" />
            <label for="ev-flyer">Flyer picture <span class="hint">(optional, JPG, PNG or WebP)</span></label>
            <input id="ev-flyer" type="file" accept="image/jpeg,image/png,image/webp" />
            <img id="ev-preview" alt="Flyer preview" hidden />
            <label class="check" id="ev-rm-wrap" hidden><input id="ev-rm" type="checkbox" /> Remove the current flyer</label>
            <label class="check"><input id="ev-pub" type="checkbox" checked /> Show on the Events page</label>
            <div class="actions"><button type="submit" class="btn primary" id="ev-save">Save event</button><button type="button" class="btn" id="ev-cancel">Cancel</button><button type="button" class="btn danger" id="ev-delete" hidden>Delete this event</button></div>
            <p id="ev-error" class="error" role="alert"></p>
          </form>
        </div>
      </details>
      <details class="folder" data-folder="videos">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="15" height="14" rx="2"/><path d="m22 8-5 4 5 4V8z"/></svg></span><span class="ft"><b>Page videos</b><span>The moving picture at the top of each page</span></span><span class="badge" id="b-videos">…</span></summary>
        <div id="hv-box">
          <p id="hv-msg" class="result" role="status" aria-live="polite">Loading…</p>
          <ul class="rows" id="hv-list"></ul>
          <form id="hv-form" class="evform" hidden>
            <h3 id="hv-form-title">Video</h3>
            <label for="hv-file">Pick a video <span class="hint">(from your camera roll; sideways videos fill the header best)</span></label>
            <input id="hv-file" type="file" accept="video/*" />
            <video id="hv-prev" muted playsinline preload="metadata" hidden></video>
            <div id="hv-trim" hidden>
              <label for="hv-start">Where the loop starts: <span id="hv-start-t">0:00</span></label>
              <input id="hv-start" type="range" min="0" max="0" step="0.1" value="0" />
              <label for="hv-len">How long the loop is</label>
              <select id="hv-len"><option value="8">8 seconds</option><option value="12">12 seconds</option><option value="15" selected>15 seconds</option><option value="20">20 seconds</option></select>
              <p class="result">It plays with no sound, over and over. This phone makes it small first (a phone size and a computer size), so it loads fast for visitors.</p>
            </div>
            <div id="hv-framing" hidden>
              <h4>Position in the header</h4>
              <p class="result">The header crops the video to fit phones and computers. It is placed on the action by itself; move it if you like. The boxes show the header on a phone and on a computer. You can change this later without uploading again.</p>
              <div class="actions"><button type="button" class="btn small" id="hv-auto">Find the action</button></div>
              <p id="hv-auto-t" class="result" role="status" aria-live="polite"></p>
              <div class="hv-boxes">
                <figure><div class="hv-box" id="hv-box-phone"><video muted playsinline loop preload="auto" aria-hidden="true"></video></div><figcaption>Phone</figcaption></figure>
                <figure><div class="hv-box" id="hv-box-desk"><video muted playsinline loop preload="auto" aria-hidden="true"></video></div><figcaption>Computer</figcaption></figure>
              </div>
              <label for="hv-y">Up / down <span class="hint" id="hv-y-t">middle</span></label>
              <input id="hv-y" type="range" min="0" max="100" step="1" value="50" />
              <label for="hv-x">Left / right <span class="hint" id="hv-x-t">middle</span></label>
              <input id="hv-x" type="range" min="0" max="100" step="1" value="50" />
              <label for="hv-z">Zoom <span class="hint" id="hv-z-t">fills the header</span></label>
              <input id="hv-z" type="range" min="1" max="2.5" step="0.05" value="1" />
              <div class="actions"><button type="button" class="btn small" id="hv-center">Back to the middle</button></div>
            </div>
            <p id="hv-progress" class="result" role="status" aria-live="polite"></p>
            <p id="hv-error" class="error" role="alert"></p>
            <div class="actions"><button type="submit" class="btn primary" id="hv-save" disabled>Make and upload</button><button type="button" class="btn" id="hv-cancel">Cancel</button></div>
          </form>
        </div>
      </details>
      <details class="folder" data-folder="push">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></span><span class="ft"><b>Phone notifications</b><span>Send a notification to everyone who turned them on</span></span><span class="badge" id="b-push">…</span></summary>
        <div id="push-box">
          <p id="push-msg" class="result" role="status" aria-live="polite">Loading…</p>
          <p id="push-done" class="result" role="status" aria-live="polite"></p>
          <div id="push-auto" class="evform" hidden>
            <h3>Automatic</h3>
            <p class="result">Visitors are told by themselves. They go out between 9 AM and 9 PM Central and count toward the 3-a-day limit; several things at once become one notification. Switching one on never announces anything that already exists.</p>
            <label class="check"><input type="checkbox" data-auto="events" /> New events (when you add one here that is dated today or later)</label>
            <label class="check"><input type="checkbox" data-auto="videos" /> New YouTube videos (the Interview and Music Video playlists)</label>
            <label class="check"><input type="checkbox" data-auto="services" /> New services (added to your NuServices sheet)</label>
            <label class="check"><input type="checkbox" data-auto="gallery" /> New gallery photos (added to NuGallery in Google Drive)</label>
            <label class="check"><input type="checkbox" data-auto="cinema" /> New NuCinema films, shows and episodes</label>
            <p id="push-auto-st" class="result" role="status" aria-live="polite"></p>
          </div>
          <form id="push-form" class="evform" hidden>
            <label for="push-title">Title <span class="hint">(shows in bold)</span></label><input id="push-title" type="text" maxlength="60" autocomplete="off" placeholder="New episode of Certified Lounge" required />
            <label for="push-body">Message <span class="hint">(optional)</span></label><input id="push-body" type="text" maxlength="140" autocomplete="off" />
            <label for="push-url">Where a tap goes</label>
            <select id="push-url"><option value="/">Home</option><option value="/events">Events</option><option value="/cinema">Cinema</option><option value="/gallery">Gallery</option><option value="/services">Services</option></select>
            <p id="push-preview" class="result"></p>
            <div class="actions"><button type="submit" class="btn primary" id="push-send">Send</button></div>
            <p id="push-error" class="error" role="alert"></p>
          </form>
          <ul class="rows" id="push-last"></ul>
        </div>
      </details>
      </section>
      <section class="grp g-people">
        <h2>Visitors &amp; activity</h2>
      <details class="folder" data-folder="clients">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="ft"><b>Clients &amp; projects</b><span>Status, total, paid and balance; clients see theirs at /account</span></span><span class="badge" id="b-clients">…</span></summary>
        <div id="cl-box">
          <p id="cl-msg" class="result" role="status" aria-live="polite"></p>
          <ul class="rows" id="cl-list"></ul>
          <div class="actions"><button type="button" class="btn primary" id="cl-add">Add a project</button></div>
          <form id="cl-form" class="evform" hidden>
            <h3 id="cl-form-title">New project</h3>
            <label for="cl-email">Client's e-mail <span class="hint">(their account finds the project by this address)</span></label><input id="cl-email" type="text" inputmode="email" maxlength="200" autocomplete="off" required />
            <label for="cl-name">Client's name <span class="hint">(optional, only you see it)</span></label><input id="cl-name" type="text" maxlength="120" autocomplete="off" />
            <label for="cl-title">Project</label><input id="cl-title" type="text" maxlength="120" autocomplete="off" required />
            <label for="cl-service">Service <span class="hint">(optional, for example Music video)</span></label><input id="cl-service" type="text" maxlength="120" autocomplete="off" />
            <label for="cl-status">Status</label>
            <select id="cl-status"><option value="requested">Quote requested</option><option value="quote">Quote sent</option><option value="booked" selected>Booked</option><option value="in-progress">In progress</option><option value="review">Ready for review</option><option value="done">Done</option><option value="paused">Paused</option><option value="cancelled">Cancelled</option></select>
            <label for="cl-total">Total in dollars</label><input id="cl-total" type="text" inputmode="decimal" maxlength="14" autocomplete="off" required />
            <label for="cl-due">Due date <span class="hint">(optional)</span></label><input id="cl-due" type="date" />
            <label for="cl-note">Note for the client <span class="hint">(optional, they see it)</span></label><textarea id="cl-note" rows="3" maxlength="2000"></textarea>
            <label for="cl-link">Files link <span class="hint">(optional, starts with https://, they see it)</span></label><input id="cl-link" type="url" maxlength="500" autocomplete="off" />
            <p id="cl-error" class="error" role="alert"></p>
            <div class="actions"><button type="submit" class="btn primary" id="cl-save">Save project</button><button type="button" class="btn" id="cl-cancel">Cancel</button><button type="button" class="btn danger" id="cl-delete" hidden>Delete project</button></div>
          </form>
          <form id="cp-form" class="evform" hidden>
            <h3 id="cp-title">Add a payment</h3>
            <label for="cp-amount">Amount in dollars</label><input id="cp-amount" type="text" inputmode="decimal" maxlength="14" autocomplete="off" required />
            <label for="cp-method">How they paid</label>
            <select id="cp-method"><option value="stripe">Card (Stripe)</option><option value="apple-pay">Apple Pay</option><option value="paypal">PayPal</option><option value="cash-app">Cash App</option><option value="venmo">Venmo</option><option value="zelle">Zelle</option><option value="cash">Cash</option><option value="check">Check</option><option value="other">Other</option></select>
            <label for="cp-day">Date paid</label><input id="cp-day" type="date" required />
            <label for="cp-note">Note <span class="hint">(optional, the client sees it)</span></label><input id="cp-note" type="text" maxlength="200" autocomplete="off" />
            <p id="cp-error" class="error" role="alert"></p>
            <div class="actions"><button type="submit" class="btn primary">Save payment</button><button type="button" class="btn" id="cp-cancel">Cancel</button></div>
          </form>
        </div>
      </details>
      <details class="folder" data-folder="analytics">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg></span><span class="ft"><b>Website analytics</b><span>Visitors, pages, where people come from</span></span><span class="badge" id="b-analytics">…</span></summary>
        <div id="an-box">
          <div class="actions"><label for="an-days" class="inline">Show</label>
            <select id="an-days"><option value="7">the last 7 days</option><option value="30" selected>the last 30 days</option><option value="90">the last 90 days</option></select></div>
          <div id="an-out" aria-live="polite"><p class="result">Loading…</p></div>
        </div>
      </details>
      <details class="folder" data-folder="send">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg></span><span class="ft"><b>What visitors send</b><span>Survey, recap e-mail, payments, services</span></span><span class="badge" id="b-send">…</span></summary>
        <ul class="rows" data-group="send"></ul>
      </details>
      </section>
      <section class="grp g-health">
        <h2>Health &amp; data</h2>
      <details class="folder" data-folder="feeds" open>
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg></span><span class="ft"><b>What visitors see</b><span>Gallery, cinema, services, latest videos</span></span><span class="badge" id="b-feeds">…</span></summary>
        <ul class="rows" data-group="feeds"></ul>
      </details>
      <details class="folder" data-folder="keep">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></svg></span><span class="ft"><b>Backups</b><span>Nightly copy of your Google Sheets</span></span><span class="badge" id="b-keep">…</span></summary>
        <ul class="rows" data-group="keep"></ul>
        <div class="actions">
          <button type="button" class="btn" id="backup-now">Back up now</button>
          <p id="backup-result" class="result" role="status" aria-live="polite"></p>
        </div>
      </details>
      <details class="folder" data-folder="setup">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span class="ft"><b>Setup checklist</b><span>Which secrets and connections exist (yes or no, never the value)</span></span><span class="badge" id="b-setup">…</span></summary>
        <div id="setup-list"></div>
      </details>
      </section>
      <section class="grp g-acc">
        <h2>Account</h2>
      <details class="folder" data-folder="account">
        <summary><span class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><span class="ft"><b>Account</b><span>Sign out, refresh this device</span></span></summary>
        <div class="actions stack">
          <p class="result" id="ver-line">Version: checking…</p>
          <a class="btn" href="/whats-new">What's new (version history)</a>
          <button type="button" class="btn" data-refresh>Refresh the app</button>
          <button type="button" class="btn quiet" id="sign-out">Sign out on this device</button>
        </div>
      </details>
      </section>
      <p class="foot-note" id="foot-note">&nbsp;</p>
    </section>
  </article>
</Site>

<script>
  import { applyFrame } from '../lib/heroVideo';
  type Tone = 'ok' | 'old' | 'todo' | 'bad';
  type Result = { tone: Tone; text: string; note?: string };
  const KEY = 'nrn_admin', OPEN = 'nrn_admin_open';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const count = (a: unknown) => (Array.isArray(a) ? a.length : 0);
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const when = (iso: string) => new Date(iso).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const store = {
    get: () => { try { return localStorage.getItem(KEY) || ''; } catch { return ''; } },
    set: (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* private window */ } },
    clear: () => { try { localStorage.removeItem(KEY); } catch { /* ignore */ } },
  };

  // A write endpoint says which backend answers: "sheet" or "edge" = the site itself, "apps-script" = the old fallback.
  const mode = (what: string) => (j: any): Result => {
    if (j && (j.mode === 'sheet' || j.mode === 'edge')) return { tone: 'ok', text: 'New: the site handles this itself', note: what };
    if (j && j.mode === 'apps-script') return { tone: 'old', text: 'Old fallback: the previous Google script still handles this', note: 'Needs its Cloudflare secret(s) to switch over' };
    return { tone: 'bad', text: 'Unexpected answer', note: 'The endpoint answered, but not in the usual shape' };
  };
  const ROWS: { group: string; name: string; url: string; read: (j: any) => Result }[] = [
    { group: 'feeds', name: 'Gallery', url: '/api/feed/gallery', read: (j) => (j && j.source === 'drive' ? { tone: 'ok', text: 'New: read straight from Google Drive', note: plural(count(j.categories), 'category', 'categories') } : j && count(j.categories) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No gallery came back' }) },
    { group: 'feeds', name: 'Cinema', url: '/api/feed/cinema', read: (j) => (j && j.source === 'sheet' ? { tone: 'ok', text: 'New: read straight from the NuCinema sheet', note: plural(count(j.films), 'film', 'films') } : j && count(j.films) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No films came back' }) },
    { group: 'feeds', name: 'Services', url: '/api/feed/services', read: (j) => (j && j.source === 'sheet' ? { tone: 'ok', text: 'New: read straight from the NuServices sheet', note: plural(count(j.services), 'service', 'services') } : j && count(j.services) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No services came back' }) },
    { group: 'feeds', name: 'Latest videos', url: '/api/feed/latest', read: (j) => (j && j.ok ? { tone: 'ok', text: 'Answering', note: j.music && j.music.publishedAt ? `Newest music video: ${when(j.music.publishedAt)}` : undefined } : { tone: 'bad', text: 'No videos came back' }) },
    { group: 'send', name: 'Accounts', url: '/api/account/me', read: (j) => (j && j.on ? { tone: 'ok', text: 'On: people can sign in at /account', note: [j.google ? 'Google' : '', j.email ? 'e-mail link' : ''].filter(Boolean).join(' and ') || 'No sign-in way is set up yet' } : { tone: 'todo', text: 'Not switched on yet', note: 'See docs/accounts-setup.md' }) },
    { group: 'send', name: 'Stripe payments', url: '/api/stripe-webhook', read: (j) => (j && j.mode === 'ready' ? { tone: 'ok', text: 'On: card and Apple Pay payments show in people\'s accounts' } : { tone: 'todo', text: 'Not switched on yet', note: 'See docs/accounts-setup.md (Stripe)' }) },
