    bars.setAttribute('aria-label', `Page views per day, ${a.daily[0].day} to ${a.daily[a.daily.length - 1].day}. Busiest day: ${max} views.`);
    for (const d of a.daily) { const i = document.createElement('i'); i.style.height = `${Math.max(2, Math.round((d.views / max) * 100))}%`; i.title = `${d.day}: ${d.views} views, ${d.visitors} visitors`; bars.appendChild(i); }
