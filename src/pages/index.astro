---
import Site from '../layouts/Site.astro';

const press = [
  {
    title: 'NuRenaissance – REDD & bluu',
    excerpt: 'Featuring impeccable bars, breathless in some cases, spoken-word style in others, the album manages to be artistically free yet focused.',
    source: 'Stereo Stickman · Rebecca Cullen',
    href: 'https://stereostickman.com/music/nurenaissance-redd-bluu/',
    img: '/img/press-redd-bluu.webp',
  },
  {
    title: 'NuRenaissance – REDD & bluu',
    excerpt: 'Most artists strive to tell a story with their work, but the collective that is NuRenaissance has taken it to the next level with their latest release.',
    source: 'The Ark of Music',
    href: 'https://thearkofmusic.com/nurenaissance-redd-bluu/',
    img: '/img/press-redd-bluu.webp',
  },
  {
    title: 'Decide to go with REDD or bluu in the NuRenaissance',
    excerpt: 'For their new project REDD & bluu, the beliefs and thoughts of NuRenaissance are laid out there for all to take in within the music.',
    source: 'Indie Band Guru · Keith Pro · Aug 4, 2020',
    href: 'https://indiebandguru.com/nurenaissance-redd-bluu/',
    img: '/img/press-redd-bluu.webp',
  },
  {
    title: "PHOTOS: NuRenaissance Media's Certified Lounge Podcast",
    excerpt: 'Inspired performances and insightful, forward-thinking conversations are on their way to you!',
    source: 'Underground Music Collective · Gerard Longo',
    href: 'https://umcworldwide.com/author/gerardlongo/',
    img: '/img/press-umc.webp',
  },
];
---
<Site
  title="NuRenaissance | Independent media company in Nashville"
  description="An independent media company providing video, photo, livestream, and artist services in Nashville, Tennessee."
>
  <section class="hero">
    <img class="hero-bg" src="/img/home-hero.webp" srcset="/img/home-hero-640.webp 640w, /img/home-hero.webp 1280w" sizes="100vw" alt="" width="1280" height="720" fetchpriority="high" />
    <div class="hero-inner">
      <img class="hero-mascot" src="/img/mascot.webp" alt="" width="132" height="132" />
      <h1 class="wordmark">NuRenaissance</h1>
      <p class="tagline">An independent media company providing video, photo, livestream, and artist services.</p>
      <div class="actions">
        <a class="btn" href="/gallery"><span class="btn-label">Gallery</span><span class="btn-sub">Photos from events and interviews</span></a>
        <a class="btn btn-main" href="/services">
          <img src="/img/mascot.webp" alt="" width="40" height="40" />
          <span class="btn-label">Work with us</span>
        </a>
        <a class="btn" href="/cinema"><span class="btn-label">NuCinema</span><span class="btn-sub">Watch shows and movies</span></a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="community-h">
    <h2 id="community-h" class="band-title">Community</h2>
    <div class="community">
      <a class="community-card" href="/certified">
        <img src="/img/renaissance-certified.webp" alt="" width="181" height="161" />
        <span class="cc-name">Renaissance Certified</span>
        <span class="cc-sub">Nashville showcases, exclusives and the Certified Lounge</span>
      </a>
      <a class="community-card" href="/directory">
        <img src="/img/nudirectory.webp" alt="" width="129" height="129" />
        <span class="cc-name">NuDirectory</span>
        <span class="cc-sub">The Nashville hip-hop, R&amp;B and soul scene board</span>
      </a>
    </div>
  </section>

  <section class="band" aria-labelledby="press-h">
    <h2 id="press-h" class="band-title">Press</h2>
    <ul class="press">
      {press.map((p) => (
        <li>
          <a class="press-card" href={p.href} target="_blank" rel="noopener">
            <img src={p.img} alt="" width="320" height="160" loading="lazy" />
            <span class="press-body">
              <span class="press-title">{p.title}</span>
              <span class="press-excerpt">{p.excerpt}</span>
              <span class="press-source">{p.source} <span aria-hidden="true">↗</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Site>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(74svh, 680px);
    padding-bottom: var(--space-5);
    display: grid;
    place-items: center;
    padding: var(--space-6) var(--space-4);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover;
  }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(14, 11, 22, 0.55) 0%, rgba(31, 15, 69, 0.55) 45%, #0e0b16 100%);
  }
  .hero-inner { width: 100%; min-width: 0; max-width: 760px; grid-template-columns: minmax(0, 1fr); text-align: center; display: grid; justify-items: center; gap: var(--space-3); }
  .hero-mascot { width: 96px; height: 96px; filter: drop-shadow(0 0 18px rgba(155, 93, 229, 0.6)); animation: float 5s ease-in-out infinite; }
  .wordmark {
    margin: 0;
    font-family: var(--font-poster);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(40px, 15vw, 128px);
    max-width: 100%;
    line-height: 0.9;
    letter-spacing: 0.01em;
    color: #fff;
    background: linear-gradient(180deg, #ffffff 30%, var(--gold-300) 70%, var(--gold-500));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.6));
  }
  .tagline {
    margin: 0; max-width: 36ch;
    font-size: clamp(16px, 4.2vw, 19px); line-height: 1.5;
    letter-spacing: 0.01em; color: #ece6f7;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
  }
  .actions {
    margin-top: var(--space-4);
    width: 100%;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3);
  }
  .btn {
    display: grid; align-content: center; justify-items: center; gap: 2px;
    min-height: 64px; padding: var(--space-3);
    border-radius: 14px; text-decoration: none;
    background: rgba(31, 15, 69, 0.82); border: 1.5px solid var(--gold-500);
    color: var(--gold-300);
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast);
  }
  .btn:hover { transform: translateY(-2px); background: rgba(58, 29, 122, 0.95); }
  .btn-label { font-family: var(--font-poster); font-weight: 800; font-size: clamp(19px, 5.5vw, 24px); text-transform: uppercase; letter-spacing: 0.03em; line-height: 1; }
  .btn-sub { font-size: 13px; line-height: 1.3; text-align: center; color: #d8cdf0; }
  .btn-main {
    grid-column: 1 / -1; order: -1;
    grid-auto-flow: column; gap: var(--space-3);
    background: var(--gold-300); color: var(--purple-900); border-color: var(--gold-300);
    min-height: 68px;
  }
  .btn-main:hover { background: #ffe08a; }
  .btn-main .btn-label { font-size: 28px; }
  .btn-main img { width: 40px; height: 40px; }
  @media (min-width: 720px) {
    .actions { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) minmax(0, 1fr); }
    .btn-main { grid-column: auto; order: 0; }
  }

  .band { max-width: 1040px; margin: 0 auto; padding: var(--space-6) var(--space-4); }
  .band-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-poster); font-weight: 800; text-transform: uppercase;
    font-size: clamp(28px, 7vw, 40px); letter-spacing: 0.04em; color: var(--pink-300);
  }

  .community { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .community-card {
    min-width: 0;
    display: grid; justify-items: center; align-content: start; gap: var(--space-2);
    padding: var(--space-5) var(--space-3); text-align: center; text-decoration: none;
    border-radius: var(--radius-md); background: #1a1526; border: 1px solid #2a2238; color: #f3f0fa;
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast);
  }
  .community-card:hover { transform: translateY(-3px); border-color: var(--gold-500); }
  .community-card img { width: auto; height: 110px; object-fit: contain; }
  .cc-name { font-family: var(--font-poster); font-weight: 800; font-size: clamp(17px, 5vw, 22px); overflow-wrap: anywhere; text-transform: uppercase; color: var(--gold-300); line-height: 1.05; }
  .cc-sub { font-size: 13px; line-height: 1.45; color: #a99fc6; }

  .press { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  @media (min-width: 720px) { .press { grid-template-columns: 1fr 1fr; } }
  .press-card {
    display: grid; grid-template-columns: 112px 1fr; gap: var(--space-3); align-items: start;
    padding: var(--space-3); border-radius: var(--radius-md); text-decoration: none;
    background: #f7f4ee; color: #1a1220;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .press-card:hover { transform: translateY(-2px); }
  .press-card img { width: 112px; height: 84px; object-fit: cover; border-radius: 8px; }
  .press-body { display: grid; gap: 4px; min-width: 0; }
  .press-title { font-weight: 600; font-size: 15px; line-height: 1.3; }
  .press-excerpt {
    font-size: 13px; line-height: 1.45; color: #4a3d52;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .press-source { font-size: 12px; color: #6b5d78; }

  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
</style>
