---
import Site from '../layouts/Site.astro';
import WidgetFrame from '../components/WidgetFrame.astro';
---
<Site
  title="Services | NuRenaissance"
  description="Video production, photography, livestream, graphic design, web design and artist admin in Nashville. Pick your services, see pricing and book a call."
>
  <h1 class="sr-only">NuRenaissance services and booking</h1>
  <!-- The widget caps itself at 95% of its window and scrolls inside; the frame
       follows its content up to the screen height. -->
  <WidgetFrame src="/widgets/services.html" title="Choose NuRenaissance services and book"
    fitTo="#nrn-select" fill={0.95} maxHeight={1100} maxWidth={520} transparent />
</Site>
