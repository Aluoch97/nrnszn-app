  .nrn-card .nrn-name { font-weight: 600; font-size: 16px; color: var(--purple-900); }
  .nrn-card .nrn-price { font-size: 16px; font-weight: 700; color: var(--purple-500); white-space: nowrap; }
  .nrn-card .nrn-icon { font-size: 28px; flex-shrink: 0; line-height: 1; }
  .nrn-card-desc { display: block; font-size: 15px; color: var(--ink-soft); line-height: 1.5; margin-top: 8px; }
  .nrn-badge {
    position: absolute; top: -12px; right: 12px;
    background: var(--gold-500); color: var(--purple-900);
    font-weight: 700; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 3px 10px; border-radius: var(--radius-pill);
  }
  .nrn-badge.nrn-suggest-badge { right: auto; left: 12px; background: var(--purple-500); color: var(--paper); }

  .nrn-config { display: block; margin-top: 14px; padding-top: 14px; border-top: 1.5px solid var(--nrn-line); cursor: default; }
  .nrn-config-row { display: block; margin-top: 12px; }
  .nrn-config-label { font-weight: 600; font-size: 15px; color: var(--purple-900); display: block; margin-bottom: 6px; }
  .nrn-tiers, .nrn-tiers-stack { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .nrn-tier, .nrn-toggle {
    width: 100%; max-width: 100%; text-align: left;
    font-size: 15px; padding: 10px 12px; min-height: 44px; cursor: pointer;
    border-radius: var(--radius-sm); border: 1.5px solid var(--nrn-line);
    background: var(--nrn-soft); color: var(--ink);
    transition: border-color var(--dur-fast), background var(--dur-fast);
  }
  .nrn-tier:hover, .nrn-toggle:hover { border-color: var(--purple-300); }
  .nrn-tier.active, .nrn-toggle.active {
    background: var(--purple-500); border-color: var(--purple-500); color: var(--paper); font-weight: 600;
  }
  .nrn-tier-sub { display: block; font-size: 0.85em; font-weight: 400; margin-top: 2px; opacity: 0.85; }
  .nrn-toggle-row { display: flex; flex-direction: column; gap: 8px; }
  .nrn-hours-input, .nrn-intake-field, .nrn-book-field, #nrn-estimate-email, #nrn-book-date-btn {
    width: 100%; padding: 12px; min-height: 44px;
    border-radius: var(--radius-sm); border: 1.5px solid var(--nrn-line);
    background: var(--paper); color: var(--ink);
    font-family: var(--font-body); font-size: 16px;
