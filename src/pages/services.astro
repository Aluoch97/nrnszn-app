            '<button type="button" class="nrn-toggle' + (cfg.rushDelivery ? ' active' : '') + '" data-service="' + s.id + '" data-field="rushDelivery" data-value="toggle" aria-pressed="' + !!cfg.rushDelivery + '">⚡ Rush delivery, 48hr (+$' + GRAPHIC_RUSH_FEE + ')</button>' +
          '</span></span>';
