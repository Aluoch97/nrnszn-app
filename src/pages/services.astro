---
import Base from '../layouts/Base.astro';
import { SERVICES_API_URL } from '../data/services.js';

// Ported from the Wix "Service Select Screen" embed. The pricing, booking
// and intake logic below is unchanged; only the styling and page layout
// were adapted to the app. Everything is rendered in the browser from the
// Services sheet, so prices update without a rebuild.
const SCRIPT_URL = SERVICES_API_URL;
---
<Base
  title="Services — NuRenaissance"
  description="Video production, photography, web design, livestream, graphic design and artist admin services in Nashville. Live pricing and booking."
>
  <main class="services-page">
    <a class="back" href="/portal">&larr; Portal</a>

    <noscript>
      <div class="nrn-noscript">
        <h2>NuRenaissance Media</h2>
        <p>Video production, photography, web design, livestream, graphic design, and artist admin services in Nashville. This page needs JavaScript enabled to show live pricing and booking. Reach out directly at nrnszn.com or via our social links to get a quote.</p>
      </div>
    </noscript>

    <div id="nrn-select">
      <img class="nrn-logo" src="/icons/logo.webp" alt="" width="96" height="96" />
      <h1 class="nrn-brand-name">Services</h1>
      <div class="nrn-form-sub">Pick what you need below. Prices update as you go.</div>

      <div id="nrn-viewport">
        <div id="nrn-page-services" class="nrn-page">
          <button id="nrn-help-toggle" class="nrn-link-btn" type="button">&#10067; Not sure what you need?</button>
          <div id="nrn-quiz" hidden aria-live="polite"></div>

          <h4 class="nrn-step-label">&#127919; 01 · Choose services</h4>
          <div class="nrn-help-text">Tap a service to select it. You can pick more than one — tap it again to remove it.</div>
          <div id="nrn-grid">
            <div class="nrn-loading">Loading services&hellip;</div>
          </div>
          <div id="nrn-bundle" aria-live="polite"></div>
          <div id="nrn-loadout" aria-live="polite"></div>
        </div>

        <div id="nrn-page-about" class="nrn-page" hidden>
          <div id="nrn-intake" aria-live="polite"></div>
        </div>

        <div id="nrn-page-actions" class="nrn-page" hidden>
          <div id="nrn-actions" aria-live="polite"></div>
        </div>

        <div id="nrn-page-flow" class="nrn-page" hidden>
          <div id="nrn-booking" aria-live="polite"></div>
          <div id="nrn-estimate" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ SCRIPT_URL }}>
(function () {
  var STORAGE_KEY = 'nrn_service_selection_v4'; // bumped when the video edit tiers changed: saved selections store tier positions, which shifted
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  // User-typed text (name, phone, free-text notes, etc.) gets re-inserted
  // into innerHTML when a form re-renders. Escape it so a stray quote or
  // "</textarea>" in someone's input can't break the markup or inject content.
  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // POST with a JSON body instead of GET query params, so name/email/
  // phone/notes don't end up in browser history or request logs.
  // Content-Type is text/plain on purpose: Apps Script can't answer a CORS
  // preflight, and application/json would trigger one.
  function postAction(payload) {
    return fetch(SCRIPT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    });
  }

  var PAGE_IDS = ['nrn-page-services', 'nrn-page-about', 'nrn-page-actions', 'nrn-page-flow'];
  function showPage(activeId) {
    PAGE_IDS.forEach(function (id) {
      document.getElementById(id).hidden = (id !== activeId);
    });
    // Full page now (not a fixed-height Wix embed), so scroll the window.
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  var services = [];
  var bundles = [];
  var selected = {}; // { serviceId: config }
  var suggestedId = null;
  var chosenSlot = null;
  var leadName = '';
  var leadEmail = '';
  var leadPhone = '';
  var leadLocation = '';
  var leadDetails = '';
  var leadRole = null;
  var leadSubmitted = false;

  loadStoredSelection();

  fetch(SCRIPT_URL + '?action=data')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      services = data.services || [];
      bundles = data.bundles || [];
      try {
        pruneStaleSelections();
        renderGrid();
        renderLoadout();
        renderBundleSuggestion();
      } catch (renderErr) {
        // Data loaded fine but a saved selection broke rendering. Wipe the
        // bad state and retry once with a clean slate.
        console.error('NuRenaissance service select render failed, resetting selection', renderErr);
        selected = {};
        saveSelection();
        renderGrid();
        renderLoadout();
        renderBundleSuggestion();
      }
    })
    .catch(function (err) {
      console.error('NuRenaissance service select load failed', err);
      document.getElementById('nrn-grid').innerHTML =
        '<div class="nrn-load-error">Couldn’t load services right now. Refresh the page to try again.</div>';
    });

  function loadStoredSelection() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (raw) selected = JSON.parse(raw) || {};
    } catch (err) { selected = {}; }
  }

  function saveSelection() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(selected)); } catch (err) {}
  }

  function pruneStaleSelections() {
    Object.keys(selected).forEach(function (id) {
      var s = services.find(function (x) { return x.id === id; });
      if (!s) { delete selected[id]; return; }
      // A saved selection from an older version can have a different shape
      // than the current pricing model expects. Reset rather than crash.
      if (!isValidConfigShape(s, selected[id])) {
        selected[id] = defaultConfig(s);
      }
    });
  }

  function isValidConfigShape(s, cfg) {
    if (!cfg || typeof cfg !== 'object') return false;
    if (s.pricingModel === 'package') return Array.isArray(cfg.tierIndices) && cfg.tierIndices.length > 0;
    if (s.pricingModel === 'hourly') return typeof cfg.hours === 'number';
    if (s.pricingModel === 'hourly_plus_edit') return typeof cfg.hours === 'number' && typeof cfg.tierIndex === 'number';
    if (s.pricingModel === 'per_page') return typeof cfg.pages === 'number';
    return true;
  }

  // Add-on pricing straight from the signed service agreements — not
  // tracked in the Sheet, hardcoded here. Update these if a contract's
  // terms change.
  var REVISION_FEE = { video: 75, web: 50, 'graphic-design': 50 };
  var VIDEO_LOCATION_FEE = 50;          // per additional location beyond the primary
  var VIDEO_WHITE_LABEL_PCT = 0.25;     // 25% of production+edit to remove branding
  var GRAPHIC_RUSH_FEE = 40;            // 48-hour rush delivery for Graphic design
  // Photography rates are hardcoded here (like STANDARD_DEPOSIT) so an old
  // value left in the Sheet can never override them.
  var PHOTO_ON_LOCATION_RATE = 100;     // per hour
  var PHOTO_STUDIO_RATE = 150;          // per hour
  var PHOTO_RUSH_FEE = 75;              // 48-hour turnaround on photos
  // Standard deposit across every session/booking-based service — Video
  // (including music videos), Photography, Livestream, Web design, and
  // Interview. Graphic Design has no deposit (full fee upfront) and Admin's
  // package tiers define their own payment terms.
  var STANDARD_DEPOSIT = 50;
  var PHOTO_EXTRA_PHOTO_SINGLE = 10;
  var PHOTO_EXTRA_PHOTO_BUNDLE_SIZE = 5;
  var PHOTO_EXTRA_PHOTO_BUNDLE_PRICE = 40;
  var INTERVIEW_TALENT_FEE = 75;
  var INTERVIEW_FACILITY_FEE = 60;
  var INTERVIEW_LOCATION_FEE = 50;
  var INTERVIEW_REVISION_FEE = 75;
  // Video shoot pricing (every video type except Raise the Bar): $500 covers
  // the first 2 hours, then $100 for each additional hour. Edit is added on
  // top. Hardcoded so the old per-hour rates in the Sheet can't override it.
  var VIDEO_BASE_SHOOT = 500;
  var VIDEO_BASE_HOURS = 2;
  var VIDEO_EXTRA_HOUR_RATE = 100;
  var RAISE_THE_BAR_PRICE = 100;   // one mic performance series
  var RAISE_THE_BAR_DEPOSIT = 50;  // $50 to book, remaining $50 due at the shoot
  var PHOTOGRAPHY_EXAMPLE_URL = 'https://www.nrnszn.com/gallery';
  var VIDEO_TYPE_EXAMPLES = {
    music: 'https://www.youtube.com/playlist?list=PLVprhlbgSo1sfS02MFZbi3t7pCJkoy9rd',
    interview: 'https://www.youtube.com/playlist?list=PLVprhlbgSo1vN-wkuvFDjabBQ85XURyTd',
    podcast: 'https://www.youtube.com/@nrnszn/podcasts',
    recap: 'https://www.youtube.com/playlist?list=PLVprhlbgSo1s5YSOxWfYGTLEDvkKjCboz',
    raisethebar: 'https://youtube.com/playlist?list=PLC2-QbyYIV7c&si=Yy9vhWvvACvWjzjZ'
    // promo intentionally has none — no link given for it
  };
  function renderVideoExampleLink(videoType) {
    var url = VIDEO_TYPE_EXAMPLES[videoType];
    if (!url) return '';
    return '<span class="nrn-help-text" style="margin:0 0 8px;"><a class="nrn-inline-link" href="' + url + '" target="_blank" rel="noopener noreferrer">🎥 See examples</a></span>';
  }
  var ADMIN_DIGITAL_FOUNDATION_REVISION_FEE = 25;

  // Bulk-photo pricing: bundles of 5 at $40, remainder at $10 each.
  function extraPhotoCost(n) {
    n = Math.max(0, n || 0);
    var bundles = Math.floor(n / PHOTO_EXTRA_PHOTO_BUNDLE_SIZE);
    var remainder = n % PHOTO_EXTRA_PHOTO_BUNDLE_SIZE;
    return bundles * PHOTO_EXTRA_PHOTO_BUNDLE_PRICE + remainder * PHOTO_EXTRA_PHOTO_SINGLE;
  }

  var VIDEO_TYPES = [
    { value: 'music', label: '🎵 Music video' },
    { value: 'podcast', label: '🎙️ Podcast' },
    { value: 'recap', label: '📅 Event recap' },
    { value: 'promo', label: '📣 Promo' },
    { value: 'interview', label: '🎙 Interview' },
    { value: 'raisethebar', label: '🎤 Raise the Bar' }
  ];

  // Edit-length pricing for EVERY video type, Interview included. Hardcoded
  // so old tier rows left in the Sheet can't override it.
  var VIDEO_EDIT_TIERS = [
    { name: 'Up to 5 min', price: 300 },
    { name: 'Over 5 min', price: 600 }
  ];

  // Shoot cost = $500 base (first 2 hours) + $100 per extra hour.
  function videoShootCost(hours, breakdown) {
    var extra = Math.max(0, hours - VIDEO_BASE_HOURS);
    var extraCost = Math.round(extra * VIDEO_EXTRA_HOUR_RATE * 100) / 100;
    breakdown.push('🎬 Shoot, first ' + VIDEO_BASE_HOURS + ' hrs: $' + VIDEO_BASE_SHOOT);
    if (extra > 0) breakdown.push('🕒 ' + extra + ' extra hr(s) @ $' + VIDEO_EXTRA_HOUR_RATE + '/hr: $' + extraCost);
    return VIDEO_BASE_SHOOT + extraCost;
  }

  function photoFacilityRate(s) {
    return PHOTO_STUDIO_RATE;
  }

  // The "starting at" teaser comes from the Sheet via Code.gs, which still
  // reflects old photography/video rates, so those two are computed here.
  function displayStartingPrice(s) {
    if (s.id === 'photography') return PHOTO_ON_LOCATION_RATE * s.minHours + STANDARD_DEPOSIT;
    if (s.id === 'video') {
      var cheapest = Infinity;
      VIDEO_TYPES.forEach(function (v) {
        if (v.value === 'raisethebar') return;
        var cfg = defaultConfig(s);
        cfg.videoType = v.value; cfg.tierIndex = 0; cfg.interviewTier = 0; cfg.studio = 'standard';
        cheapest = Math.min(cheapest, computePrice(s, cfg).total);
      });
      return cheapest;
    }
    return s.startingPrice;
  }

  function defaultConfig(s) {
    if (s.pricingModel === 'package') return { tierIndices: [0], consultHours: 1, dfRevisions: 0, revisions: 0, rushDelivery: false };
    if (s.pricingModel === 'hourly') {
      if (s.id === 'photography') return { hours: s.minHours, studio: 'standard', extraPhotos: 0, rushDelivery: false };
      return { hours: s.minHours };
    }
    if (s.pricingModel === 'hourly_plus_edit') return { hours: VIDEO_BASE_HOURS, studio: 'standard', videoType: 'promo', tierIndex: 0, interviewTier: 0, revisions: 0, extraLocations: 0, whiteLabel: false, talent: false, facility: false, interviewRevisions: 0, interviewLocations: 0 };
    if (s.pricingModel === 'per_page') return { pages: 1, revisions: 0 };
    return {};
  }

  // ---------------- Pricing ----------------

  function computePrice(s, cfg) {
    if (s.pricingModel === 'package') {
      var indices = (cfg.tierIndices && cfg.tierIndices.length) ? cfg.tierIndices : [0];
      var total = 0, depositSum = 0, allCredited = true, breakdown = [], labels = [];
      indices.forEach(function (i) {
        var t = s.tiers[i];
        if (!t) return;
        // Creative Consultation is billed per hour, not flat, despite
        // living in the same flat-tier list as everything else.
        var isHourlyTier = t.name === 'Creative consultation';
        var hours = cfg.consultHours || 1;
        var linePrice = isHourlyTier ? t.price * hours : t.price;
        total += linePrice + t.deposit;
        depositSum += t.deposit;
        if (t.deposit > 0 && !t.depositCredited) allCredited = false;
        breakdown.push('🎯 ' + t.name + (isHourlyTier ? ' (' + hours + ' hrs @ $' + t.price + '/hr)' : '') + ': $' + linePrice);
        labels.push(t.name);

        // Digital Foundation extra revisions ($25/round beyond the 2 free).
        if (t.name === 'Digital Foundation' && cfg.dfRevisions > 0) {
          var dfFee = cfg.dfRevisions * ADMIN_DIGITAL_FOUNDATION_REVISION_FEE;
          total += dfFee;
          breakdown.push('🔁 ' + cfg.dfRevisions + ' extra revision round(s): $' + dfFee);
        }
      });

      // Graphic Design: extra revisions beyond the 2 free, once per order.
      if (s.id === 'graphic-design' && cfg.revisions > 0) {
        var gdFee = cfg.revisions * REVISION_FEE['graphic-design'];
        total += gdFee;
        breakdown.push('🔁 ' + cfg.revisions + ' extra revision round(s): $' + gdFee);
      }
      if (s.id === 'graphic-design' && cfg.rushDelivery) {
        total += GRAPHIC_RUSH_FEE;
        breakdown.push('⚡ Rush delivery (48hr): $' + GRAPHIC_RUSH_FEE);
      }

      if (depositSum > 0) breakdown.push('💳 Deposit: $' + depositSum);
      return {
        total: total,
        deposit: depositSum,
        depositCredited: allCredited,
        breakdown: breakdown,
        label: labels.join(' + ')
      };
    }
    if (s.pricingModel === 'hourly') {
      var rate = s.id === 'photography' ? (cfg.studio === 'facility' ? PHOTO_STUDIO_RATE : PHOTO_ON_LOCATION_RATE) : s.hourlyRate;
      var prod = rate * cfg.hours;
      var whereLabel = (s.id === 'photography' && cfg.studio === 'facility') ? ' (in-studio)' : (s.id === 'photography' ? ' (on-location)' : '');
      var hTotal = prod;
      var hBreakdown = ['🕒 ' + cfg.hours + ' hrs @ $' + rate + '/hr' + whereLabel + ': $' + prod];
      if (s.id === 'photography') {
        if (cfg.extraPhotos > 0) {
          var photoFee = extraPhotoCost(cfg.extraPhotos);
          hTotal += photoFee;
          hBreakdown.push('🖼️ ' + cfg.extraPhotos + ' extra edited photo(s): $' + photoFee);
        }
        if (cfg.rushDelivery) {
          hTotal += PHOTO_RUSH_FEE;
          hBreakdown.push('⚡ Rush delivery (48hr): $' + PHOTO_RUSH_FEE);
        }
      }
      hTotal += STANDARD_DEPOSIT;
      hBreakdown.push('💳 Deposit: $' + STANDARD_DEPOSIT);
      return {
        total: hTotal,
        deposit: STANDARD_DEPOSIT,
        depositCredited: true,
        breakdown: hBreakdown,
        label: cfg.hours + ' hrs'
      };
    }
    if (s.pricingModel === 'hourly_plus_edit') {
      if (cfg.videoType === 'interview') {
        var it = VIDEO_EDIT_TIERS[cfg.interviewTier || 0] || VIDEO_EDIT_TIERS[0];
        var itBreakdown = ['🎙 Interview shoot: $' + VIDEO_BASE_SHOOT, '✂️ Edit, ' + it.name + ': $' + it.price];
        var itTotal = VIDEO_BASE_SHOOT + it.price;
        if (cfg.talent) { itTotal += INTERVIEW_TALENT_FEE; itBreakdown.push('🎤 On-screen talent: $' + INTERVIEW_TALENT_FEE); }
        if (cfg.facility) { itTotal += INTERVIEW_FACILITY_FEE; itBreakdown.push('🏠 Production facility: $' + INTERVIEW_FACILITY_FEE); }
        if (cfg.interviewLocations > 0) {
          var itLocFee = cfg.interviewLocations * INTERVIEW_LOCATION_FEE;
          itTotal += itLocFee;
          itBreakdown.push('📍 ' + cfg.interviewLocations + ' extra location(s): $' + itLocFee);
        }
        if (cfg.interviewRevisions > 0) {
          var itRevFee = cfg.interviewRevisions * INTERVIEW_REVISION_FEE;
          itTotal += itRevFee;
          itBreakdown.push('🔁 ' + cfg.interviewRevisions + ' extra revision round(s): $' + itRevFee);
        }
        itTotal += STANDARD_DEPOSIT;
        itBreakdown.push('💳 Deposit: $' + STANDARD_DEPOSIT);
        return { total: itTotal, deposit: STANDARD_DEPOSIT, depositCredited: true, breakdown: itBreakdown, label: 'Interview: ' + it.name };
      }
      if (cfg.videoType === 'raisethebar') {
        return {
          total: RAISE_THE_BAR_PRICE,
          deposit: RAISE_THE_BAR_DEPOSIT,
          depositCredited: true,
          breakdown: ['🎤 Raise the Bar performance: $' + RAISE_THE_BAR_PRICE, '💳 Deposit: $' + RAISE_THE_BAR_DEPOSIT],
          label: 'Raise the Bar'
        };
      }
      var editTier = VIDEO_EDIT_TIERS[cfg.tierIndex] || VIDEO_EDIT_TIERS[0];
      var deposit = STANDARD_DEPOSIT;
      var depositCredited = true;
      var videoTypeLabel = (VIDEO_TYPES.find(function (v) { return v.value === cfg.videoType; }) || VIDEO_TYPES[3]).label;
      var vBreakdown = [videoTypeLabel];
      var shootCost = videoShootCost(cfg.hours, vBreakdown);
      var vTotal = shootCost + editTier.price;
      vBreakdown.push('✂️ Edit, ' + editTier.name + ': $' + editTier.price);
      if (cfg.extraLocations > 0) {
        var vLocFee = cfg.extraLocations * VIDEO_LOCATION_FEE;
        vTotal += vLocFee;
        vBreakdown.push('📍 ' + cfg.extraLocations + ' extra location(s): $' + vLocFee + ' (+$5/mi beyond 25mi, billed separately)');
      }
      if (cfg.revisions > 0) {
        var vRevFee = cfg.revisions * REVISION_FEE.video;
        vTotal += vRevFee;
        vBreakdown.push('🔁 ' + cfg.revisions + ' extra revision round(s): $' + vRevFee);
      }
      if (cfg.whiteLabel) {
        var wlFee = Math.round((shootCost + editTier.price) * VIDEO_WHITE_LABEL_PCT);
        vTotal += wlFee;
        vBreakdown.push('🏷️ White-label (remove branding): $' + wlFee);
      }
      vTotal += deposit;
      vBreakdown.push('💳 Deposit: $' + deposit);
      return {
        total: vTotal,
        deposit: deposit,
        depositCredited: depositCredited,
        breakdown: vBreakdown,
        label: editTier.name
      };
    }
    if (s.pricingModel === 'per_page') {
      var subtotal = s.pageRate * cfg.pages;
      var wTotal = subtotal;
      var wBreakdown = ['📄 ' + cfg.pages + ' page(s) @ $' + s.pageRate + '/page: $' + subtotal];
      if (cfg.revisions > 0) {
        var wRevFee = cfg.revisions * REVISION_FEE.web;
        wTotal += wRevFee;
        wBreakdown.push('🔁 ' + cfg.revisions + ' extra revision round(s): $' + wRevFee);
      }
      wTotal += STANDARD_DEPOSIT;
      wBreakdown.push('💳 Deposit: $' + STANDARD_DEPOSIT);
      return {
        total: wTotal,
        deposit: STANDARD_DEPOSIT,
        depositCredited: true,
        breakdown: wBreakdown,
        label: cfg.pages + ' page(s)'
      };
    }
    if (s.pricingModel === 'quote_only') {
      return {
        total: 0,
        deposit: 0,
        depositCredited: false,
        breakdown: ['💬 Every project is scoped individually — book a free consultation and we’ll figure out the right approach and price together.'],
        label: 'Custom quote'
      };
    }
    return { total: 0, deposit: 0, depositCredited: false, breakdown: [], label: '' };
  }

  // ---------------- "Not sure what you need?" quiz ----------------

  var quizQuestions = [
    {
      key: 'q1',
      text: "What's this for?",
      options: [
        { label: '🎵 Music or artist release', value: 'music' },
        { label: '🏢 Brand, event, or org', value: 'brand' },
        { label: '🔁 Ongoing support', value: 'ongoing' }
      ]
    },
    {
      key: 'q2',
      text: 'What do you need?',
      options: [
        { label: '🎥 Video', value: 'video' },
        { label: '📷 Photos', value: 'photography' },
        { label: '🎨 Flyers or graphics', value: 'graphic-design' },
        { label: '💻 A website', value: 'web' },
        { label: '📡 A livestream', value: 'live' }
      ]
    }
  ];
  var quizAnswers = {};

  document.getElementById('nrn-help-toggle').addEventListener('click', function () {
    var panel = document.getElementById('nrn-quiz');
    panel.hidden = !panel.hidden;
    if (!panel.hidden) { quizAnswers = {}; renderQuizStep(0); }
  });

  function renderQuizStep(stepIndex) {
    var panel = document.getElementById('nrn-quiz');
    var q = quizQuestions[stepIndex];
    if (!q) { finishQuiz(); return; }
    panel.innerHTML = '<h4>' + q.text + '</h4>' +
      '<div class="nrn-help-text">Tap the option that fits best.</div>' +
      q.options.map(function (opt) {
        return '<button type="button" class="nrn-quiz-opt" data-value="' + opt.value + '">' + opt.label + '</button>';
      }).join('');
    Array.prototype.forEach.call(panel.querySelectorAll('.nrn-quiz-opt'), function (btn) {
      btn.addEventListener('click', function () {
        quizAnswers[q.key] = btn.dataset.value;
        if (q.key === 'q1' && btn.dataset.value === 'ongoing') { finishQuiz(); return; }
        renderQuizStep(stepIndex + 1);
      });
    });
  }

  function finishQuiz() {
    var panel = document.getElementById('nrn-quiz');
    suggestedId = quizAnswers.q1 === 'ongoing' ? 'admin' : (quizAnswers.q2 || null);
    panel.hidden = true;
    renderGrid();
    var card = document.querySelector('.nrn-card[data-id="' + suggestedId + '"]');
    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // ---------------- Service grid ----------------

  var SERVICE_ICONS = {
    video: '🎥',
    camera: '📷',
    pen: '🎨',
    code: '💻',
    broadcast: '📡',
    briefcase: '📋',
    mic: '🎤'
  };

  function renderGrid() {
    var grid = document.getElementById('nrn-grid');
    grid.innerHTML = services.map(function (s) {
      var isSelected = selected.hasOwnProperty(s.id);
      var isSuggested = suggestedId === s.id;
      var emoji = SERVICE_ICONS[s.icon] || '⭐';
      var priceLabel = s.pricingModel === 'quote_only' ? 'Custom quote' : ('$' + displayStartingPrice(s) + '+');

      return '' +
        '<div class="nrn-card' + (isSelected ? ' selected' : '') + (isSuggested ? ' suggested' : '') +
          '" data-id="' + s.id + '" role="button" tabindex="0" aria-pressed="' + isSelected + '" aria-label="' + s.name + ', ' + (s.pricingModel === 'quote_only' ? 'custom quote' : 'starting at $' + displayStartingPrice(s)) + (s.description ? '. ' + s.description : '') + '">' +
          (s.mostBooked ? '<span class="nrn-badge">🔥 Most booked</span>' : '') +
          (isSuggested ? '<span class="nrn-badge nrn-suggest-badge">⭐ For you</span>' : '') +
          '<span class="nrn-card-row">' +
            '<span class="nrn-check" aria-hidden="true">' + (isSelected ? '✅' : '⬜') + '</span>' +
            '<span class="nrn-icon" aria-hidden="true">' + emoji + '</span>' +
            '<span class="nrn-card-main">' +
              '<span class="nrn-name">' + s.name + '</span>' +
              '<span class="nrn-price">' + priceLabel + '</span>' +
            '</span>' +
          '</span>' +
          (s.description ? '<span class="nrn-card-desc" aria-hidden="true">' + s.description + '</span>' : '') +
          (isSelected ? renderConfig(s, selected[s.id]) : '') +
        '</div>';
    }).join('');

    Array.prototype.forEach.call(grid.querySelectorAll('.nrn-card'), function (card) {
      card.addEventListener('click', function (evt) {
        if (evt.target.closest('.nrn-config')) return;
        toggleService(card.dataset.id);
      });
      card.addEventListener('keydown', function (evt) {
        if (evt.target !== card) return; // let nested controls handle their own keys
        if (evt.key === 'Enter' || evt.key === ' ') {
          evt.preventDefault();
          toggleService(card.dataset.id);
        }
      });
    });

    services.forEach(function (s) {
      if (!selected.hasOwnProperty(s.id)) return;
      wireConfigControls(s);
    });
  }

  function renderConfig(s, cfg) {
    var price = computePrice(s, cfg);
    var html = '<span class="nrn-config">';

    if (s.pricingModel === 'package') {
      html += '<span class="nrn-config-row"><span class="nrn-help-text" style="margin:0 0 8px;">You can select more than one.</span><span class="nrn-tiers-stack">' +
