        html += renderVideoExampleLink(cfg.videoType);
        html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-hours-' + s.id + '">🕒 Shoot hours ($' + VIDEO_BASE_SHOOT + ' covers the first ' + VIDEO_BASE_HOURS + ', then $' + VIDEO_EXTRA_HOUR_RATE + '/hr)</label>' +
          '<input type="number" id="nrn-hours-' + s.id + '" min="' + VIDEO_BASE_HOURS + '" step="0.5" class="nrn-hours-input" data-service="' + s.id + '" data-field="hours" value="' + cfg.hours + '" /></span>';
        html += '<span class="nrn-config-row"><span class="nrn-config-label">✂️ Edit length</span><span class="nrn-tiers">' +
          VIDEO_EDIT_TIERS.map(function (t, i) {
            return '<button type="button" class="nrn-tier' + (i === cfg.tierIndex ? ' active' : '') +
              '" data-service="' + s.id + '" data-field="tierIndex" data-value="' + i + '" aria-pressed="' + (i === cfg.tierIndex) + '">' +
              t.name + '</button>';
          }).join('') + '</span></span>';
        html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-vidlocations-' + s.id + '">📍 Extra locations beyond primary ($' + VIDEO_LOCATION_FEE + ' each)</label>' +
          '<input type="number" id="nrn-vidlocations-' + s.id + '" min="0" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="extraLocations" value="' + cfg.extraLocations + '" /></span>';
        html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-vidrevisions-' + s.id + '">🔁 Extra revision rounds beyond the 2 free ($' + REVISION_FEE.video + '/round)</label>' +
          '<input type="number" id="nrn-vidrevisions-' + s.id + '" min="0" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="revisions" value="' + cfg.revisions + '" /></span>';
        html += '<span class="nrn-config-row"><span class="nrn-config-label">➕ Add-ons</span>' +
          '<span class="nrn-toggle-row">' +
            '<button type="button" class="nrn-toggle' + (cfg.whiteLabel ? ' active' : '') + '" data-service="' + s.id + '" data-field="whiteLabel" data-value="toggle" aria-pressed="' + !!cfg.whiteLabel + '">🏷️ White-label, remove branding (+' + Math.round(VIDEO_WHITE_LABEL_PCT * 100) + '%)</button>' +
          '</span></span>';
      }
    }

    if (s.pricingModel === 'hourly') {
      if (s.id === 'photography') {
        html += '<span class="nrn-help-text" style="margin:0 0 8px;"><a class="nrn-inline-link" href="' + PHOTOGRAPHY_EXAMPLE_URL + '" target="_blank" rel="noopener noreferrer">🎥 See examples</a></span>';
        html += '<span class="nrn-config-row"><span class="nrn-config-label">📍 Where</span>' +
          '<span class="nrn-toggle-row">' +
            '<button type="button" class="nrn-toggle' + (cfg.studio !== 'facility' ? ' active' : '') + '" data-service="' + s.id + '" data-field="studio" data-value="standard" aria-pressed="' + (cfg.studio !== 'facility') + '">📍 On-location $' + PHOTO_ON_LOCATION_RATE + '/hr</button>' +
            '<button type="button" class="nrn-toggle' + (cfg.studio === 'facility' ? ' active' : '') + '" data-service="' + s.id + '" data-field="studio" data-value="facility" aria-pressed="' + (cfg.studio === 'facility') + '">🏠 In-studio $' + photoFacilityRate(s) + '/hr</button>' +
          '</span></span>';
      }
      html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-hours-' + s.id + '">🕒 Hours</label>' +
        '<input type="number" id="nrn-hours-' + s.id + '" min="' + s.minHours + '" step="0.5" class="nrn-hours-input" data-service="' + s.id + '" data-field="hours" value="' + cfg.hours + '" /></span>';
      if (s.id === 'photography') {
        html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-extraphotos-' + s.id + '">🖼️ Extra edited photos ($' + PHOTO_EXTRA_PHOTO_SINGLE + '/ea, or ' + PHOTO_EXTRA_PHOTO_BUNDLE_SIZE + ' for $' + PHOTO_EXTRA_PHOTO_BUNDLE_PRICE + ')</label>' +
          '<input type="number" id="nrn-extraphotos-' + s.id + '" min="0" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="extraPhotos" value="' + cfg.extraPhotos + '" /></span>';
        html += '<span class="nrn-config-row"><span class="nrn-config-label">➕ Add-ons</span>' +
          '<span class="nrn-toggle-row">' +
            '<button type="button" class="nrn-toggle' + (cfg.rushDelivery ? ' active' : '') + '" data-service="' + s.id + '" data-field="rushDelivery" data-value="toggle" aria-pressed="' + !!cfg.rushDelivery + '">⚡ Rush delivery, 48hr (+$' + PHOTO_RUSH_FEE + ')</button>' +
          '</span></span>';
      }
    }

    if (s.pricingModel === 'per_page') {
      html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-pages-' + s.id + '">📄 Pages</label>' +
        '<input type="number" id="nrn-pages-' + s.id + '" min="1" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="pages" value="' + cfg.pages + '" /></span>';
      html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-webrevisions-' + s.id + '">🔁 Extra revision rounds beyond the 2 free ($' + REVISION_FEE.web + '/round)</label>' +
        '<input type="number" id="nrn-webrevisions-' + s.id + '" min="0" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="revisions" value="' + cfg.revisions + '" /></span>';
    }

    html += '<span class="nrn-breakdown">' + price.breakdown.join('<br>') + '</span>';
    if (s.pricingModel !== 'quote_only') {
      html += '<span class="nrn-config-total">Total: $' + price.total + '</span>';
      if (s.pricingModel === 'hourly_plus_edit' && cfg.videoType !== 'raisethebar') {
        html += '<span class="nrn-help-text" style="margin:8px 0 0;">📌 Shoots start at $' + VIDEO_BASE_SHOOT + ' for ' + VIDEO_BASE_HOURS + ' hours, then $' + VIDEO_EXTRA_HOUR_RATE + '/hr, plus edit. Final price may vary based on decisions made in your consultation.</span>';
      }
      if (price.deposit > 0) {
        html += '<span class="nrn-deposit-note">💳 Deposit ' + (price.depositCredited ? 'credited toward this total' : 'in addition to the total above') + ', non-refundable</span>';
      }
    }
    html += '</span>';
    return html;
  }

  function wireConfigControls(s) {
    var card = document.querySelector('.nrn-card[data-id="' + s.id + '"]');
    if (!card) return;
    Array.prototype.forEach.call(card.querySelectorAll('.nrn-tier, .nrn-toggle'), function (btn) {
      btn.addEventListener('click', function (evt) {
        evt.stopPropagation();
        var field = btn.dataset.field;
        var value = btn.dataset.value;
        var cfg = selected[s.id];
        if (field === 'tierIndex') cfg.tierIndex = Number(value);
        else if (field === 'interviewTier') cfg.interviewTier = Number(value);
        else if (field === 'tierToggle') {
          var idx = Number(value);
          var pos = cfg.tierIndices.indexOf(idx);
          if (pos !== -1) {
            // Keep at least one tier selected — a package with nothing
            // picked has no meaningful price.
            if (cfg.tierIndices.length > 1) cfg.tierIndices.splice(pos, 1);
          } else {
            cfg.tierIndices.push(idx);
          }
        }
        else if (field === 'videoType') {
          cfg.videoType = value;
          // Event recaps always happen at the event — no in-studio option.
          if (value === 'recap') cfg.studio = 'standard';
        }
        else if (field === 'studio') cfg.studio = value;
        else if (field === 'talent' || field === 'facility' || field === 'whiteLabel' || field === 'rushDelivery') cfg[field] = !cfg[field];
        saveSelection();
        renderGrid();
        renderLoadout();
        // Re-rendering replaces this button's DOM node; restore focus.
        focusConfigControl(s.id, field, value);
      });
    });
    Array.prototype.forEach.call(card.querySelectorAll('.nrn-hours-input'), function (input) {
      input.addEventListener('click', function (evt) { evt.stopPropagation(); });
      input.addEventListener('change', function () {
        var field = input.dataset.field;
        var cfg = selected[s.id];
        var num = Math.max(Number(input.min) || 0, Number(input.value) || 0);
        cfg[field] = num;
        saveSelection();
        renderGrid();
        renderLoadout();
        focusConfigControl(s.id, field, null, input.id);
      });
    });
  }

  // Restores keyboard focus to the equivalent control after a full grid
  // re-render, since innerHTML replacement destroys the original node.
  function focusConfigControl(serviceId, field, value, inputId) {
    var target = inputId
      ? document.getElementById(inputId)
      : document.querySelector('.nrn-card[data-id="' + serviceId + '"] [data-field="' + field + '"][data-value="' + value + '"]');
    if (target) target.focus();
  }

  function toggleService(id) {
    var s = services.find(function (x) { return x.id === id; });
    if (!s) return;
    if (selected.hasOwnProperty(id)) {
      delete selected[id];
    } else {
      selected[id] = defaultConfig(s);
      fetch(SCRIPT_URL + '?action=click&id=' + encodeURIComponent(id)).catch(function () {});
    }
    saveSelection();
    renderGrid();
    renderLoadout();
    renderBundleSuggestion();
    var card = document.querySelector('.nrn-card[data-id="' + id + '"]');
    if (card) card.focus();
  }

  // ---------------- Bundle suggestion ----------------

  function renderBundleSuggestion() {
    var box = document.getElementById('nrn-bundle');
    var selectedIds = Object.keys(selected);
    var match = bundles.find(function (b) {
      return b.requiredServiceIds.length > 0 &&
        b.requiredServiceIds.every(function (id) { return selectedIds.indexOf(id) !== -1; });
    });
    if (match) {
      box.style.display = 'block';
      box.innerHTML = 'That combo qualifies for <strong>' + match.name + '</strong> &mdash; ' + match.description + ' ($' + match.price + ')';
    } else {
      box.style.display = 'none';
    }
  }

  // ---------------- Loadout, booking, and estimate ----------------

  function selectionSummary() {
    return Object.keys(selected).map(function (id) {
      var s = services.find(function (x) { return x.id === id; });
      var price = computePrice(s, selected[id]);
      return s.name + ' (' + price.label + ', $' + price.total + ')';
    }).join(', ');
  }

  function selectionTotal() {
    return Object.keys(selected).reduce(function (sum, id) {
      var s = services.find(function (x) { return x.id === id; });
      return sum + computePrice(s, selected[id]).total;
    }, 0);
  }

  function renderLoadout() {
    var panel = document.getElementById('nrn-loadout');
    var estimateBox = document.getElementById('nrn-estimate');
    var ids = Object.keys(selected);
    if (ids.length === 0) { panel.style.display = 'none'; estimateBox.innerHTML = ''; return; }
    panel.style.display = 'block';

    var total = selectionTotal();
    var rows = ids.map(function (id) {
      var s = services.find(function (x) { return x.id === id; });
      var price = computePrice(s, selected[id]);
      var priceDisplay = s.pricingModel === 'quote_only' ? 'Custom quote' : ('$' + price.total);
      var leftLabel = s.pricingModel === 'quote_only' ? s.name : (s.name + ' &mdash; ' + price.label);
      return '<div class="nrn-loadout-row"><span>' + leftLabel + '</span><span>' + priceDisplay + '</span></div>';
    }).join('');

    panel.innerHTML =
      '<h4>🧾 02 · Your selections</h4>' +
      '<div class="nrn-help-text">Here’s what you’ve picked so far. Looks good? Hit Continue below.</div>' + rows +
      '<div id="nrn-total"><span>💰 Total</span><span>$' + total + '</span></div>' +
      '<div id="nrn-total-note">Includes deposits. Final invoice may vary — see your service agreement.</div>' +
      '<button id="nrn-continue" type="button">Continue</button>';

    document.getElementById('nrn-continue').addEventListener('click', function () {
      if (leadSubmitted) { showPage('nrn-page-actions'); renderActions(); }
      else { showPage('nrn-page-about'); renderIntakeStep(); }
    });
  }

  // ---------------- Intake: who they are + a few demographic questions ----------------

  var heardAboutOptions = ['Instagram', 'TikTok', 'Google search', 'Referral from someone', 'Saw us at an event or show', 'Other'];
  var timelineOptions = ['ASAP', 'Within 2 weeks', 'Within a month', '1–3 months', 'Just exploring'];

  function optionsHtml(list) {
    return list.map(function (opt) { return '<option value="' + opt + '">' + opt + '</option>'; }).join('');
  }

  function renderIntakeStep() {
    document.getElementById('nrn-actions').innerHTML = '';
    var box = document.getElementById('nrn-intake');
    box.innerHTML =
      '<div class="nrn-intake-panel">' +
        '<button type="button" class="nrn-link-btn nrn-back-btn" id="nrn-back-to-services">&larr; Back</button>' +
        '<h4>👤 03 · About you</h4>' +
        '<div class="nrn-help-text">Just a few quick questions so we know who we’re working with. Takes about 30 seconds.</div>' +
        '<label for="nrn-intake-name" class="nrn-sr-only">Name</label>' +
        '<input type="text" id="nrn-intake-name" class="nrn-intake-field" placeholder="Your name" autocomplete="name" value="' + escapeHtml(leadName) + '" />' +
        '<label for="nrn-intake-email" class="nrn-sr-only">Email</label>' +
        '<input type="email" id="nrn-intake-email" class="nrn-intake-field" placeholder="name@email.com" autocomplete="email" value="' + escapeHtml(leadEmail) + '" />' +
        '<label class="nrn-config-label" for="nrn-intake-phone" style="margin-top:14px;">📞 Phone (optional)</label>' +
        '<input type="tel" id="nrn-intake-phone" class="nrn-intake-field" placeholder="(615) 555-0123" autocomplete="tel" value="' + escapeHtml(leadPhone) + '" />' +
        '<div class="nrn-config-row"><span class="nrn-config-label">Who are you?</span>' +
          '<span class="nrn-toggle-row">' +
            '<button type="button" class="nrn-toggle" id="nrn-role-artist" data-value="Artist" aria-pressed="false">🎤 Artist</button>' +
            '<button type="button" class="nrn-toggle" id="nrn-role-business" data-value="Small business" aria-pressed="false">🏢 Small business</button>' +
          '</span></div>' +
        '<label class="nrn-config-label" for="nrn-intake-location" style="margin-top:14px;">📍 Location or city (optional)</label>' +
        '<input type="text" id="nrn-intake-location" class="nrn-intake-field" placeholder="Nashville, TN" value="' + escapeHtml(leadLocation) + '" />' +
        '<label class="nrn-config-label" for="nrn-heard-about" style="margin-top:14px;">📱 How did you hear about us?</label>' +
        '<select id="nrn-heard-about" class="nrn-intake-field">' + optionsHtml(heardAboutOptions) + '</select>' +
        '<label class="nrn-config-label" for="nrn-timeline" style="margin-top:14px;">📅 When do you need this?</label>' +
        '<select id="nrn-timeline" class="nrn-intake-field">' + optionsHtml(timelineOptions) + '</select>' +
        '<label class="nrn-config-label" for="nrn-intake-details" style="margin-top:14px;">📝 Anything else? (optional)</label>' +
        '<textarea id="nrn-intake-details" class="nrn-intake-field nrn-intake-textarea" placeholder="Event date, vision, specific requests...">' + escapeHtml(leadDetails) + '</textarea>' +
        '<div class="nrn-help-text" style="margin-top:14px;">What you enter here is used to prepare your quote and coordinate your booking. See our <a class="nrn-inline-link" href="https://www.nrnszn.com/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> for details.</div>' +
        '<button id="nrn-intake-submit" type="button">Continue</button>' +
        '<div id="nrn-intake-error" role="alert"></div>' +
      '</div>';

    var roleButtons = [document.getElementById('nrn-role-artist'), document.getElementById('nrn-role-business')];
    roleButtons.forEach(function (btn) {
      if (btn.dataset.value === leadRole) { btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true'); }
      btn.addEventListener('click', function () {
        leadRole = btn.dataset.value;
        roleButtons.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });

    document.getElementById('nrn-back-to-services').addEventListener('click', function () {
      showPage('nrn-page-services');
    });
    document.getElementById('nrn-intake-submit').addEventListener('click', submitIntake);
  }

  function submitIntake() {
    var errorEl = document.getElementById('nrn-intake-error');
    var name = document.getElementById('nrn-intake-name').value.trim();
    var email = document.getElementById('nrn-intake-email').value.trim();
    var validEmail = EMAIL_RE.test(email);

    if (!name || !validEmail || !leadRole) {
      errorEl.textContent = !name ? 'Enter your name first.' : (!validEmail ? 'Enter a valid email address first.' : 'Pick artist or small business.');
      errorEl.style.display = 'block';
      return;
    }
    errorEl.style.display = 'none';

    leadName = name;
    leadEmail = email;
    leadPhone = document.getElementById('nrn-intake-phone').value.trim();
    leadLocation = document.getElementById('nrn-intake-location').value.trim();
    leadDetails = document.getElementById('nrn-intake-details').value.trim();
    var heardAbout = document.getElementById('nrn-heard-about').value;
    var timeline = document.getElementById('nrn-timeline').value;

    var summary = selectionSummary();
    var total = selectionTotal();
    postAction({
      action: 'lead',
      name: leadName,
      email: leadEmail,
      phone: leadPhone,
      location: leadLocation,
      role: leadRole,
      heardAbout: heardAbout,
      timeline: timeline,
      details: leadDetails,
      summary: summary,
      total: total
    }).catch(function () {});

    leadSubmitted = true;
    document.getElementById('nrn-intake').innerHTML = '';
    showPage('nrn-page-actions');
    renderActions();
  }

  function renderActions() {
    var box = document.getElementById('nrn-actions');
    box.innerHTML =
      '<button type="button" class="nrn-link-btn nrn-back-btn" id="nrn-back-to-about">&larr; Back</button>' +
      '<h4 class="nrn-step-label">&#128197; 04 · Book or get a quote</h4>' +
      '<div class="nrn-help-text">Ready to talk? Book a time below. Just want pricing first? Get an estimate emailed to you instead.</div>' +
      '<button id="nrn-cta" type="button">&#128197; Book a consultation</button>' +
      '<button id="nrn-cta-estimate" type="button">&#9993;&#65039; Email me an estimate</button>';

    document.getElementById('nrn-back-to-about').addEventListener('click', function () {
      showPage(leadSubmitted ? 'nrn-page-services' : 'nrn-page-about');
    });

    document.getElementById('nrn-cta').addEventListener('click', function () {
      chosenSlot = null;
      document.getElementById('nrn-estimate').innerHTML = '';
      showPage('nrn-page-flow');
      renderBookingPanel();
    });

    document.getElementById('nrn-cta-estimate').addEventListener('click', function () {
      document.getElementById('nrn-booking').innerHTML = '';
      showPage('nrn-page-flow');
      renderEstimateForm();
    });
  }

  // ---------------- Direct Google Calendar booking ----------------

  var bookingDate = null;
  var bookingSlots = [];

  function toLocalDateStr(d) {
    // Avoid the UTC-shift bug in toISOString(): late at night in a
    // behind-UTC timezone, toISOString() can render as tomorrow's date.
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  var WEEKDAY_LABELS = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
  var MONTH_LABELS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  var calendarViewYear, calendarViewMonth; // the month currently displayed in the popover
  var calendarOpen = false;

  function renderBookingPanel() {
    bookingDate = null;
    bookingSlots = [];
    chosenSlot = null;
    calendarOpen = false;
    var today = new Date();
    calendarViewYear = today.getFullYear();
    calendarViewMonth = today.getMonth();
    // Near the end of the month only a few days would be selectable, so
    // open on next month instead.
    var daysLeftInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate() - today.getDate() + 1;
    if (daysLeftInMonth <= 4) {
      calendarViewMonth++;
      if (calendarViewMonth > 11) { calendarViewMonth = 0; calendarViewYear++; }
    }
    renderDateStep();
  }

  function renderDateStep() {
    var box = document.getElementById('nrn-booking');
    var todayStr = toLocalDateStr(new Date());
    var maxDateObj = new Date();
    maxDateObj.setDate(maxDateObj.getDate() + 30);
    var maxDateStr = toLocalDateStr(maxDateObj);

    var buttonLabel = bookingDate
      ? new Date(bookingDate + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })
      : 'Choose a date';

    box.innerHTML =
      '<div class="nrn-booking-panel">' +
        '<button type="button" class="nrn-link-btn nrn-back-btn" id="nrn-back-to-actions">&larr; Back</button>' +
        '<h4>🕒 05 · Pick a time</h4>' +
        '<div class="nrn-help-text">Choose a date below to see open times that day.</div>' +
        '<button type="button" id="nrn-book-date-btn" aria-haspopup="true" aria-expanded="' + calendarOpen + '">📅 ' + buttonLabel + '</button>' +
        '<div id="nrn-calendar-popover" hidden></div>' +
        '<div id="nrn-slots" class="nrn-slots"></div>' +
      '</div>';

    document.getElementById('nrn-back-to-actions').addEventListener('click', function () {
      showPage('nrn-page-actions');
    });
    document.getElementById('nrn-book-date-btn').addEventListener('click', function () {
      calendarOpen = !calendarOpen;
      if (calendarOpen) renderCalendar(todayStr, maxDateStr);
      document.getElementById('nrn-calendar-popover').hidden = !calendarOpen;
      document.getElementById('nrn-book-date-btn').setAttribute('aria-expanded', calendarOpen);
    });

    if (calendarOpen) renderCalendar(todayStr, maxDateStr);
  }

  function renderCalendar(minDateStr, maxDateStr) {
    var pop = document.getElementById('nrn-calendar-popover');
    pop.hidden = false;

    var firstOfMonth = new Date(calendarViewYear, calendarViewMonth, 1);
    var daysInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate();
    var startWeekday = firstOfMonth.getDay();

    var minMonth = new Date(minDateStr + 'T00:00:00');
    var maxMonth = new Date(maxDateStr + 'T00:00:00');
    var atMinMonth = calendarViewYear === minMonth.getFullYear() && calendarViewMonth === minMonth.getMonth();
    var atMaxMonth = calendarViewYear === maxMonth.getFullYear() && calendarViewMonth === maxMonth.getMonth();

    var cells = '';
    for (var i = 0; i < startWeekday; i++) {
      cells += '<span class="nrn-cal-day nrn-cal-blank"></span>';
    }
    for (var d = 1; d <= daysInMonth; d++) {
      var cellDate = new Date(calendarViewYear, calendarViewMonth, d);
      var cellStr = toLocalDateStr(cellDate);
      var inRange = cellStr >= minDateStr && cellStr <= maxDateStr;
      var isSelected = bookingDate === cellStr;
      var isToday = cellStr === toLocalDateStr(new Date());
      if (inRange) {
        cells += '<button type="button" class="nrn-cal-day' + (isSelected ? ' active' : '') + (isToday ? ' nrn-cal-today' : '') +
          '" data-date="' + cellStr + '" aria-pressed="' + isSelected + '">' + d + '</button>';
      } else {
        cells += '<span class="nrn-cal-day nrn-cal-disabled">' + d + '</span>';
      }
    }

    pop.innerHTML =
      '<div class="nrn-cal-header">' +
        '<button type="button" id="nrn-cal-prev" aria-label="Previous month"' + (atMinMonth ? ' disabled' : '') + '>&larr;</button>' +
        '<span class="nrn-cal-month-label">' + MONTH_LABELS[calendarViewMonth] + ' ' + calendarViewYear + '</span>' +
        '<button type="button" id="nrn-cal-next" aria-label="Next month"' + (atMaxMonth ? ' disabled' : '') + '>&rarr;</button>' +
      '</div>' +
      '<div class="nrn-cal-grid nrn-cal-weekdays">' + WEEKDAY_LABELS.map(function (w) { return '<span>' + w + '</span>'; }).join('') + '</div>' +
      '<div class="nrn-cal-grid">' + cells + '</div>';

    document.getElementById('nrn-cal-prev').addEventListener('click', function () {
      calendarViewMonth--;
      if (calendarViewMonth < 0) { calendarViewMonth = 11; calendarViewYear--; }
      renderCalendar(minDateStr, maxDateStr);
    });
    document.getElementById('nrn-cal-next').addEventListener('click', function () {
      calendarViewMonth++;
      if (calendarViewMonth > 11) { calendarViewMonth = 0; calendarViewYear++; }
      renderCalendar(minDateStr, maxDateStr);
    });
    Array.prototype.forEach.call(pop.querySelectorAll('.nrn-cal-day[data-date]'), function (btn) {
      btn.addEventListener('click', function () {
        calendarOpen = false;
        loadSlots(btn.dataset.date);
      });
    });
  }

  function loadSlots(dateStr) {
    bookingDate = dateStr;
    var slotsBox = document.getElementById('nrn-slots');
    slotsBox.innerHTML = '<span class="nrn-muted">Loading times...</span>';

    fetch(SCRIPT_URL + '?action=availability&date=' + encodeURIComponent(dateStr))
      .then(function (r) { return r.json(); })
      .then(function (res) {
        bookingSlots = res.slots || [];
        renderSlotsStep();
      })
      .catch(function () {
        slotsBox.innerHTML = '<span class="nrn-error-inline">Could not load times — try again.</span>';
      });
  }

  function renderSlotsStep() {
    var box = document.getElementById('nrn-booking');
    var slotsHtml;
    if (bookingSlots.length === 0) {
      slotsHtml = '<span class="nrn-muted">No open times that day — try another date.</span>';
    } else {
      slotsHtml = '<div class="nrn-slots">' + bookingSlots.map(function (s) {
        return '<button type="button" class="nrn-slot' + (chosenSlot && chosenSlot.time === s.time ? ' active' : '') +
          '" data-time="' + s.time + '" data-label="' + s.label + '">' + s.label + '</button>';
      }).join('') + '</div>';
    }

    box.innerHTML =
      '<div class="nrn-booking-panel">' +
        '<button type="button" class="nrn-link-btn nrn-back-btn" id="nrn-back-to-date">&larr; Back to date</button>' +
        '<h4>🕒 05 · Times on ' + bookingDate + '</h4>' +
        '<div class="nrn-help-text">Tap a time that works for you.</div>' +
        slotsHtml +
      '</div>';

    document.getElementById('nrn-back-to-date').addEventListener('click', renderDateStep);
    Array.prototype.forEach.call(box.querySelectorAll('.nrn-slot'), function (btn) {
      btn.addEventListener('click', function () {
        chosenSlot = { date: bookingDate, time: btn.dataset.time, label: btn.dataset.label };
        renderFormStep();
      });
    });
  }

  function renderFormStep() {
    var box = document.getElementById('nrn-booking');
    box.innerHTML =
      '<div class="nrn-booking-panel">' +
        '<button type="button" class="nrn-link-btn nrn-back-btn" id="nrn-back-to-slots">&larr; Back to times</button>' +
        '<h4>✅ 05 · Confirm ' + chosenSlot.label + '</h4>' +
        '<div class="nrn-help-text">Enter your name and email to lock in this time.</div>' +
        '<label for="nrn-book-name" class="nrn-sr-only">Name</label>' +
        '<input type="text" id="nrn-book-name" class="nrn-book-field" placeholder="Your name" autocomplete="name" value="' + escapeHtml(leadName) + '" />' +
        '<label for="nrn-book-email" class="nrn-sr-only">Email</label>' +
        '<input type="email" id="nrn-book-email" class="nrn-book-field" placeholder="name@email.com" autocomplete="email" value="' + escapeHtml(leadEmail) + '" />' +
        '<button id="nrn-book-submit" type="button">Confirm ' + chosenSlot.label + '</button>' +
        '<div id="nrn-book-error" role="alert"></div>' +
        '<div id="nrn-book-status"></div>' +
      '</div>';

    document.getElementById('nrn-back-to-slots').addEventListener('click', renderSlotsStep);
    document.getElementById('nrn-book-submit').addEventListener('click', submitBooking);
  }

  function submitBooking() {
    var nameInput = document.getElementById('nrn-book-name');
    var emailInput = document.getElementById('nrn-book-email');
    var errorEl = document.getElementById('nrn-book-error');
    var name = nameInput.value.trim();
    var email = emailInput.value.trim();
    var validEmail = EMAIL_RE.test(email);

    if (!name || !validEmail) {
      errorEl.textContent = !name ? 'Enter your name first.' : 'Enter a valid email address first.';
      errorEl.style.display = 'block';
      return;
    }
    errorEl.style.display = 'none';

    var summary = selectionSummary();
    var total = selectionTotal();
    var submitBtn = document.getElementById('nrn-book-submit');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Booking...';

    postAction({
      action: 'book',
      date: chosenSlot.date,
      time: chosenSlot.time,
      name: name,
      email: email,
      summary: summary,
      total: total
    }).then(function (r) { return r.json(); }).then(function (res) {
      if (res.success) {
        document.getElementById('nrn-booking').innerHTML =
          '<div class="nrn-booking-panel"><div id="nrn-book-status">Booked for ' + escapeHtml(res.time) +
          '. Check your email for the Google Meet link.</div></div>';
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Confirm ' + chosenSlot.label;
        errorEl.textContent = res.error || "Couldn't book that — try another time.";
        errorEl.style.display = 'block';
      }
    }).catch(function () {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirm ' + chosenSlot.label;
      errorEl.textContent = "Couldn't book that — try again.";
      errorEl.style.display = 'block';
    });
  }

  function renderEstimateForm() {
    var box = document.getElementById('nrn-estimate');
    box.innerHTML =
      '<button type="button" class="nrn-link-btn nrn-back-btn" id="nrn-back-to-actions-2">&larr; Back</button>' +
      '<div class="nrn-help-text">Enter your email and we’ll send the total right away.</div>' +
      '<div id="nrn-estimate-form">' +
        '<label for="nrn-estimate-email" class="nrn-sr-only">Email address</label>' +
        '<input type="email" id="nrn-estimate-email" placeholder="name@email.com" autocomplete="email" value="' + escapeHtml(leadEmail) + '" />' +
        '<button id="nrn-estimate-submit" type="button">Send</button>' +
      '</div>' +
      '<div id="nrn-estimate-error" role="alert"></div>' +
      '<div id="nrn-estimate-status"></div>';
    document.getElementById('nrn-back-to-actions-2').addEventListener('click', function () {
      showPage('nrn-page-actions');
    });

    document.getElementById('nrn-estimate-submit').addEventListener('click', function () {
      var input = document.getElementById('nrn-estimate-email');
      var errorEl = document.getElementById('nrn-estimate-error');
      var statusEl = document.getElementById('nrn-estimate-status');
      var email = input.value.trim();
      var validEmail = EMAIL_RE.test(email);

      if (!validEmail) {
        errorEl.textContent = 'Enter a valid email address first.';
        errorEl.style.display = 'block';
        return;
      }
      errorEl.style.display = 'none';

      var summary = selectionSummary();
      var total = selectionTotal();

      postAction({ action: 'estimate', email: email, summary: summary, total: total })
        .then(function (r) { return r.json(); }).then(function (res) {
        if (res.success) {
          statusEl.textContent = "Sent — check your inbox.";
          statusEl.style.display = 'block';
        } else {
          errorEl.textContent = res.error || "Couldn't send that — try again in a moment.";
          errorEl.style.display = 'block';
        }
      }).catch(function () {
        errorEl.textContent = "Couldn't send that — try again in a moment.";
        errorEl.style.display = 'block';
      });
    });
  }
})();
  </script>
</Base>

<style is:global>
  /* Global (not scoped) because most of this markup is built by the script
     at runtime. Every selector is namespaced under #nrn-select / .nrn-. */
  .services-page {
