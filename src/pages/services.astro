          return '<button type="button" class="nrn-tier' + (isActive ? ' active' : '') +
            '" data-service="' + s.id + '" data-field="videoType" data-value="' + v.value + '" aria-pressed="' + isActive + '">' + v.label + '</button>';
        }).join('') + '</span></span>';

      if (cfg.videoType === 'interview') {
        html += renderVideoExampleLink(cfg.videoType);
        html += '<span class="nrn-config-row"><span class="nrn-config-label">✂️ Edit length</span><span class="nrn-tiers-stack">' +
          VIDEO_EDIT_TIERS.map(function (t, i) {
            var isActive = (cfg.interviewTier || 0) === i;
            return '<button type="button" class="nrn-tier' + (isActive ? ' active' : '') +
              '" data-service="' + s.id + '" data-field="interviewTier" data-value="' + i + '" aria-pressed="' + isActive + '">' + t.name + '</button>';
          }).join('') + '</span></span>';

        html += '<span class="nrn-help-text" style="margin:0 0 8px;">By default, questions are asked by someone off-screen — they’re never shown on camera. Add on-screen talent below if you want a professional interviewer to appear on camera with you instead.</span>';
        html += '<span class="nrn-config-row"><span class="nrn-config-label">➕ Add-ons</span>' +
          '<span class="nrn-toggle-row">' +
            '<button type="button" class="nrn-toggle' + (cfg.talent ? ' active' : '') + '" data-service="' + s.id + '" data-field="talent" data-value="toggle" aria-pressed="' + !!cfg.talent + '">🎤 On-screen talent — interviewer appears on camera (+$' + INTERVIEW_TALENT_FEE + ')</button>' +
            '<button type="button" class="nrn-toggle' + (cfg.facility ? ' active' : '') + '" data-service="' + s.id + '" data-field="facility" data-value="toggle" aria-pressed="' + !!cfg.facility + '">🏠 Production facility (+$' + INTERVIEW_FACILITY_FEE + ')</button>' +
          '</span></span>';
        html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-ivlocations-' + s.id + '">📍 Extra locations beyond primary ($' + INTERVIEW_LOCATION_FEE + ' each, within 20mi)</label>' +
          '<input type="number" id="nrn-ivlocations-' + s.id + '" min="0" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="interviewLocations" value="' + cfg.interviewLocations + '" /></span>';
        html += '<span class="nrn-config-row"><label class="nrn-config-label" for="nrn-ivrevisions-' + s.id + '">🔁 Extra revision rounds beyond the 2 free ($' + INTERVIEW_REVISION_FEE + '/round)</label>' +
          '<input type="number" id="nrn-ivrevisions-' + s.id + '" min="0" step="1" class="nrn-hours-input" data-service="' + s.id + '" data-field="interviewRevisions" value="' + cfg.interviewRevisions + '" /></span>';
      } else if (cfg.videoType === 'raisethebar') {
        html += renderVideoExampleLink(cfg.videoType);
