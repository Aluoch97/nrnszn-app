---
// Same page as /about. Kept as its own address because invoice emails, the
// Events ticket buttons (?for=...) and /shop all link here; it opens scrolled
// to the payment options. Search engines are pointed at /about.
import Site from '../layouts/Site.astro';
import AboutSupport from '../components/AboutSupport.astro';
import PageHero from '../components/PageHero.astro';
---
<Site
  title="Pay or support | NuRenaissance"
  description="Pay for a NuRenaissance Media project, ticket or merch, or support independent art: card, Apple Pay, PayPal, Cash App, Venmo or Zelle."
>
  <PageHero
    page="support"
    title="Pay or support"
    kicker="NuRenaissance Media"
    text="Pay for a project, a ticket or merch, or support independent art."
    images={[
      { src: '/img/portal-poster-640.webp', srcset: '/img/portal-poster-640.webp 640w, /img/portal-poster.webp 1280w' },
      { src: '/img/home-hero-640.webp', srcset: '/img/home-hero-640.webp 640w, /img/home-hero.webp 1280w' },
    ]}
    mascot
    accent="#8520cc"
  />
  <AboutSupport mode="support" />
</Site>

<script>
  if (!location.hash) document.getElementById('support')?.scrollIntoView();
</script>
