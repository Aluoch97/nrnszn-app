---
// NuDirectory lives on its own site (directory.nrnszn.com). Showing it inside
// the app keeps the tab bar on screen, so there's always a way back.
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
const DIRECTORY = 'https://directory.nrnszn.com';
---
<Site
  title="NuDirectory | NuRenaissance"
  description="NuDirectory, the Nashville directory from NuRenaissance Media."
  app
>
  <h1 class="sr-only">NuDirectory</h1>
  <iframe class="dir-frame" src={DIRECTORY} title="NuDirectory"
    allow="fullscreen; clipboard-write; geolocation" allowfullscreen></iframe>
  <a class="dir-open" href={DIRECTORY} target="_blank" rel="noopener">
    Open NuDirectory in a new tab <Icon name="external" size={16} />
  </a>
</Site>

<style>
  .dir-frame { flex: 1; min-height: 0; width: 100%; border: 0; display: block; background: #0e0b16; }
  .dir-open {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    min-height: 40px; font-size: 14px; color: var(--shell-muted, #a99fc6); text-decoration: none;
    border-top: 1px solid #2a2238;
  }
  .dir-open:hover { color: #f3f0fa; }
</style>
