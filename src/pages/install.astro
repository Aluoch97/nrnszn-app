---
import Site from '../layouts/Site.astro';
---
<Site
  title="Add to Home Screen | NuRenaissance"
  description="Put NuRenaissance on your phone's home screen so it opens like an app."
>
  <article class="doc">
    <h1>Add to Home Screen</h1>
    <p class="meta">Open NuRenaissance like an app, one tap from your home screen.</p>

    <p id="install-done" hidden>You're already using NuRenaissance from your home screen. ✓</p>

    <button type="button" id="install-btn" class="install-btn" hidden>Install NuRenaissance</button>

    <section id="install-ios">
      <h2>iPhone or iPad (Safari)</h2>
      <ol>
        <li>Open this site in <strong>Safari</strong> (it won't work from inside other apps' browsers).</li>
        <li>Tap the <strong>Share</strong> button (the square with an arrow pointing up).</li>
        <li>Scroll down and tap <strong>Add to Home Screen</strong>.</li>
        <li>Tap <strong>Add</strong>. The icon now sits on your home screen.</li>
      </ol>
    </section>

    <section id="install-android">
      <h2>Android (Chrome)</h2>
      <ol>
        <li>Tap the <strong>⋮</strong> menu in the top corner of Chrome.</li>
        <li>Tap <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
        <li>Tap <strong>Install</strong> to confirm.</li>
      </ol>
    </section>

    <section id="install-desktop">
      <h2>Computer (Chrome or Edge)</h2>
      <p>Click the install icon at the right end of the address bar, or open the browser menu and choose <strong>Install</strong>.</p>
    </section>
  </article>
</Site>

<script>
  const ua = navigator.userAgent || '';
  const isIos = /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  const isAndroid = /Android/.test(ua);
  const standalone =
    (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const btn = $('install-btn');
  const ios = $('install-ios');
  const android = $('install-android');
  const desktop = $('install-desktop');

  if (standalone) {
    $('install-done').hidden = false;
    ios.hidden = android.hidden = desktop.hidden = true;
  } else {
    if (isIos) android.hidden = desktop.hidden = true;
    else if (isAndroid) ios.hidden = desktop.hidden = true;
    else ios.hidden = true; // computers: show the Android/Chrome and desktop help

    let deferred: any = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferred = e;
      btn.hidden = false;
    });
    btn.addEventListener('click', () => {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(() => { deferred = null; btn.hidden = true; });
    });
    window.addEventListener('appinstalled', () => {
      btn.hidden = true;
      $('install-done').textContent = 'Installed! Look for NuRenaissance on your home screen. ✓';
      $('install-done').hidden = false;
    });
  }
</script>

<style>
  .doc {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-6);
    font-size: 16px;
    line-height: 1.7;
    color: #e6e0f2;
  }
  .doc h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 7vw, 40px);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
    color: var(--gold-300);
  }
  .doc .meta { color: #a99fc6; font-size: 14px; margin: 0 0 var(--space-6); }
  .doc h2 {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.3;
    margin: var(--space-6) 0 var(--space-2);
    color: #f3f0fa;
  }
  .doc p { margin: 0 0 var(--space-3); }
  .doc ol { margin: 0 0 var(--space-3); padding-left: 1.4em; }
  .doc li { margin-bottom: var(--space-2); }
  .doc strong { color: #f3f0fa; font-weight: 600; }
  [hidden] { display: none !important; }
  .install-btn {
    min-height: 48px;
    padding: 0 var(--space-5, 24px);
    border: 0;
    border-radius: 12px;
    background: var(--gold-300);
    color: #1a1325;
    font: 700 16px/1 var(--font-body, inherit);
    cursor: pointer;
  }
  .install-btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
</style>
