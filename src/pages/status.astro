---
import Site from '../layouts/Site.astro';
---
<Site
  title="Site status | NuRenaissance"
  description="A live check of the NuRenaissance site: which parts run on the new backend, which still use the old fallback, and when the last backup ran."
  noindex={true}
>
  <article class="status">
    <h1>Site status</h1>
    <p class="lead">Checked live every time you open this page. "New" means the site itself is doing the job; "Old fallback" means the previous Google script is still doing it, which is safe but not finished.</p>

    <p class="banner" id="banner" role="status" aria-live="polite" data-tone="wait">Checking everything…</p>

    <section aria-labelledby="h-feeds">
      <h2 id="h-feeds">What visitors see</h2>
      <ul class="rows" data-group="feeds"></ul>
    </section>
    <section aria-labelledby="h-send">
      <h2 id="h-send">What visitors send</h2>
      <ul class="rows" data-group="send"></ul>
    </section>
    <section aria-labelledby="h-keep">
      <h2 id="h-keep">Backups</h2>
      <ul class="rows" data-group="keep"></ul>
    </section>

    <p class="foot-note" id="foot-note">&nbsp;</p>
  </article>
</Site>

<script>
  type Tone = 'ok' | 'old' | 'todo' | 'bad';
  type Result = { tone: Tone; text: string; note?: string };
  const count = (a: unknown) => (Array.isArray(a) ? a.length : 0);
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
  const when = (iso: string) => new Date(iso).toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

  // A write endpoint says which backend answers: "sheet" or "edge" = the site itself, "apps-script" = the old fallback.
  const mode = (what: string) => (j: any): Result => {
    if (j && (j.mode === 'sheet' || j.mode === 'edge')) return { tone: 'ok', text: 'New: the site handles this itself', note: what };
    if (j && j.mode === 'apps-script') return { tone: 'old', text: 'Old fallback: the previous Google script still handles this', note: 'Needs its Cloudflare secret(s) to switch over' };
    return { tone: 'bad', text: 'Unexpected answer', note: 'The endpoint answered, but not in the usual shape' };
  };

  const ROWS: { group: string; name: string; url: string; read: (j: any) => Result }[] = [
    { group: 'feeds', name: 'Gallery', url: '/api/feed/gallery', read: (j) => (j && j.source === 'drive' ? { tone: 'ok', text: 'New: read straight from Google Drive', note: plural(count(j.categories), 'category').replace('categorys', 'categories') } : j && count(j.categories) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No gallery came back' }) },
    { group: 'feeds', name: 'Cinema', url: '/api/feed/cinema', read: (j) => (j && j.source === 'sheet' ? { tone: 'ok', text: 'New: read straight from the NuCinema sheet', note: plural(count(j.films), 'film') } : j && count(j.films) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No films came back' }) },
    { group: 'feeds', name: 'Services', url: '/api/feed/services', read: (j) => (j && j.source === 'sheet' ? { tone: 'ok', text: 'New: read straight from the NuServices sheet', note: plural(count(j.services), 'service') } : j && count(j.services) ? { tone: 'old', text: 'Old fallback: the previous Google script answered' } : { tone: 'bad', text: 'No services came back' }) },
    { group: 'feeds', name: 'Latest videos', url: '/api/feed/latest', read: (j) => (j && j.ok ? { tone: 'ok', text: 'Answering', note: j.music && j.music.publishedAt ? `Newest music video: ${when(j.music.publishedAt)}` : undefined } : { tone: 'bad', text: 'No videos came back' }) },
    { group: 'send', name: 'Survey answers', url: '/api/survey', read: mode('Saves each response to the sheet and sends the e-mails') },
    { group: 'send', name: 'Daily recap e-mail', url: '/api/survey-recap', read: mode('The daily check for a new livestream recap') },
    { group: 'send', name: 'Payment taps', url: '/api/payment', read: mode('Logs each tap on PayPal, Cash App, Venmo, Zelle, Apple Pay') },
    { group: 'send', name: 'Service clicks', url: '/api/service-click', read: mode('Counts which services people look at') },
    { group: 'send', name: 'Service requests', url: '/api/service-lead', read: mode('Saves the intake form') },
    { group: 'keep', name: 'Nightly sheet backup', url: '/api/backup', read: (j) => {
      if (!j || !j.mode) return { tone: 'bad', text: 'Unexpected answer' };
      if (j.mode === 'not-set-up') return { tone: 'todo', text: 'Not set up yet', note: 'Needs the storage bucket and a secret (docs/backup-setup.md)' };
      if (!j.last || !j.last.at) return { tone: 'todo', text: 'Connected, but no backup has run yet', note: 'Run "Daily sheet backup" once from GitHub → Actions' };
      const days = (Date.now() - new Date(j.last.at).getTime()) / 86400000;
      return days > 1.6 ? { tone: 'old', text: `Last backup is ${Math.floor(days)} days old`, note: `${when(j.last.at)}. It should run every night` } : { tone: 'ok', text: `Last backup: ${when(j.last.at)}`, note: `${plural(j.last.kept || 1, 'nightly copy').replace('copys', 'copies')} kept` };
    } },
  ];

  const LABEL: Record<Tone, string> = { ok: 'OK', old: 'Fallback', todo: 'To do', bad: 'Problem' };
  const lists: Record<string, HTMLElement | null> = {};
  document.querySelectorAll<HTMLElement>('[data-group]').forEach((el) => { lists[el.dataset.group as string] = el; });

  function paint(li: HTMLElement, r: Result) {
    li.dataset.tone = r.tone;
    (li.querySelector('.tag') as HTMLElement).textContent = LABEL[r.tone];
    (li.querySelector('.text') as HTMLElement).textContent = r.text;
    (li.querySelector('.note') as HTMLElement).textContent = r.note || '';
  }

  const results: { name: string; r: Result }[] = [];
  function summary() {
    const bad = results.filter((x) => x.r.tone !== 'ok');
    const banner = document.getElementById('banner') as HTMLElement;
    if (results.length < ROWS.length) return;
    if (!bad.length) { banner.dataset.tone = 'ok'; banner.textContent = 'Everything is switched on and answering.'; }
    else {
      const hard = bad.filter((x) => x.r.tone === 'bad');
      banner.dataset.tone = hard.length ? 'bad' : 'old';
      banner.textContent = `${bad.length} of ${ROWS.length} need attention: ${bad.map((x) => x.name).join(', ')}.`;
    }
    (document.getElementById('foot-note') as HTMLElement).textContent = `Checked ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}.`;
  }

  ROWS.forEach((row) => {
    const li = document.createElement('li');
    li.className = 'row'; li.dataset.tone = 'wait';
    li.innerHTML = '<span class="name"></span><span class="tag">…</span><span class="text">Checking…</span><span class="note"></span>';
    (li.querySelector('.name') as HTMLElement).textContent = row.name;
    lists[row.group]?.appendChild(li);
    const done = (r: Result) => { paint(li, r); results.push({ name: row.name, r }); summary(); };
    fetch(row.url, { cache: 'no-store', signal: AbortSignal.timeout(20000) })
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((j) => done(row.read(j)))
      .catch(() => done({ tone: 'bad', text: 'Could not be reached', note: 'Try again in a minute' }));
  });
</script>

<style>
  .status { max-width: 760px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-6); color: #e6e0f2; font-size: 16px; line-height: 1.55; }
  h1 { font-family: var(--font-display); font-size: clamp(30px, 7vw, 40px); line-height: 1.15; margin: 0 0 var(--space-3); color: #fff; }
  h2 { font-family: var(--font-display); font-size: 22px; margin: var(--space-6) 0 var(--space-2); color: var(--gold-300); }
  .lead { margin: 0 0 var(--space-4); color: #cfc7e0; }
  .banner { margin: 0; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); font-weight: 600; background: #241d34; border: 1px solid #3a3150; }
  .banner[data-tone='ok'] { background: #12301f; border-color: #2c7a49; color: #c9f5d9; }
  .banner[data-tone='old'] { background: #33290f; border-color: #8a6d1c; color: #ffe9a8; }
  .banner[data-tone='bad'] { background: #3a1620; border-color: #a33a55; color: #ffd0da; }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px var(--space-3); align-items: baseline; padding: var(--space-3); border-radius: var(--radius-sm); background: #1a1526; border: 1px solid #2e2640; overflow-wrap: anywhere; }
  .name { font-weight: 700; color: #fff; }
  .tag { justify-self: end; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 10px; border-radius: var(--radius-pill); background: #2c2440; color: #e6e0f2; }
  .text { grid-column: 1 / -1; }
  .note { grid-column: 1 / -1; font-size: 14px; color: #b9b0cf; }
  .note:empty { display: none; }
  .row[data-tone='ok'] .tag { background: #16401f; color: #bff2cf; }
  .row[data-tone='old'] .tag, .row[data-tone='todo'] .tag { background: #4a3a0e; color: #ffe29a; }
  .row[data-tone='bad'] .tag { background: #55202e; color: #ffc9d4; }
  .foot-note { margin: var(--space-5) 0 0; font-size: 14px; color: #b9b0cf; }
</style>
