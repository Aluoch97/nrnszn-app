  }

  async function start() {
    show('acct-loading');
    let j: any;
    try { j = await api('me?projects=1'); } catch { $('acct-loading').textContent = 'Could not reach the site. Check your connection and reload.'; return; }
    if (!j.on) { show('acct-off'); return; }
