---
// One NuRenaissance account for every app: sign in with Google or an e-mail link, see your client projects (status, total, paid,
// balance) and jump into the apps already signed in. Backend: src/edge/accounts.js (/api/account/*). Everything drawn from the
// server is put in with textContent, never as HTML.
import Site from '../layouts/Site.astro';
import { pastEvents } from '../data/events.js';
// The five apps on the dashboard. `open` is where "Open" goes; Soul Vault is another website, so it goes through the sign-in hop.
const APPS = [
  { id: 'nrn', name: 'NuRenaissance', tag: 'Projects and payments', icon: '/img/apps/nrnszn-icon.webp', open: '/services' },
  { id: 'certified', name: 'Certified', tag: 'Your Passport stamps', icon: '/img/apps/certified-icon.webp', open: 'https://play.nrnszn.com/?tab=about' },
  { id: 'directory', name: 'NuDirectory', tag: 'Your listings and saves', icon: '/img/apps/nudirectory-icon.webp', open: 'https://directory.nrnszn.com/' },
  { id: 'vault', name: 'Soul Vault', tag: 'Your saved songs', icon: '/img/apps/soul-vault-icon.webp', open: '/api/account/connect?return=' + encodeURIComponent('https://soulnicolas.com/') },
  { id: 'luoh', name: 'luoh', tag: 'Your saved edits', icon: '/img/apps/luoh-icon.webp', open: 'https://luoh.nrnszn.com/' },
];
// Show names for the Passport, by date (the same shows as the Events page).
const SHOW_NAMES = Object.fromEntries(pastEvents.map((e) => [e.day, e.title]));
---
<Site
  title="Your account | NuRenaissance"
  description="One NuRenaissance account for every app: sign in once for Certified, NuDirectory, luoh and Soul Vault, and follow your projects with us."
  noindex={true}
>
  <article class="acct">
    <h1 id="acct-title">Your account</h1>
    <p id="acct-loading" class="lead" role="status">Loading…</p>

    <section id="acct-off" hidden class="card">
      <h2>Accounts are coming soon</h2>
      <p>Sign-in is not switched on yet. Check back shortly.</p>
    </section>

    <section id="acct-in" hidden aria-labelledby="acct-title">
      <p class="lead">One account for every NuRenaissance app. Sign in once and you are signed in to Certified, NuDirectory, luoh and Soul Vault too.</p>
      <p id="acct-msg" class="msg" role="alert"></p>
      <div class="card">
        <div id="g-wrap" hidden>
          <div id="g-btn" class="g-btn"></div>
          <p class="or"><span>or</span></p>
        </div>
        <form id="mail-form" class="mail" hidden>
          <label for="mail">Your e-mail</label>
          <input id="mail" type="email" autocomplete="email" inputmode="email" required maxlength="200" />
          <button type="submit" class="btn primary" id="mail-go">E-mail me a sign-in link</button>
          <p class="hint">The link works once, for 30 minutes. No password to remember.</p>
        </form>
        <p id="mail-sent" class="ok" role="status" hidden></p>
      </div>
      <p class="small">By signing in you agree to our <a href="/privacy-policy">privacy policy</a>. We keep your e-mail, your name (from Google) and when you last signed in.</p>
    </section>

    <section id="acct-me" hidden>
      <div class="card who">
        <div class="avatar" aria-hidden="true" id="me-initial"></div>
        <div class="who-t"><b id="me-name"></b><span id="me-email"></span><span id="me-since" class="since"></span></div>
      </div>
      <p id="me-continue-wrap" hidden><a class="btn primary wide" id="me-continue">Continue</a></p>

      <!-- The dashboard: one tile per app with a quick summary; a tile opens that app's page (#nrn, #certified, ... so Back works). -->
      <div id="dash-home">
        <h2 id="apps-h">Your apps</h2>
        <p class="small">One account, five apps. Tap one to see what it keeps for you.</p>
        <ul class="tiles" aria-labelledby="apps-h">
          {APPS.map((x) => (
            <li class={x.id === 'nrn' ? 'wide' : ''}><a class="tile" href={'#' + x.id} data-app={x.id}>
              <img src={x.icon} alt="" width="44" height="44" loading="lazy" />
              <span class="t-txt"><b>{x.name}</b><span class="t-sum" data-sum={x.id}>{x.tag}</span></span>
              <span class="t-go" aria-hidden="true">›</span>
            </a></li>
          ))}
        </ul>

        <section class="card notify" aria-labelledby="notify-h">
          <h2 class="card-h" id="notify-h">Phone notifications</h2>
          <p class="small">News, new videos and events from NuRenaissance on this phone, a few a month at most. Turn them on or off here any time.</p>
          <button type="button" class="btn wide" data-push-open hidden>Phone notifications on this device</button>
          <p class="small" data-push-off>Not switched on for this site yet.</p>
        </section>

        <details class="card more">
          <summary>Account settings</summary>
          <form id="name-form" class="mail">
            <label for="me-name-in">Your name</label>
            <input id="me-name-in" type="text" maxlength="80" autocomplete="name" />
            <button type="submit" class="btn">Save name</button>
            <p id="name-st" class="hint" role="status"></p>
          </form>
          <form id="del-form" class="mail danger">
            <label for="del-in">Delete my account</label>
            <p class="hint">This erases your account, your saved songs and listings, and any luoh projects saved on it, on every app. Your project history with NuRenaissance stays with us as a business record. Type your e-mail to confirm.</p>
            <input id="del-in" type="email" autocomplete="off" />
            <button type="submit" class="btn danger">Delete my account</button>
            <p id="del-st" class="hint" role="alert"></p>
          </form>
        </details>
        <button type="button" class="btn quiet wide" id="sign-out">Sign out of every app</button>
      </div>

      <!-- One app's page. -->
      <div id="dash-app" hidden>
        <a class="back" href="#" id="app-back">‹ All apps</a>
        <div class="app-head">
          <img id="app-icon" alt="" width="56" height="56" />
          <div class="app-head-t"><h2 id="app-name" tabindex="-1"></h2><p id="app-tag" class="small"></p></div>
        </div>

        <div data-panel="nrn" hidden>
          <dl class="nums stats" id="nrn-stats"></dl>
          <h3 class="sec">Your projects</h3>
          <div id="proj-list" class="projects" aria-live="polite"></div>
          <section id="pay-wrap" hidden>
            <h3 class="sec">Your payments</h3>
            <p class="small">Card and Apple Pay payments made with this e-mail. PayPal, Cash App, Venmo and Zelle payments show on the project once we mark them.</p>
            <ul class="pays-list" id="pay-list"></ul>
          </section>
        </div>

        <div data-panel="certified" hidden>
          <dl class="nums stats" id="cert-stats"></dl>
          <h3 class="sec">Your Certified Passport</h3>
          <p class="small">One stamp for every Certified show you check in at, saved to your account so every phone shows them.</p>
          <div id="cert-body" aria-live="polite"></div>
        </div>

        <div data-panel="directory" hidden>
          <dl class="nums stats" id="dir-stats"></dl>
          <h3 class="sec">Your listings</h3>
          <p class="small">What you sent to NuDirectory while signed in, and whether it is live.</p>
          <div id="dir-mine" aria-live="polite"></div>
          <h3 class="sec">Saved listings</h3>
          <div id="dir-saved"></div>
        </div>

        <div data-panel="vault" hidden>
          <dl class="nums stats" id="vault-stats"></dl>
          <h3 class="sec">Saved songs</h3>
          <p class="small">Songs you saved with ♡ in Soul Vault's Now Playing.</p>
          <div id="vault-saved"></div>
        </div>

        <div data-panel="luoh" hidden>
          <dl class="nums stats" id="luoh-stats"></dl>
          <h3 class="sec">Saved projects</h3>
          <p class="small">Edits you saved to your account in luoh. Your videos themselves stay on your device.</p>
          <div id="luoh-list"></div>
        </div>

        <a class="btn primary wide" id="app-open" target="_blank" rel="noopener">Open</a>
      </div>
    </section>
  </article>
  <script is:inline type="application/json" id="dash-data" set:html={JSON.stringify({ apps: APPS, shows: SHOW_NAMES }).replace(/</g, '\\u003c')}></script>
</Site>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = new URLSearchParams(location.search);
  const back = q.get('return') || '';
  const usd = (c: number) => (c / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: c % 100 ? 2 : 0 });
  const METHOD: Record<string, string> = { stripe: 'Card (Stripe)', 'apple-pay': 'Apple Pay', paypal: 'PayPal', 'cash-app': 'Cash App', venmo: 'Venmo', zelle: 'Zelle', cash: 'Cash', check: 'Check', other: 'Other' };
  const niceDay = (d: string) => (d ? new Date(+d.slice(0, 4), +d.slice(5, 7) - 1, +d.slice(8, 10)).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' }) : '');
  const el = (tag: string, cls?: string, txt?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };
  const show = (id: string) => { for (const s of ['acct-loading', 'acct-off', 'acct-in', 'acct-me']) $(s).hidden = s !== id; if (id !== 'acct-me') me = null; };
  // Where to go after signing in: through /api/account/connect, which adds a one-time ticket for soulnicolas.com and sends nrnszn sites straight on.
  const onward = () => (back ? `/api/account/connect?return=${encodeURIComponent(back)}` : '');
  const host = (u: string) => { try { return new URL(u, location.href).host.replace(/^www\./, ''); } catch { return ''; } };

  async function api(path: string, body?: unknown) {
    const r = await fetch(`/api/account/${path}`, body === undefined ? { credentials: 'same-origin' } : { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const j = await r.json().catch(() => ({ ok: false, message: 'The site did not answer properly. Try again.' }));
    return { status: r.status, ...j };
  }

  function drawProjects(list: any[]) {
    const box = $('proj-list'); box.textContent = '';
    if (!list.length) { box.appendChild(el('p', 'empty', 'No projects with us yet. When you book a service, it shows up here with its status and balance.')); return; }
    for (const p of list) {
      const card = el('article', 'card proj'); card.dataset.status = p.status;
      const top = el('div', 'proj-top'); top.append(el('h3', '', p.title), el('span', 'chip', p.statusLabel)); card.appendChild(top);
      if (p.service || p.due) card.appendChild(el('p', 'small', [p.service, p.due ? `Due ${niceDay(p.due)}` : ''].filter(Boolean).join(' · ')));
      const nums = el('dl', 'nums');
      for (const [k, v, c] of [['Total', p.total, ''], ['Paid', p.paid, ''], ['Balance', p.balance, p.balance ? 'owe' : 'clear']] as [string, number, string][]) { const d = el('div', c); d.append(el('dt', '', k), el('dd', '', usd(v))); nums.appendChild(d); }
      card.appendChild(nums);
      if (p.total) { const bar = el('div', 'bar'); bar.setAttribute('role', 'img'); bar.setAttribute('aria-label', `${Math.round((p.paid / p.total) * 100)}% paid`); const i = el('i'); i.style.width = `${Math.min(100, (p.paid / p.total) * 100)}%`; bar.appendChild(i); card.appendChild(bar); }
      if (p.note) card.appendChild(el('p', 'note', p.note));
      if (p.link) { const a = el('a', 'btn small', 'Open the files') as HTMLAnchorElement; a.href = p.link; a.target = '_blank'; a.rel = 'noopener noreferrer'; card.appendChild(a); }
      if (p.balance && p.status !== 'cancelled' && p.status !== 'requested') {
        // Card or Apple Pay through Stripe: the project id and e-mail go along, so the payment lands on this project by itself.
        const a = el('a', 'btn small primary', 'Pay by card') as HTMLAnchorElement;
        a.href = payLink ? `${payLink}?prefilled_email=${encodeURIComponent(meEmail)}&client_reference_id=${encodeURIComponent(p.id)}` : '/support';
        a.target = '_blank'; a.rel = 'noopener noreferrer'; card.appendChild(a);
        const o = el('a', 'btn small', 'Other ways to pay') as HTMLAnchorElement; o.href = '/support'; card.appendChild(o);
      }
      if (p.payments.length) {
        const d = el('details', 'pays'); d.appendChild(el('summary', '', `${p.payments.length} ${p.payments.length === 1 ? 'payment' : 'payments'}`));
        const ul = el('ul'); for (const x of p.payments) ul.appendChild(el('li', '', `${niceDay(x.paidOn)} · ${usd(x.amount)} · ${METHOD[x.method] || x.method}${x.note ? ' · ' + x.note : ''}`)); d.appendChild(ul); card.appendChild(d);
      }
      box.appendChild(card);
    }
  }

  let payLink = '', meEmail = '';
  function drawPayments(list: any[]) {
    const box = $('pay-list'); box.textContent = '';
    $('pay-wrap').hidden = !list.length;
    for (const x of list) {
      const li = el('li', 'pay');
      li.append(el('span', 'pay-what', x.what || 'Payment'), el('span', 'pay-amt', (x.amount / 100).toLocaleString('en-US', { style: 'currency', currency: (x.currency || 'usd').toUpperCase() })), el('span', 'pay-day', new Date(x.at).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' })));
      box.appendChild(li);
    }
  }
  // ---- the dashboard ------------------------------------------------------------------------------------------------------------
  const DATA = JSON.parse(document.getElementById('dash-data')?.textContent || '{}');
  const APPS: { id: string; name: string; tag: string; icon: string; open: string }[] = DATA.apps || [];
  const SHOWS: Record<string, string> = DATA.shows || {};
  let me: any = null;
  let passport: any = null, passportP: Promise<void> | null = null;
  let listings: any = null, listingsP: Promise<void> | null = null;
  const day = (ms: number) => new Date(ms).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
  const plural = (n: number, one: string, many = one + 's') => `${n} ${n === 1 ? one : many}`;
  const sum = (id: string, t: string) => { const e = document.querySelector(`[data-sum="${id}"]`); if (e) e.textContent = t; };
  function stats(id: string, rows: [string, string, string?][]) {
    const box = $(id); box.textContent = '';
    for (const [k, v, c] of rows) { const d = el('div', c || ''); d.append(el('dt', '', k), el('dd', '', v)); box.appendChild(d); }
  }
  function empty(box: HTMLElement, t: string) { box.textContent = ''; box.appendChild(el('p', 'empty', t)); }
  // A list row: title (a link when there is one), a line under it, a status chip, and an optional Remove button.
  function row(title: string, sub: string, href: string, chip?: string, onRemove?: () => void) {
    const li = el('li', 'row');
    const main = el(href ? 'a' : 'div', 'row-main') as HTMLAnchorElement;
    if (href) { main.href = href; main.target = '_blank'; main.rel = 'noopener noreferrer'; }
    main.append(el('b', '', title || 'Untitled')); if (sub) main.append(el('span', '', sub)); li.appendChild(main);
    if (chip) { const c = el('span', 'chip', chip); c.dataset.status = chip; li.appendChild(c); }
    if (onRemove) { const b = el('button', 'rm', 'Remove') as HTMLButtonElement; b.type = 'button'; b.setAttribute('aria-label', `Remove ${title || 'this'}`); b.addEventListener('click', () => { b.disabled = true; onRemove(); }); li.appendChild(b); }
    return li;
  }
  const httpsOk = (u: string) => /^https:\/\//i.test(u);

  function summaries() {
    const open = (me.projects || []).filter((p: any) => p.status !== 'done' && p.status !== 'cancelled');
    const due = (me.projects || []).filter((p: any) => p.status !== 'cancelled').reduce((s: number, p: any) => s + p.balance, 0);
    sum('nrn', (me.projects || []).length ? [plural(open.length, 'open project'), due ? `${usd(due)} due` : 'all paid'].join(' · ') : 'No projects yet');
    const dSaved = (me.saved?.directory || []).length;
    sum('directory', [`${dSaved} saved`, listings ? `${listings.length} sent` : ''].filter(Boolean).join(' · '));
    sum('vault', plural((me.saved?.vault || []).length, 'saved song'));
    sum('luoh', plural(me.luoh?.count || 0, 'saved project'));
    sum('certified', passport ? (passport.ok ? plural(passport.stamps.length, 'Passport stamp') : 'Passport') : 'Your Passport stamps');
  }

  async function loadPassport() {
    if (!passportP) passportP = api('passport', {}).then((j) => { passport = j.ok ? j : { ok: false, message: j.message }; if (!j.ok) passportP = null; summaries(); if (current() === 'certified') drawCertified(); }).catch(() => { passport = { ok: false }; passportP = null; });
    return passportP;
  }
  async function loadListings() {
    if (!listingsP) listingsP = api('listings', { action: 'mine' }).then((j) => { listings = j.ok ? (j.listings || []) : null; if (!j.ok) { listingsP = null; listingsErr = j.message || ''; } summaries(); if (current() === 'directory') drawDirectory(); }).catch(() => { listingsP = null; });
    return listingsP;
  }
  let listingsErr = '';

  function drawNrn() {
    const ps = me.projects || [], pays = me.payments || [];
    const due = ps.filter((p: any) => p.status !== 'cancelled').reduce((s: number, p: any) => s + p.balance, 0);
    const paid = ps.reduce((s: number, p: any) => s + p.paid, 0);
    stats('nrn-stats', [['Projects', String(ps.length)], ['Balance due', usd(due), due ? 'owe' : 'clear'], ['Paid', usd(paid)]]);
    drawProjects(ps); drawPayments(pays);
  }
  function drawCertified() {
    const box = $('cert-body');
    if (!passport) { stats('cert-stats', [['Stamps', '…'], ['Latest', '…']]); empty(box, 'Loading your Passport…'); loadPassport(); return; }
    if (!passport.ok) { stats('cert-stats', [['Stamps', '–'], ['Latest', '–']]); empty(box, passport.message || 'Certified did not answer. Try again in a minute.'); const b = el('button', 'btn small', 'Try again') as HTMLButtonElement; b.type = 'button'; b.addEventListener('click', () => { passport = null; drawCertified(); }); box.appendChild(b); return; }
    const st = [...passport.stamps].sort((a: any, b: any) => (a.day < b.day ? 1 : -1));
    stats('cert-stats', [['Stamps', String(st.length)], ['Latest', st.length ? niceDay(st[0].day) : '–']]);
    box.textContent = '';
    if (passport.today?.open && !st.some((s: any) => s.day === passport.today.day)) box.appendChild(el('p', 'tonight', 'There is a Certified show today. Open Certified and check in to collect tonight\'s stamp.'));
    if (!st.length) { box.appendChild(el('p', 'empty', 'No stamps yet. Check in at the next Certified show (join the game or scan the code on the screen) to get your first one.')); return; }
    const ul = el('ul', 'stamps');
    for (const s of st) { const li = el('li', 'stamp'); li.append(el('b', '', SHOWS[s.day] || 'Certified show'), el('span', '', `${niceDay(s.day)} · ${s.method === 'door' ? 'checked in at the door' : 'played along'}`)); ul.appendChild(li); }
    box.appendChild(ul);
  }
  function drawDirectory() {
    const saved = me.saved?.directory || [];
    stats('dir-stats', [['Sent', listings ? String(listings.length) : '…'], ['Live', listings ? String(listings.filter((x: any) => x.status === 'Live').length) : '…'], ['Saved', String(saved.length)]]);
    const mine = $('dir-mine');
    if (!listings) { empty(mine, listingsErr || 'Loading your listings…'); if (!listingsP) loadListings(); }
    else if (!listings.length) empty(mine, 'Nothing sent yet. Listings you send while signed in show up here with their status.');
    else { mine.textContent = ''; const ul = el('ul', 'rows'); for (const x of listings) ul.appendChild(row(x.title, [x.kind, x.sent ? 'sent ' + day(new Date(x.sent).getTime()) : ''].filter(Boolean).join(' · '), '', x.status)); mine.appendChild(ul); }
    const sv = $('dir-saved');
    if (!saved.length) { empty(sv, 'Nothing saved yet. Open a listing in NuDirectory and tap ♡ Save to keep it here.'); return; }
    sv.textContent = ''; const ul = el('ul', 'rows');
    for (const x of saved) ul.appendChild(row(x.title, x.at ? 'saved ' + day(x.at) : '', httpsOk(x.url) ? x.url : 'https://directory.nrnszn.com/?l=' + encodeURIComponent(x.id), '', () => unsave('directory', 'listing', x.id)));
    sv.appendChild(ul);
  }
  function drawVault() {
    const saved = me.saved?.vault || [];
    stats('vault-stats', [['Saved songs', String(saved.length)]]);
    const box = $('vault-saved');
    if (!saved.length) { empty(box, 'No saved songs yet. In Soul Vault, play a song and tap ♡ in Now Playing.'); return; }
    box.textContent = ''; const ul = el('ul', 'rows');
    for (const x of saved) {
      const href = httpsOk(x.url) ? x.url : x.url && x.url.startsWith('/') && !x.url.startsWith('//') ? 'https://soulnicolas.com' + x.url : 'https://soulnicolas.com/vault';
      ul.appendChild(row(x.title, x.at ? 'saved ' + day(x.at) : '', href, '', () => unsave('vault', 'song', x.id)));
    }
    box.appendChild(ul);
  }
  function drawLuoh() {
    const l = me.luoh || { count: 0, recent: [] };
    stats('luoh-stats', [['Saved projects', String(l.count)], ['Last edit', l.recent.length ? day(l.recent[0].at) : '–']]);
    const box = $('luoh-list');
    if (!l.recent.length) { empty(box, 'No projects saved to your account yet. In luoh, use Save to account and they show up here.'); return; }
    box.textContent = ''; const ul = el('ul', 'rows');
    for (const x of l.recent) ul.appendChild(row(x.name, 'edited ' + day(x.at), ''));
    box.appendChild(ul);
    if (l.count > l.recent.length) box.appendChild(el('p', 'small', `and ${l.count - l.recent.length} more in luoh.`));
  }
  async function unsave(app: string, kind: string, id: string) {
    const j = await api('saved', { app, kind, id, on: false }).catch(() => ({ ok: false }));
    if (j.ok && me.saved?.[app]) me.saved[app] = me.saved[app].filter((x: any) => x.id !== id);
    summaries(); show_(current());
  }

  const DRAW: Record<string, () => void> = { nrn: drawNrn, certified: drawCertified, directory: drawDirectory, vault: drawVault, luoh: drawLuoh };
  const current = () => { const h = location.hash.slice(1); return DRAW[h] ? h : ''; };
  function show_(id: string) {
    if (!me) return;
    $('dash-home').hidden = !!id; $('dash-app').hidden = !id;
    if (!id) return;
    const a = APPS.find((x) => x.id === id)!;
    ($('app-icon') as HTMLImageElement).src = a.icon; $('app-name').textContent = a.name; $('app-tag').textContent = a.tag;
    const open = $('app-open') as HTMLAnchorElement; open.href = a.open; open.textContent = id === 'nrn' ? 'Book a service' : `Open ${a.name}`;
    if (id === 'nrn') { open.removeAttribute('target'); } else open.target = '_blank';
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== id; });
    DRAW[id]();
  }
  let lastView = '';
  function route() {
    const id = current(); show_(id);
    if (id && id !== lastView) { scrollTo(0, 0); $('app-name').focus({ preventScroll: true }); }
    else if (!id && lastView) { const t = document.querySelector<HTMLElement>(`[data-app="${lastView}"]`); t?.focus({ preventScroll: true }); t?.scrollIntoView({ block: 'center' }); }
    lastView = id;
  }
  addEventListener('hashchange', route);
  $('app-back').addEventListener('click', (e) => { e.preventDefault(); if (history.state?.dash) history.back(); else location.hash = ''; });
  document.querySelectorAll<HTMLAnchorElement>('.tile').forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); history.pushState({ dash: 1 }, '', '#' + t.dataset.app); route(); }));

  function signedIn(j: any) {
    payLink = j.payLink || ''; meEmail = j.user.email; me = j;
    show('acct-me');
    const u = j.user, name = u.name || u.email.split('@')[0];
    $('me-name').textContent = name; $('me-email').textContent = u.email; $('me-initial').textContent = name.trim().charAt(0).toUpperCase();
    $('me-since').textContent = u.since ? `Member since ${new Date(u.since).toLocaleDateString([], { month: 'long', year: 'numeric' })}` : '';
    (document.getElementById('me-name-in') as HTMLInputElement).value = u.name || '';
    if (back) { $('me-continue-wrap').hidden = false; const a = $('me-continue') as HTMLAnchorElement; a.href = onward(); a.textContent = `Continue to ${host(back) || 'the app'}`; }
    passport = null; passportP = null; listings = null; listingsP = null; listingsErr = '';
    summaries(); route();
    loadPassport(); loadListings();   // fill the Certified and NuDirectory tiles in the background
  }

  function loadGoogle(clientId: string) {
    const s = document.createElement('script'); s.src = 'https://accounts.google.com/gsi/client'; s.async = true;
    s.onload = () => {
      const g = (window as any).google; if (!g || !g.accounts) return;
      g.accounts.id.initialize({ client_id: clientId, ux_mode: 'popup', callback: async (resp: { credential: string }) => {
        const j = await api('google', { credential: resp.credential, return: back });
        if (j.ok) { if (back && j.next) { location.href = j.next; return; } start(); } else $('acct-msg').textContent = j.message || 'Google sign-in did not work. Try again.';
      } });
      const box = $('g-btn');
      g.accounts.id.renderButton(box, { theme: 'filled_black', size: 'large', text: 'continue_with', shape: 'pill', width: Math.min(360, Math.max(200, box.clientWidth || 300)) });
    };
    s.onerror = () => { $('g-wrap').hidden = true; };
