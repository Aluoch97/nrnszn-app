---
// Shows one of your existing widgets, unchanged, inside a site page.
// The widget file lives in public/widgets/ and is served from this same site,
// so the page can size the frame to the widget and pass URL params through.
//
// Default: the frame grows/shrinks to fit the widget's page height (Support).
// fitTo + maxHeight: for widgets that size their own card to the window they're
// given (Survey). The frame follows that card, and never gets taller than
// maxHeight or the screen, so long steps scroll inside the card.
// screen: for full-page widgets with pop-up viewers pinned to the window
// (Gallery). The frame fills the screen under the menu and the widget scrolls
// inside it, so its pop-ups open where the visitor is looking.
// fill: if the widget caps itself at a share of its window (Services uses
// max-height: 95vh), the frame adds that headroom so the widget isn't squeezed.

interface Props {
  src: string;
  title: string;
  fitTo?: string;
  measure?: string;
  fill?: number;
  maxHeight?: number;
  maxWidth?: number;
  passParams?: boolean;
  screen?: boolean;
  transparent?: boolean;
}
const { src, title, fitTo, measure, fill = 1, maxHeight = 950, maxWidth = 520, passParams = false, transparent = false, screen = false } = Astro.props;
---
<div class:list={['wf', { 'wf-screen': screen }]} style={`--wf-max:${maxWidth}px`}>
  <iframe
    class="wf-frame"
    src={src}
    title={title}
    data-src={src}
    data-fit-to={fitTo}
    data-measure={measure}
    data-fill={fill}
    data-max={maxHeight}
    data-pass={passParams ? '' : undefined}
    data-transparent={transparent ? '' : undefined}
    data-screen={screen ? '' : undefined}
    style="height:640px"
    loading="eager"
    allow="fullscreen; clipboard-write; autoplay; encrypted-media; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<style>
  .wf { width: 100%; max-width: var(--wf-max); margin: 0 auto; padding: var(--space-4) var(--space-3) var(--space-6); }
  .wf-screen { max-width: none; padding: 0; }
  .wf-screen .wf-frame { border-radius: 0; }
  .wf-frame { display: block; width: 100%; border: 0; border-radius: var(--radius-md); background: transparent; color-scheme: normal; }
</style>

<script>
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('.wf-frame')) {
    // Pass the page's ?params on to the widget (e.g. /survey?type=show&show=...).
    if (frame.dataset.pass !== undefined && location.search) {
      const url = new URL(frame.dataset.src!, location.href);
      new URLSearchParams(location.search).forEach((v, k) => url.searchParams.set(k, v));
      frame.src = url.pathname + url.search;
    }

    const fitTo = frame.dataset.fitTo;
    const maxH = Number(frame.dataset.max) || 950;
    const header = () => document.querySelector('.bar')?.getBoundingClientRect().height ?? 0;
    const cap = () => Math.max(480, Math.min(maxH, window.innerHeight - header() - 24));
    const setH = (h: number) => {
      const px = Math.round(h) + 'px';
      if (frame.style.height !== px) frame.style.height = px;
    };

    if (frame.dataset.screen !== undefined) {
      const fill = () => setH(Math.max(420, window.innerHeight - header()));
      fill();
      window.addEventListener('resize', fill);
      continue;
    }

    let watched: Document | null = null;
    const watch = () => {
      const doc = frame.contentDocument;
      if (!doc?.body || doc.URL === 'about:blank' || doc === watched) return;
      watched = doc;

      if (frame.dataset.transparent !== undefined) {
        const s = doc.createElement('style');
        s.textContent = 'html,body{background:transparent!important}';
        doc.head.appendChild(s);
      }

      if (fitTo) {
        // The widget sizes its card to min(content height, its window height).
        // Measure the content the same way it does (let the content box grow
        // for an instant, read it, put it back) and give the frame that much,
        // capped at the screen. The widget then fills the frame exactly.
        const card = doc.querySelector<HTMLElement>(fitTo);
        const content = frame.dataset.measure ? doc.querySelector<HTMLElement>(frame.dataset.measure) : card;
        if (!card || !content) return;

        let observer: MutationObserver;
        const measure = () => {
          // Collapsing and restoring the box resets inner scroll positions, so keep them.
          const scrolled = [...content.querySelectorAll<HTMLElement>('*')].filter((el) => el.scrollTop > 0)
            .map((el) => [el, el.scrollTop] as const);
          const prevH = content.style.height;
          const prevMax = content.style.maxHeight;
          content.style.height = 'auto';
          content.style.maxHeight = 'none';
          const needed = content.scrollHeight;
          content.style.height = prevH;
          content.style.maxHeight = prevMax;
          for (const [el, top] of scrolled) el.scrollTop = top;
          observer?.takeRecords(); // ignore our own measuring
          return needed;
        };
        const fill = Number(frame.dataset.fill) || 1;
        const follow = () => setH(Math.min(Math.ceil(measure() / fill) + 2, cap()));

        let queued = false;
        const later = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => { queued = false; follow(); });
        };
        observer = new MutationObserver(later);
        observer.observe(card, { attributes: true, attributeFilter: ['class', 'hidden', 'aria-pressed'], childList: true, subtree: true, characterData: true });
        window.addEventListener('resize', later);
        doc.fonts?.ready.then(later);
        follow();
        return;
      }

      // Page-height widgets: match the widget document's full height.
      const fit = () => setH(Math.max(doc.documentElement.scrollHeight, doc.body.scrollHeight));
      fit();
      new ResizeObserver(fit).observe(doc.body);
      new MutationObserver(fit).observe(doc.body, { childList: true, subtree: true, attributes: true });
      doc.fonts?.ready.then(fit);
    };
    frame.addEventListener('load', watch);
    // The widget may finish loading before this script runs.
    if (frame.contentDocument?.readyState === 'complete') watch();
  }
</script>
