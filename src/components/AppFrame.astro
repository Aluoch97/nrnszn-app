---
// Shows one of NuRenaissance's own web apps (NuDirectory, Certified Lounge)
// full screen inside this site. Those apps have their own bottom menus, so
// instead of the site menu and tabs there's a slim bar: Back, the app's name,
// and open-in-new-tab.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';

// passQuery: hand this page's ?query on to the app (e.g. /play?certified opens its Certified screen).
interface Props { title: string; description: string; name: string; src: string; passQuery?: boolean; }
const { title, description, name, src, passQuery = false } = Astro.props;
---
<Base
  title={title}
  description={description}
>
  <div class="dir">
    <header class="dir-bar">
      <a class="dir-back" href="/apps" data-back>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        <span>Back</span>
      </a>
      <h1 class="dir-title">{name}</h1>
      <a class="dir-open" href={src} target="_blank" rel="noopener" aria-label={`Open ${name} in a new tab`}>
        <Icon name="external" size={20} />
      </a>
    </header>
    <iframe class="dir-frame" src={src} title={name} data-pass={passQuery ? '' : undefined}
      allow="fullscreen; clipboard-write; geolocation" allowfullscreen></iframe>
  </div>
</Base>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('.dir-frame[data-pass]');
  if (frame && location.search) frame.src = frame.src.replace(/\/?$/, '/') + location.search;
  // Back is a plain link to the page you came from on this site (Apps if unknown).
  // Not history.back(): the app inside the frame adds its own history entries as
  // you move between its screens, so "back" would often stay inside the app.
  const back = document.querySelector<HTMLAnchorElement>('[data-back]');
  try {
    const ref = document.referrer ? new URL(document.referrer) : null;
    if (back && ref && ref.origin === location.origin && ref.pathname !== location.pathname) {
      back.href = ref.pathname + ref.search + ref.hash;
    }
  } catch { /* keep the default */ }
</script>

<style>
  .dir {
    height: 100svh; display: flex; flex-direction: column;
    background: #0e0b16; color: #f3f0fa;
  }
  .dir-bar {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center;
    padding: max(4px, env(safe-area-inset-top)) max(8px, env(safe-area-inset-right)) 4px max(8px, env(safe-area-inset-left));
    background: #0e0b16; border-bottom: 1px solid #2a2238;
    view-transition-name: nrn-bar;
  }
  .dir-back {
    justify-self: start; display: inline-flex; align-items: center; gap: 2px;
    min-height: 44px; padding: 0 10px 0 4px; border-radius: 10px;
    color: var(--gold-300); text-decoration: none; font-size: 17px; font-weight: 500;
    -webkit-tap-highlight-color: transparent;
  }
  .dir-back:active { opacity: 0.6; }
  .dir-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 17px; color: #f3f0fa; }
  .dir-open {
    justify-self: end; width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 10px; color: #a99fc6;
  }
  .dir-open:hover { color: #f3f0fa; }
  .dir :global(:focus-visible) { outline-color: var(--gold-300); }
  .dir-frame { flex: 1; min-height: 0; width: 100%; border: 0; display: block; background: #0e0b16; }
</style>

<style is:global>
  html:has(.dir), html:has(.dir) body { background: #0e0b16; }
</style>
