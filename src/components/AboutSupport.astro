---
// About + Support on one page. Shown at /about, and at /support (opens
// scrolled to the payment section) so invoice emails, ticket buttons and
// old links keep working.
import WidgetFrame from './WidgetFrame.astro';
---
<div class="page">
    <section aria-labelledby="faq-h">
      <h2 id="faq-h" class="title">FAQs</h2>
      <p class="lede">A legacy of authentic storytelling and creative empowerment.</p>
      <div class="faqs">
        <details open>
          <summary>What is the story behind NuRenaissance?</summary>
          <p>
            Founded in 2017 by Nicolas Soul and whyshiki, NuRenaissance began as a grassroots record label fueled by
            a passion for pure artistry. Inspired by the cultural explosion of the Harlem Renaissance, the founders
            sought to create a modern-day equivalent—a sanctuary for artists to innovate and collaborate without
            boundaries. Over time, the label naturally expanded into a full-scale media company to meet the growing
            need for high-quality, soulful storytelling in the digital age.
          </p>
        </details>
        <details>
          <summary>What services does NuRenaissance offer today?</summary>
          <p>We empower artists, entrepreneurs, and brands through professional digital services, including:</p>
          <ul>
            <li><strong>Video &amp; Photo Editing:</strong> Professional production to ensure your visuals meet industry standards.</li>
            <li><strong>Web Design:</strong> Building digital homes that reflect your brand's unique aesthetic and purpose.</li>
            <li><strong>Admin Services:</strong> Strategy and execution to grow your community and maintain a consistent voice.</li>
            <li><strong>Consultations:</strong> One-on-one sessions to refine your creative direction and brand strategy.</li>
          </ul>
        </details>
        <details>
          <summary>How do I get started or get a quote?</summary>
          <p>
            For all service inquiries, project scopes, and rate cards, please reach out to us via email at
            <a href="mailto:nurrenaissance@gmail.com">nurrenaissance@gmail.com</a>. Please provide a brief description
            of your needs so we can best assist you.
          </p>
        </details>
      </div>
    </section>

    <section id="support" class="support" aria-label="Support NuRenaissance">
      <WidgetFrame src="/widgets/support.html" title="NuRenaissance payment options" passParams />
    </section>

    <section aria-labelledby="connect-h">
      <h2 id="connect-h" class="title">Connect</h2>
      <div class="connect">
        <p>Questions, bookings or press? We read every message.</p>
        <a class="cbtn cbtn-main" href="mailto:nurrenaissance@gmail.com?subject=Contact%20-%20Website">Email us</a>
      </div>
    </section>
  </div>

<style>
  /* Support: the payment widget sits in the page's column, no extra side padding */
  .support :global(.wf) { padding: 0; max-width: none; }
  .support { scroll-margin-top: 72px; }
  .page {
    max-width: 760px; margin: 0 auto;
    padding: var(--space-6) var(--space-4);
    display: grid; gap: var(--space-6);
  }
  .title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-poster); font-weight: 800; text-transform: uppercase;
    font-size: clamp(30px, 8vw, 44px); letter-spacing: 0.03em; line-height: 1; color: var(--pink-300);
  }
  .lede { margin: 0 0 var(--space-4); color: #a99fc6; font-size: 16px; }

  .faqs { display: grid; gap: var(--space-2); }
  details { border-radius: var(--radius-md); background: #1a1526; border: 1px solid #2a2238; }
  summary {
    cursor: pointer; list-style: none;
    padding: var(--space-4); padding-right: 48px; position: relative;
    font-weight: 600; font-size: 16px; line-height: 1.4; color: #f3f0fa;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: var(--space-4); top: 50%; translate: 0 -50%;
    font-size: 22px; color: var(--gold-300); transition: rotate var(--dur-fast);
  }
  details[open] summary::after { rotate: 45deg; }
  details p, details ul { margin: 0; padding: 0 var(--space-4) var(--space-4); color: #d9d2e9; font-size: 15px; line-height: 1.65; }
  details ul { padding-left: calc(var(--space-4) + 1.1em); display: grid; gap: var(--space-2); }
  details strong { color: #f3f0fa; }
  details a { color: var(--gold-300); }

  .connect { display: grid; gap: var(--space-3); }
  .connect p { margin: 0 0 var(--space-1); color: #a99fc6; font-size: 15px; }
  .cbtn {
    display: grid; place-items: center; min-height: 56px; border-radius: var(--radius-pill);
    text-decoration: none; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    border: 1.5px solid var(--gold-500); color: var(--gold-300);
    transition: background var(--dur-fast);
  }
  .cbtn:hover { background: #241d34; }
  .cbtn-main { background: var(--gold-300); color: var(--purple-900); border-color: var(--gold-300); }
  .cbtn-main:hover { background: #ffe08a; }
</style>
