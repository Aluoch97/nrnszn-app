---
import '@fontsource/big-shoulders-display/latin-700';
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource-variable/fraunces/opsz';
import '@fontsource-variable/inter/wght';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string; // when two URLs show the same page (e.g. /support and /about)
}
const { title, description, image = '/icons/icon-512.png', canonicalPath } = Astro.props;
// Shared links (iMessage, Instagram, etc.) show the app icon with the same line on every page.
const shareText = 'The NuRenaissance is a Nashville-based media company empowering creatives & celebrating bold individuality.';
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="NuRenaissance" />
    <meta property="og:description" content={shareText} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="NuRenaissance app icon" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:description" content={shareText} />

    <meta name="theme-color" content="#0e0b16" />
    <!-- Added to the iPhone home screen, open full screen like an app. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="NuRenaissance" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

  </head>
  <body>
    <slot />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
