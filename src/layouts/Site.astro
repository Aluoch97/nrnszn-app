---
// Shell for main-website pages.
// Computers: top bar with every link, footer at the bottom.
// Phones: works like an app: slim top bar, tab bar along the bottom, and a
// "More" sheet for the links that don't fit in the tabs.
// The Portal keeps its own standalone link-in-bio look and doesn't use this.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { nav, tabs, footer } from '../data/site.js';
import { socials } from '../data/portal.js';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === path || (href !== '/' && path.startsWith(href + '-'));
const tabLinks = tabs.map((t) => nav.find((n) => n.href === t)!).filter(Boolean);
const moreLinks = nav.filter((n) => !tabs.includes(n.href));
const moreCurrent = moreLinks.some((n) => isCurrent(n.href)) || footer.some((f) => isCurrent(f.href));
---
<Base title={title} description={description}>
  <div class="site">
    <a class="skip" href="#content">Skip to content</a>
    <header class="bar">
      <a class="brand" href="/" aria-label="NuRenaissance home">
        <img src="/img/mascot.webp" alt="" width="34" height="34" />
        <span>NuRenaissance</span>
      </a>
      <nav class="topnav" aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main id="content" class="content">
      <slot />
    </main>

    <footer class="foot">
      <ul class="socials" aria-label="Social links">
        {socials.filter((s) => s.icon !== 'web').map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={18} /></a></li>
        ))}
      </ul>
      <p class="links">
        {footer.map((f, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<a href={f.href}>{f.label}</a></>))}
      </p>
      <p class="copy">© {new Date().getFullYear()} NuRenaissance Media</p>
    </footer>

    <nav class="tabbar" aria-label="Tabs">
      {tabLinks.map((n) => (
        <a class:list={['tab', { 'tab-home': n.href === '/' }]} href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
          <Icon name={n.icon} size={n.href === '/' ? 28 : 24} /><span>{n.label}</span>
        </a>
      ))}
      <button class="tab" type="button" data-more-open aria-haspopup="dialog" aria-current={moreCurrent ? 'page' : undefined}>
        <Icon name="more" size={24} /><span>More</span>
      </button>
    </nav>

    <dialog class="sheet" aria-label="More pages">
      <div class="sheet-head">
        <span>More</span>
        <button type="button" class="sheet-close" data-more-close aria-label="Close"><Icon name="close" size={22} /></button>
      </div>
      <ul class="sheet-links">
        {moreLinks.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}><Icon name={n.icon} size={22} /><span>{n.label}</span></a></li>
        ))}
      </ul>
      <ul class="socials" aria-label="Social links">
        {socials.filter((s) => s.icon !== 'web').map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={18} /></a></li>
        ))}
      </ul>
      <p class="sheet-foot"><a href="/privacy-policy">Privacy policy</a> · © {new Date().getFullYear()} NuRenaissance Media</p>
    </dialog>
  </div>
</Base>

<style>
  .site {
    --shell-bg: #0e0b16;
    --shell-line: #2a2238;
    --shell-text: #f3f0fa;
    --shell-muted: #a99fc6;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--shell-bg);
    color: var(--shell-text);
  }
  /* Gold focus ring shows up on the dark shell (the default purple doesn't). */
  .site :global(:focus-visible) { outline-color: var(--gold-300); }
  .site :global(a), .site :global(button) { -webkit-tap-highlight-color: transparent; }
  /* Bars stay put while the page changes underneath (browsers that support it). */
  .bar { view-transition-name: nrn-bar; }
  .tabbar { view-transition-name: nrn-tabs; }

  .skip {
    position: absolute; left: 12px; top: -48px; z-index: 10;
    padding: 8px 14px; border-radius: var(--radius-sm);
    background: var(--gold-300); color: var(--purple-900); font-weight: 600;
  }
  .skip:focus { top: 12px; }

  .bar {
    position: sticky; top: 0; z-index: 5;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    padding-top: max(var(--space-3), env(safe-area-inset-top));
    background: rgba(14, 11, 22, 0.92);
    border-bottom: 1px solid var(--shell-line);
    backdrop-filter: blur(10px);
  }
  .brand {
    display: flex; align-items: center; gap: var(--space-2);
    text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 20px;
    color: var(--gold-300);
  }
  .brand img { width: 38px; height: 38px; object-fit: contain; }

  /* Computers: links across the top. */
  .topnav { display: flex; gap: var(--space-1); }
  .topnav a {
    padding: 8px 12px; border-radius: var(--radius-sm);
    text-decoration: none; font-weight: 500; font-size: 15px; color: var(--shell-text);
  }
  .topnav a:hover { background: #241d34; }
  .topnav a[aria-current='page'] { color: var(--gold-300); }

  /* Phones: tab bar along the bottom. */
  .tabbar { display: none; }
  .sheet { display: none; }

  @media (max-width: 879px) {
    .site { --tab-h: calc(60px + env(safe-area-inset-bottom)); padding-bottom: var(--tab-h); }
    .topnav { display: none; }
    .bar { justify-content: center; }

    .tabbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
      height: var(--tab-h); padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
      background: rgba(14, 11, 22, 0.94);
      border-top: 1px solid var(--shell-line);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    }
    .tab {
      min-width: 0; height: 60px;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
      background: none; border: 0; padding: 0; cursor: pointer;
      font: inherit; font-size: 12px; font-weight: 600; letter-spacing: 0.01em;
      color: var(--shell-muted); text-decoration: none;
      -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none;
    }
    .tab span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* Icon sits in a pill; the current tab's pill fills in, so it reads by shape as well as color. */
    .tab :global(svg) {
      box-sizing: content-box; padding: 3px 16px; border-radius: var(--radius-pill);
      transition: background var(--dur-fast), transform var(--dur-fast) var(--ease-out);
    }
    .tab[aria-current='page'] { color: var(--gold-300); }
    .tab[aria-current='page'] :global(svg) { background: rgba(232, 187, 82, 0.18); }
    .tab:active :global(svg) { transform: scale(0.88); }
    /* Home: raised gold button in the middle, a bit bigger than the rest. */
    .tab-home { justify-content: flex-end; padding-bottom: 6px; color: var(--shell-text); }
    .tab-home :global(svg) {
      padding: 12px; margin-top: -22px;
      background: var(--gold-300); color: var(--purple-900);
      box-shadow: 0 0 0 4px #0e0b16, 0 6px 16px rgba(0, 0, 0, 0.5);
    }
    .tab-home[aria-current='page'] :global(svg) { background: var(--gold-300); }
    .tab-home:not([aria-current='page']) :global(svg) { background: #2c2440; color: var(--gold-300); }
    /* Phones: the More sheet has the footer links, so no footer (like an app). */
    .site .foot { display: none; }

    .sheet[open] {
      display: block;
      position: fixed; inset: auto 0 0 0; margin: 0; width: 100%; max-width: none;
      max-height: 85svh; overflow-y: auto;
      padding: var(--space-3) var(--space-4) max(var(--space-5), env(safe-area-inset-bottom));
      background: #1a1526; color: var(--shell-text);
      border: 0; border-top: 1px solid var(--shell-line);
      border-radius: 22px 22px 0 0;
      animation: sheet-up 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .sheet::backdrop { background: rgba(0, 0, 0, 0.55); }
    .sheet[open]::before {
      content: ''; display: block; width: 40px; height: 5px; margin: 0 auto var(--space-2);
      border-radius: var(--radius-pill); background: #3a3150;
    }
    .sheet-head {
      display: flex; align-items: center; justify-content: space-between;
      font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--gold-300);
    }
    .sheet-close {
      width: 44px; height: 44px; display: grid; place-items: center;
      background: #241d34; color: var(--shell-text); border: 0; border-radius: var(--radius-pill); cursor: pointer;
    }
    .sheet-links { list-style: none; margin: var(--space-3) 0; padding: 0; display: grid; gap: var(--space-1); }
    .sheet-links a {
      display: flex; align-items: center; gap: var(--space-3);
      min-height: 52px; padding: 0 var(--space-3); border-radius: var(--radius-sm);
      text-decoration: none; font-size: 17px; font-weight: 500; color: var(--shell-text); background: #211b30;
    }
    .sheet-links a[aria-current='page'] { color: var(--gold-300); }
    .sheet-links a:active { background: #2c2440; }
    .sheet .socials { margin: var(--space-4) 0 var(--space-3); }
    .sheet-foot { margin: 0; text-align: center; font-size: 13px; color: var(--shell-muted); }
    .sheet-foot a { color: var(--shell-text); }
  }
  @keyframes sheet-up { from { transform: translateY(100%); } to { transform: none; } }

  .content { flex: 1; width: 100%; }

  .foot {
    display: grid; justify-items: center; gap: var(--space-3);
    padding: var(--space-6) var(--space-4) max(var(--space-6), env(safe-area-inset-bottom));
    border-top: 1px solid var(--shell-line);
    color: var(--shell-muted); font-size: 13px;
  }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
  .socials a {
    width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: var(--radius-pill); color: var(--gold-300); background: #1a1526;
  }
  .socials a:hover { background: #241d34; }
  .links, .copy { margin: 0; }
  .links a { color: var(--shell-text); }
</style>

<script>
  // "More" sheet on phones.
  const sheet = document.querySelector<HTMLDialogElement>('.sheet');
  document.querySelector('[data-more-open]')?.addEventListener('click', () => sheet?.showModal());
  document.querySelector('[data-more-close]')?.addEventListener('click', () => sheet?.close());
  // Tap the dimmed area above the sheet to close it.
  sheet?.addEventListener('click', (e) => { if (e.target === sheet) {
    const r = sheet.getBoundingClientRect();
    if ((e as MouseEvent).clientY < r.top) sheet.close();
  } });
  matchMedia('(min-width: 880px)').addEventListener('change', (m) => { if (m.matches) sheet?.close(); });
</script>

<style is:global>
  /* Main-site pages are dark; keep the page behind them dark too (shows on overscroll). */
  html:has(.site), html:has(.site) body { background: #0e0b16; }
</style>
